Notebook[{
Cell[TextData[StyleBox["SMA 5202 Computing Technologies and Tools\n(By A/Prof \
Wang Jian-Sheng)",
  FontFamily->"Arial"]], "Title"],

Cell[TextData[{
  StyleBox["Mathematica",
    FontSlant->"Italic"],
  " Lab Part II (Solutions)"
}], "Title"],

Cell["Question 1", "Subtitle"],

Cell[CellGroupData[{

Cell["Part (a): k = 0.1", "Section"],

Cell[BoxData[
    \(Remove["\<Global`*\>"]\)], "Input"],

Cell[BoxData[
    \(A[k_]\  := \ {{0.6, \ 0.5}, \ {\(-k\), \ 1.2}}\)], "Input"],

Cell[BoxData[
    \(\(x0\  = \ {100, \ 1000};\)\)], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
    \(Eigenvalues[A[0.1]]\)], "Input"],

Cell[BoxData[
    \(TraditionalForm\`{1.0999999999999999`, 0.7`}\)], "Output"]
}, Open  ]],

Cell[BoxData[
    \(\(x\  = \ 
        Table[MatrixPower[A[0.1], i] . x0, \ {i, 1, 100}];\)\)], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
    \(ListPlot[Table[{i, x[\([i, 1]\)]}, \ {i, \ 1, \ 100}], 
      PlotJoined -> True\ ]\)], "Input"],

Cell[GraphicsData["PostScript", "\<\
