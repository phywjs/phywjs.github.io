Cell[BoxData[
    \(We\ can\ observe\ that\ the\ maximum\ eigenvalue\ of\ the\ system\ \((\
\[Lambda]\_max)\)\ determines\ the\ growth\ rates\ of\ the\ popultion . \ 
          If\ \[Lambda]\_max\  > 1, \ 
    the\ population\ willtend\ to\ explode . \ If\ \[Lambda]\_max\  < 1, \ 
    the\ population\ will\ tend\ to\ \ decay . \ If\ \[Lambda]\_max\  = 1, \ 
    the\ population\ will\ tend\ toward\ a\ constant\ \(\(value\)\(.\)\)\)], \
"Text"],

Cell["Question 2", "Subtitle"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Part (a)", "Section"],

Cell[BoxData[
    \(Remove["\<Global`*\>"]\)], "Input"],

Cell[BoxData[
    \(g[t_, \ 
        x_]\  := \ \((1 - 2\ x\ t\  + \ t^2)\)^\((\(-1\)/2)\)\)], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
    \(series1\  = \ 
      FullSimplify[
        CoefficientList[Series[g[t, x], {t, \ 0, \ 5}], \ t]]\)], "Input"],

Cell[BoxData[
    \(TraditionalForm\`{1, x, 1\/2\ \((3\ x\^2 - 1)\), 
      1\/2\ x\ \((5\ x\^2 - 3)\), 1\/8\ \((35\ x\^4 - 30\ x\^2 + 3)\), 
      1\/8\ x\ \((63\ x\^4 - 70\ x\^2 + 15)\)}\)], "Output"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Part (b)", "Section"],

Cell[BoxData[
    \(P[n_] := 
      Sum[\((\(-1\))\)^
            k*\(\((2  n - 
                  2  k)\)!\)/\((\((2^
                    n)\)\ \(k!\)\ \(\((n - k)\)!\)\ \(\((n - 2  k)\)!\))\) 
          x^\((n - 2  k)\), {k, 0, Floor[n/2]}]\)], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
    \(series2\  = \ 
      FullSimplify[
        CoefficientList[Sum[P[n]\ t^n, \ {n, \ 0, \ 5}], \ t]]\)], "Input"],

Cell[BoxData[
    \(TraditionalForm\`{1, x, 1\/2\ \((3\ x\^2 - 1)\), 
      1\/2\ x\ \((5\ x\^2 - 3)\), 1\/8\ \((35\ x\^4 - 30\ x\^2 + 3)\), 
      1\/8\ x\ \((63\ x\^4 - 70\ x\^2 + 15)\)}\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(series1 === series2\)], "Input"],

Cell[BoxData[
    \(TraditionalForm\`True\)], "Output"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Part (c) - First Part", "Section"],

Cell[CellGroupData[{

Cell[BoxData[
    \(And\  @@ \ 
      FullSimplify[
        Table[\ \[PartialD]\_x\ P[n + 1] - \[PartialD]\_x\ 
                P[n - 1] == \((2  n + 1)\)\ P[n], \ {n, 1, 4}]]\)], "Input"],

Cell[BoxData[
    \(TraditionalForm\`True\)], "Output"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Part (c) - Second Part", "Section"],

Cell[CellGroupData[{

Cell[BoxData[
    \(And\  @@ \ 
      FullSimplify[
        Table[\((1 - x^2)\) \[PartialD]\_\(x, x\)\ P[n] - 
              2  x\ \[PartialD]\_x\ P[n]\  + \ n \((n + 1)\) P[n] == 0, \ {n, 
            1, 4}]]\)], "Input"],

Cell[BoxData[
    \(TraditionalForm\`True\)], "Output"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Part (d)", "Section"],

Cell[BoxData[
    \(P2[n_]\  := \ \((1/\((2  Pi)\))\)\ Integrate[\((x + 
                Sqrt[x^2 - 1]\ \ Cos[\[CurlyPhi]])\)^n, {\[CurlyPhi], \ 0, \ 
            2*Pi}]\)], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
    \(And\  @@ \ FullSimplify[Table[P[n] == P2[n], \ {n, 0, 5}]]\)], "Input"],

Cell[BoxData[
    \(TraditionalForm\`True\)], "Output"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Part (e)", "Section"],

Cell[BoxData[
    \(P3[n_]\  := \ 
      1/\((2^n\ \(n!\))\)\ D[\((x^2 - 1)\)^n, \ {x, n}]\)], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
    \(And\  @@ \ FullSimplify[Table[P[n] == P3[n], \ {n, 0, 5}]]\)], "Input"],

Cell[BoxData[
    \(TraditionalForm\`True\)], "Output"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Part (f)", "Section"],

Cell[CellGroupData[{

Cell[BoxData[
    \(And\  @@ \ \(And\  @@@ \ 
        FullSimplify[
          Table[Integrate[P[n]\ P[m], \ {x, \ \(-1\), \ 1}]\  == 
              2/\((2  n + 1)\)\ \ DiscreteDelta[n - m], \ {n, \ 0, \ 
              5}, \ {m, \ 0, \ 5}]]\)\)], "Input"],

Cell[BoxData[
    \(TraditionalForm\`True\)], "Output"]
}, Open  ]],

Cell[TextData[StyleBox["",
  FontSize->10]], "Copyright"]
}, Open  ]]
},
