Cell["\<\
We modify the drawlines so that we can draw n horizontal lines:\
\>", "Text"],

Cell[BoxData[
    \(drawlines[{x0_, \ x1_, \ dx_}, \ {y0_, \ y1_, \ dy_}]\  := \ 
      Module[\ {}, \[IndentingNewLine]\ 
        manylines\  = \ {}; \[IndentingNewLine]Do[\[IndentingNewLine]oneline\ \
 = \ Table[\ {x, \ y}, {x, \ x0, \ x1, \ 
                dx}]; \[IndentingNewLine]manylines\  = \ 
            Append[manylines, \ Line[oneline]], \[IndentingNewLine]{y, \ 
            y0, \ y1, \ dy}\[IndentingNewLine]]; \[IndentingNewLine]\ 
        manylines\[IndentingNewLine]]\)], "Input"],

Cell[BoxData[
    \(ls\  = \ drawlines[{0, 1, 0.2}, \ {0, \ 1, \ 0.2}]\)], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
    \(Show[Graphics[ls]]\)], "Input"],

