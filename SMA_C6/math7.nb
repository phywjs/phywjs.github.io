Cell["\<\
Note that Graphics[ ] is in the form of Graphics[ { g1, g2, ...}] where g1, \
g2, ... are graphical elements such as Line[], or Point[], or Polygon[] etc.  \
 Adding vertical line is easy:\
\>", "Text"],

Cell[BoxData[
    \(drawlines[{x0_, \ x1_, \ dx_}, \ {y0_, \ y1_, \ dy_}]\  := \ 
      Module[\ {}, \[IndentingNewLine] (*\ 
          Loop\ over\ horizontal\ lines\ *) \[IndentingNewLine]hlines\  = \ \
{}; \[IndentingNewLine]Do[\[IndentingNewLine]oneline\  = \ 
            Table[\ {x, \ y}, {x, \ x0, \ x1, \ 
                dx}]; \[IndentingNewLine]hlines\  = \ 
            Append[hlines, \ Line[oneline]], \[IndentingNewLine]{y, \ y0, \ 
            y1, \ dy}\[IndentingNewLine]]; \[IndentingNewLine] (*\ 
          Loop\ over\ vertical\ lines\ *) \[IndentingNewLine]vlines\  = \ {}; \
\[IndentingNewLine]Do[\[IndentingNewLine]oneline\  = \ 
            Table[\ {x, \ y}, {y, \ y0, \ y1, \ 
                dy}]; \[IndentingNewLine]vlines\  = \ 
            Append[vlines, \ Line[oneline]], \[IndentingNewLine]{x, \ x0, \ 
            x1, \ dx}\[IndentingNewLine]]; \[IndentingNewLine]\ 
        hlines\ ~Join~\ vlines\[IndentingNewLine]]\)], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
    \(Show[Graphics[drawlines[{0, 1, 0.1}, \ {0, \ 1, \ 0.1}]], \ 
      AspectRatio \[Rule] \ Automatic]\)], "Input"],

