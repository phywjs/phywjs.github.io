Cell["\<\
Now we write a function call Picture to combine the two set of curves:\
\>", "Text"],

Cell[BoxData[
    \(Picture[
        expr_, \ {s_, \ s0_, \ s1_, \ ds_}, \ {t_, \ t0_, \ t1_, \ 
          dt_}]\  := \ 
      Module[{\ hg, \ vg}, \[IndentingNewLine]vg\  = \ 
          Curves[expr, \ {s, s0, s1, ds}, \ {t, t0, 
              t1}]; \[IndentingNewLine]hg\  = \ 
          Curves[expr, \ {t, \ t0, \ t1, \ ds}, \ {s, \ s0, \ 
              s1}]; \[IndentingNewLine]Show[\ 
          Graphics[\ vg[\([1]\)]\ ~Join~\ hg[\([1]\)]], \ 
          AspectRatio\  \[Rule] \ Automatic, \ 
          Axes\  \[Rule] \ True]\[IndentingNewLine]]\)], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
    \(Picture[\ 
      Sin[x\  + \ I\ y], \ {x, \ 0, \ 1, \ 0.2}, \ {y, \ 0, \ 1, \ 
        0.2}]\)], "Input"],

