%%BeginDocument: epsfiles/reptate.eps
/box {
   /y1 exch def
   /x1 exch def
   /y0 exch def
   /x0 exch def
x0 y0 moveto
x1 y0 lineto
x1 y1 lineto
x0 y1 lineto
closepath stroke
} def
%0 0 440 160 box
40 40 scale
1 1 translate
0.06 setlinewidth
/d {
   newpath
   0.12 0 360 arc fill
} def
% define the arrow
/arrowdict 14 dict def
arrowdict begin
 /mtrx matrix def
end
/arrow
 { arrowdict begin
    /headlength exch def
    /halfheadthickness exch 2 div def
    /halfthickness exch 2 div def
    /tipy exch def /tipx exch def
    /taily exch def /tailx exch def

    /dx tipx tailx sub def
    /dy tipy taily sub def
    /arrowlength dx dx mul dy dy mul add
     sqrt def
    /angle dy dx atan def
    /base arrowlength headlength sub def

    /savematrix mtrx currentmatrix def

    tailx taily translate
    angle rotate

    0 halfthickness neg moveto
    base halfthickness neg lineto
    base halfheadthickness neg lineto
    arrowlength 0 lineto
    base halfheadthickness lineto
    base halfthickness lineto
    0 halfthickness lineto
    closepath
    fill
    savematrix setmatrix
   end
} def
% polymer before move
0 2 d
0 1 d
1 1 d
1 2 d
2 2 d
2 1 d
2 0 d
0 2 moveto
0 1 lineto
1 1 lineto
1 2 lineto
2 2 lineto
2 1 lineto
2 0 lineto
stroke
% draw a two-sided arrow
4 1 4.6 1 0.05 0.2 0.3 arrow
4 1 3.4 1 0.05 0.2 0.3 arrow
% polymer after one repatation move
6 0 translate
0 1 d
1 1 d
1 2 d
2 2 d
2 1 d
2 0 d
3 0 d
0 1 moveto
1 1 lineto
1 2 lineto
2 2 lineto
2 1 lineto
2 0 lineto
3 0 lineto
stroke
