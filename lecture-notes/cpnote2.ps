% open circle
/circle {
   newpath
   radius 0 360 arc stroke
   /Helvetica findfont 0.8 scalefont setfont
} def
/W {
   2 copy circle 
   moveto x y rmoveto (W) show
} def
/R {
   2 copy circle
   moveto x y rmoveto (R) show
} def
/caption {
/Times-Roman findfont 0.5 scalefont setfont
0.8 -1  moveto (A) show
3.3 -1 moveto (B) show
} def
