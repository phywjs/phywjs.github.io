%%BeginDocument: epsfiles/ch3sw.eps
/box {
   /y1 exch def
   /x1 exch def
   /y0 exch def
   /x0 exch def
x0 y0 moveto
x1 y0 lineto
x1 y1 lineto
x0 y1 lineto
closepath stroke
} def
%0 40 580 150 box
20 20 scale
1 2 translate
0.05 setlinewidth
/dx 7.2 def
/delta 0.15 def
/d {        % a filled dot
   newpath
   0.12 0 360 arc fill
} def
/dwhite {        % a filled dot
   gsave
   1 setgray
   newpath
   0.25 0 360 arc fill
   grestore
} def
/plus {     % plus sign
   2 copy moveto
   delta neg 0 rmoveto 
   delta 2 mul 0 rlineto
   stroke
   moveto
   0 delta neg rmoveto
   0 delta 2 mul rlineto
   stroke
} def
/minus {   % minus sign
   moveto
   delta neg 0 rmoveto 
   delta 2 mul 0 rlineto
   stroke
} def
/bond {  % draw a bond
   moveto
   lineto
   stroke
} def
% define the arrow
/arrowdict 14 dict def
arrowdict begin
 /mtrx matrix def
end
/arrow
 { arrowdict begin
    /headlength exch def
    /halfheadthickness exch 2 div def
    /halfthickness exch 2 div def
    /tipy exch def /tipx exch def
    /taily exch def /tailx exch def

    /dx tipx tailx sub def
    /dy tipy taily sub def
    /arrowlength dx dx mul dy dy mul add
     sqrt def
    /angle dy dx atan def
    /base arrowlength headlength sub def

    /savematrix mtrx currentmatrix def

    tailx taily translate
    angle rotate

    0 halfthickness neg moveto
    base halfthickness neg lineto
    base halfheadthickness neg lineto
    arrowlength 0 lineto
    base halfheadthickness lineto
    base halfthickness lineto
    0 halfthickness lineto
    closepath
    fill
    savematrix setmatrix
   end
} def
%  spin configuration in the beginning
/spinconfig {
1 1 minus
2 1 plus
3 1 minus
4 1 plus
5 1 plus
1 2 minus
2 2 plus
3 2 plus 
4 2 plus
5 2 minus
1 3 plus
2 3 plus
3 3 plus
4 3 plus
5 3 minus
1 4 plus
2 4 minus
3 4 plus
4 4 minus
5 4 minus
1 5 plus
2 5 minus
3 5 minus
4 5 plus
5 5 plus
} def
spinconfig
6 3 7 3 0.06 0.22 0.3 arrow
% spin and with bond
dx 0 translate
% draw bond 
/bondconfig {
1 1 1 2 bond
2 1 2 2 bond
4 1 4 2 bond
2 2 3 2 bond
3 2 3 3 bond
2 3 3 3 bond
3 3 4 3 bond
5 3 5 4 bond
1 4 1 5 bond
2 5 3 5 bond
4 4 5 4 bond
} def
bondconfig
1 1 5 {
   1 1 5 {
      1 index dwhite
   } for
   pop
} for
spinconfig
6 3 7 3 0.06 0.22 0.3 arrow
% erase spins, bonds only
dx 0 translate
bondconfig
6 3 7 3 0.06 0.22 0.3 arrow
% draw a dot at each site
1 1 5 {
   1 1 5 {
      1 index d
   } for
   pop
} for
% new spin configuraton
dx 0 translate
1 1 minus
2 1 minus
3 1 plus
4 1 plus
5 1 minus
1 2 minus
2 2 minus
3 2 minus 
4 2 plus
5 2 plus
1 3 plus
2 3 minus
3 3 minus
4 3 minus
5 3 minus
1 4 minus
2 4 minus
3 4 minus
4 4 minus
5 4 minus
1 5 minus
2 5 minus
3 5 minus
4 5 plus
5 5 plus
showpage
