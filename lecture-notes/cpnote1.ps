0.14 setlinewidth

1 1 L 1 sub {

   1 1 L 1 sub {

      2 copy

      rand p le {

         moveto

         0 1 rlineto stroke }

         { pop pop

      } ifelse

      2 copy

      rand p le {

          moveto

         1 0 rlineto stroke }

         { pop pop

      } ifelse

      pop

   } for

   pop

} for

0.22 setlinewidth

1 1 moveto

L 1 lineto stroke

1 L moveto

L L lineto stroke

0.13 setlinewidth

/L2 1 L add 2 div def

L2 L moveto

0 1 rlineto

L 0 rlineto

0 L 1 add neg rlineto

L neg 0 rlineto

0 1 rlineto

stroke

gsave

   1 setgray

   L2 L add L2 moveto

   0 0.3 rlineto

   stroke

grestore

L2 L add 0.5 sub

L2 0.3 add moveto 1.0 0 rlineto stroke

0.25 setlinewidth

L2 L add 0.25 sub

L2 moveto 0.5 0 rlineto stroke

showpage


%%EndDocument
 @endspecial 2173 w @beginspecial 0 @llx 0 @lly 560 @urx
500 @ury 1269 @rwi @setspecial
%%BeginDocument: epsfiles/current.eps



/box {

   /y1 exch def

   /x1 exch def

   /y0 exch def

   /x0 exch def

x0 y0 moveto

x1 y0 lineto

x1 y1 lineto

x0 y1 lineto

closepath stroke

} def

%0 0 560 500 box

%
/arrowdict 14 dict def

arrowdict begin

 /mtrx matrix def

end

/arrow

 { arrowdict begin

    /headlength exch def

    /halfheadthickness exch 2 div def

    /halfthickness exch 2 div def

    /tipy exch def /tipx exch def

    /taily exch def /tailx exch def



    /dx tipx tailx sub def

    /dy tipy taily sub def

    /arrowlength dx dx mul dy dy mul add

     sqrt def

    /angle dy dx atan def

    /base arrowlength headlength sub def



    /savematrix mtrx currentmatrix def



    tailx taily translate

    angle rotate



    0 halfthickness neg moveto

    base halfthickness neg lineto

    base halfheadthickness neg lineto

    arrowlength 0 lineto

    base halfheadthickness lineto

    base halfthickness lineto

    0 halfthickness lineto

    closepath

    fill

    savematrix setmatrix

   end

} def

40 60 translate

370 370 scale


/Helvetica findfont 0.12 scalefont setfont

/d 0.013 def

0 d 2 div sub  % move over 1/2 line width

0 1.2 0 d 0.05 0.1  arrow

1.25 -0.05 moveto (p) show

0 0 0 1 d 0.05 0.1  arrow

-0.05 1.05 moveto (I) show

0.5 -0.1 moveto (p) show

/Helvetica findfont 0.06 scalefont setfont

-0.01 -0.03 rmoveto (c) show


d setlinewidth

0.5 0 moveto

0.51 0.01 1.1 {

   dup 0.5 sub 1.3 exp lineto

} for

stroke

showpage


