%%BeginDocument: epsfiles/ctree.eps
/Max 9 def
/length 50 def
/tree {      % expecting x y length angle level on the stack
   /level exch def
   /angle exch def
   /length exch def
   /y exch def
   /x exch def
   level Max lt {
      /length length 0.615 mul def
      /dx length angle cos mul def
      /dy length angle sin mul def
      x y moveto
      dx dy rlineto
      stroke
      /x x dx add def
      /y y dy add def
      x y length angle 60 sub level 1 add 
      x y length angle 60 add level 1 add tree
      tree
   } if
} def
400 400 200 90 0 tree
400 400 200 210 0 tree
400 400 200 330 0 tree
showpage
%%EndDocument
 @endspecial 1418 w @beginspecial 0 @llx 0 @lly 550 @urx
550 @ury 1133 @rwi @setspecial
%%BeginDocument: epsfiles/bpercol2.eps


% Bond percolation configuration

%0 0 moveto 550 0 lineto 550 550 lineto 0 550 lineto closepath stroke


/L 10 def


/p 0.5 2147483647 mul def

2 setlinecap

50 50 scale

0.13 setlinewidth

1 1 L {

   1 1 L {

      2 copy

      rand p le {

         moveto

         0 1 rlineto stroke }

         { pop pop

      } ifelse

      2 copy

      rand p le {

          moveto

         1 0 rlineto stroke }

         { pop pop

      } ifelse

      pop

   } for

   pop

} for

0.17 setlinewidth

1 1 moveto L 1 lineto stroke

1 L 1 add moveto L L 1 add lineto stroke

showpage


