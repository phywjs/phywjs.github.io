%%BeginDocument: epsfiles/periodic.eps



/box {

   /y1 exch def

   /x1 exch def

   /y0 exch def

   /x0 exch def

x0 y0 moveto

x1 y0 lineto

x1 y1 lineto

x0 y1 lineto

closepath stroke

} def

%0 0 1000 320 box

40 40 scale

0 3 translate


/L 8 def


0.05 setlinewidth

1 1 moveto

L 1 lineto stroke

1 1 L {

   1 0.19 0 360 arc fill

} for

/Helvetica findfont 0.5 scalefont setfont

/cshow {

   dup stringwidth pop 3 div neg 0 rmoveto show

} def

1 1.5 moveto (1) cshow

2 1.5 moveto (2) cshow

3 1.5 moveto (3) cshow

L 1.5 moveto (L) cshow


/r L 2 add 2 div 3.1415926 div def

L 4 add 1 translate

newpath

0 0 r 0 360 arc stroke

/theta 360 L div def

theta dup 360 {

   dup cos r mul

   exch sin r mul

   0.19 0 360 arc fill

} for

r 0.5 add -0.15 moveto (1) show

theta cos r mul 0.5 add

theta sin r mul 2 copy

moveto 0 -0.15 rmoveto (2) show

neg moveto 0 -0.15 rmoveto (L) show

0 r 0.4 add moveto (3) cshow


4 -4.5 translate

1 1 L {

   dup 1 moveto

   dup L lineto

   dup 1 exch moveto

   L exch lineto

} for

stroke

showpage


%%EndDocument
 @endspecial 2976 w @beginspecial 0 @llx 0 @lly 200 @urx
200 @ury 1133 @rwi @setspecial
