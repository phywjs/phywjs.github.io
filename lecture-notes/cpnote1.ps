%%BeginDocument: epsfiles/label.eps
/box {
   /y1 exch def
   /x1 exch def
   /y0 exch def
   /x0 exch def
x0 y0 moveto
x1 y0 lineto
x1 y1 lineto
x0 y1 lineto
closepath stroke
} def
%0 0 800 300 box
/L 8 def
/p 0.45 def
100723 srand
/ip p 2147483647 mul def    % scale p to 0 to 2^31-1
/N L dup mul def
/Nminus1 N 1 sub def
/s N array def              % s is an array with L^2 elements
/Neighbors {                % Neighbors take a number from the
   /i exch def              % stack, generate neighbor sites
   i 1 add                  % of that site i.  The neighbor of site i
   dup L mod 0 eq {pop} if  % is i+1, i-1, i+L, i-L.  However,
   i L mod 0 ne {           % open boundary is used.  If the site  
      i 1 sub               % is at the edge, it does not have
   } if                     % neighbor outside.
   i L ge { i L sub } if 
   i N L sub lt { i L add } if 
} def
/XYcoordinate {
   dup L mod exch
   L idiv 
} def
/str 3 string def
/Color {                    % take a site from stack and color it.
   count 0 gt {             % If there are something on the stack,
      dup XYcoordinate      % Convert site number to (x,y) pair
      2 copy
      gsave
      1 setgray
         0.22 0 360 arc fill    % and draw a white disc.
      grestore
      moveto
      inc str cvs               % string is on the stack
      dup stringwidth pop 2 div
      neg -0.13 rmoveto show    % Write the cluster number
      [ exch Neighbors ]    % The neighbor sites is on the stack as array.
         { dup                   % if s[i] is 1, set it to 0 and  
            s exch get 1 eq {    % leave i on the stack, otherwise
            dup s exch 0 put }   % clear the stack
            { pop                % This is done for all the neighbors.
            } ifelse
         } forall
      Color
   } if
} def
50 20 translate
495 L 1 sub div 2 div dup scale
0 1 Nminus1 {
   s exch
   ip rand le {
      0}{1} ifelse
   put
} for
newpath
0 1 Nminus1 {
   dup s exch get 1 eq {
      XYcoordinate
      0.25 0 360 arc fill }{
      pop
   } ifelse
} for
0.01 setlinewidth
newpath
/Lm L 1 sub def
0 1 Lm {
   dup 0 moveto
   dup Lm lineto
   dup 0 exch moveto
   Lm exch lineto
} for
stroke
L 5 add 0 translate
newpath
0 1 Lm {
   dup 0 moveto
   dup Lm lineto
   dup 0 exch moveto
   Lm exch lineto
} for
stroke
newpath
0 1 Nminus1 {
   dup s exch get 1 eq {
      XYcoordinate
      0.25 0 360 arc fill }{
      pop
   } ifelse
} for
/inc 0 def
/Helvetica findfont 0.4 scalefont setfont
0 1 Nminus1 {
   dup s exch get 1 eq {
      /inc inc 1 add def
      Color }{
      pop
   } ifelse
} for
showpage
