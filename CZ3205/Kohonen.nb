Notebook[{
Cell[TextData[{
  StyleBox["Kohonen model for \"hearing\"",
    FontSize->36],
  "\n\nA sound source is located in a region G bounded by  y>0, y < x^2, |x| \
< 1, as shown below:"
}], "Input",
  FormatType->TextForm],

Cell[CellGroupData[{

Cell[BoxData[
    \(Plot[1 - x^2, \ {x, \(-1\), 1}]\)], "Input"],

