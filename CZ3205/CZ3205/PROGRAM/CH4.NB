Notebook[{

Cell[CellGroupData[{
Cell["Threshold Logic Unit", "Section"],

Cell[BoxData[
    \(\(step[x_] := \ If[x > 0, \ 1, \ 0];\)\)], "Input"],

Cell[BoxData[
    \(\(w = {0.4, \ 0.8, \ \(-0.3\)};\)\)], "Input"],

Cell[BoxData[
    \(\(g = 
        Table[{x = Random[], y = Random[], step[w . {x, y, 1}]}, {i, 1, 
            30}];\)\)], "Input"],

Cell[BoxData[{
    \(<< Graphics`Graphics`\), "\[IndentingNewLine]", 
    \(\(LabeledListPlot[g];\)\)}], "Input"],

Cell[CellGroupData[{

Cell["\<\
An Example of Perceptron Learning (classification of 2D points)\
\>", "Subsection"],

Cell[BoxData[
    \(\(mylabel[x_, \ y_] := 
        If[0.3  x + 0.7  y > 0.5, \ 1, \ 0];\)\)], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
    \(LabeledListPlot[
      Table[{x = Random[], y = Random[], mylabel[x, y]}, {i, 1, 
          30}]]\)], "Input"],

Cell[GraphicsData["PostScript", "\<\
