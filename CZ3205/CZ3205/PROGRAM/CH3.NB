Cell[CellGroupData[{

Cell["The initial output vector", "Subsection"],

Cell[BoxData[
    \(\(f = Table[Random[], {size}];\)\)], "Input"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The weights", "Subsection"],

Cell[BoxData[
    \(\(W = 
        Table[N[\(-maxstrength\)\ Exp[\(-\((i - j)\)\)*\((i - j)\)/\((2*sigma*
                        sigma)\)], 2], {i, size}, {j, size}];\)\)], "Input"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Simulating the response", "Subsection"],

Cell[BoxData[
    \(\(T[f_]\  := \ e + W . f;\)\)], "Input"],

Cell[CellGroupData[{

Cell[BoxData[{\(iterations = 15;\), "\[IndentingNewLine]", 
    RowBox[{
      RowBox[{"ListPlot", "[", 
        RowBox[{
          StyleBox[\(Nest[T, \ f, \ iterations]\),
            FontColor->RGBColor[0, 0, 1]], ",", \(PlotJoined \[Rule] True\), 
          ",", \(PlotRange \[Rule] {{0, size}, {\(-0.2\), 1.0}}\)}], "]"}], 
      ";"}]}], "Input"],

