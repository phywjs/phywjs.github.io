(*WindowFrame->Normal*)



Notebook[{

Cell[CellGroupData[{
Cell["Demonstrating Mach Band", "Section"],

Cell[BoxData[{
    \(\(Clear[y];\)\), "\[IndentingNewLine]", 
    \(low = 0.3; \ hi = 0.8;\), "\[IndentingNewLine]", 
    \(y[x_] := low /; x < 40\), "\[IndentingNewLine]", 
    \(y[x_] := \((\((hi - low)\)/40)\)\ x + \((low - \((hi - low)\))\) /; 
        x \[GreaterEqual] 40 && x < 80\), "\[IndentingNewLine]", 
    \(y[x_] := hi /; x \[GreaterEqual] 80\)}], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(Plot[y[x], {x, 0, 120}, PlotRange \[Rule] {0, 1}];\)\)], "Input"],

Cell[GraphicsData["PostScript", "\<\
