Cell["Make these to normalized vectors", "Text"],

Cell[CellGroupData[{

Cell["\<\
normalize[x_] := N[x/Sqrt[x.x]];
Bvec = normalize[Flatten[Bmatrix]];
Ivec = normalize[Flatten[Imatrix]];
Tvec = normalize[Flatten[Tmatrix]];
Pvec = normalize[Flatten[Pmatrix]];\
\>", "Input",
  AspectRatioFixed->True],

Cell[BoxData[
    \(General::"spell1" \(\(:\)\(\ \)\) 
      "Possible spelling error: new symbol name \"\!\(Ivec\)\" is similar to \
existing symbol \"\!\(Bvec\)\"."\)], "Message"],

Cell[BoxData[
    \(General::"spell" \(\(:\)\(\ \)\) 
      "Possible spelling error: new symbol name \"\!\(Tvec\)\" is similar to \
existing symbols \!\({Bvec, Ivec}\)."\)], "Message"],

Cell[BoxData[
    \(General::"spell" \(\(:\)\(\ \)\) 
      "Possible spelling error: new symbol name \"\!\(Pvec\)\" is similar to \
existing symbols \!\({Bvec, Ivec, Tvec}\)."\)], "Message"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Learning an association  B-> I", "Subsection"],

Cell["W = Outer[Times,Ivec,Bvec];", "Input",
  AspectRatioFixed->True],

Cell[CellGroupData[{

Cell["Check!", "Subsubsection"],

Cell[BoxData[
    \(\(g = W . Bvec;\)\)], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(ListDensityPlot[Partition[g, \ 10]];\)\)], "Input"],

