Cell[CellGroupData[{

Cell["Iterations", "Subsection"],

Cell[BoxData[
    \(\(f\  = \ Table[N[0], {size}];\)\)], "Input"],

Cell[CellGroupData[{

Cell[BoxData[{\(iterations\  = \ 80;\), "\[IndentingNewLine]", \(T[f_]\  := \ 
        f + epsilon \((e + W . f - f)\);\), "\[IndentingNewLine]", 
    RowBox[{
      RowBox[{"ListPlot", "[", 
        RowBox[{
          StyleBox[\(Nest[T, \ f, \ iterations]\),
            FontColor->RGBColor[0, 0, 1]], ",", \(PlotJoined \[Rule] True\), 
          ",", \(PlotRange \[Rule] {{0, size}, {\(-0.5\), 2.0}}\)}], "]"}], 
      ";"}]}], "Input"],

