Cell[BoxData[
    \(\[IndentingNewLine]\)], "Input"]
}, Closed]],

Cell[CellGroupData[{

Cell["Demonstrating Lateral Inhibition", "Section"],

Cell[CellGroupData[{

Cell["\<\
Parameters (The weight matrix is given by a Gaussian with width sigma, and \
maximum strength  maxstrength) \
\>", "Subsection"],

Cell[BoxData[""], "Input"],

Cell[BoxData[{
    \(\(size = 3*20;\)\), "\[IndentingNewLine]", 
    \(\(iterations\  = \ 10;\)\), "\[IndentingNewLine]", 
    \(\(sigma\  = \ 5;\)\), "\[IndentingNewLine]", 
    \(\(maxstrength\  = \ 0.05;\)\)}], "Input"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The input stimulus", "Subsection"],

Cell[CellGroupData[{

Cell[BoxData[{
    \(\(e = 
        Join[Table[0, {i, N[size/3]}], Table[i/N[size/3], {i, N[size/3]}], 
          Table[1, {i, N[size/3]}]];\)\), "\[IndentingNewLine]", 
    \(\(ListPlot[e, \ 
        PlotRange \[Rule] {{0, size}, {\(-0.2\), 1.0}}];\)\ \)}], "Input"],

