Cell[CellGroupData[{

Cell["Simulating the response", "Subsection"],

Cell[BoxData[
    \(\(T[f_]\  := \ e + W . f;\)\)], "Input"],

Cell[CellGroupData[{

Cell[BoxData[{\(iterations = 15;\), "\[IndentingNewLine]", 
    RowBox[{
      RowBox[{"ListPlot", "[", 
        RowBox[{
          StyleBox[\(Nest[T, \ f, \ iterations]\),
            FontColor->RGBColor[0, 0, 1]], ",", \(PlotJoined \[Rule] True\), 
          ",", \(PlotRange \[Rule] {{0, size}, {\(-0.2\), 1.0}}\)}], "]"}], 
      ";"}]}], "Input"],

