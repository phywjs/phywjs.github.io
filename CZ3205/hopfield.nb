Cell[BoxData[
    \(Define\ a\ ploting\ function\)], "Input"],

Cell[BoxData[
    \(plot[s_]\  := \ 
      Module[{sflp\  = \ 
            s}, \[IndentingNewLine]\(\(L\  = \ 
              Length[s];\)\[IndentingNewLine]
          \(For[i\  = \ 1, \ 
              i\  \[LessEqual] \ 
                L, \ \(++i\), \[IndentingNewLine]sflp[\([i]\)]\  = \ 
                1 - \ s[\([L - i\  + \ 
                        1]\)]\[IndentingNewLine]];\)\)\[IndentingNewLine]\
ListDensityPlot[sflp]\[IndentingNewLine]]\)], "Input"],

Cell[BoxData[
    \(plot[two]\)], "Input"],

Cell[BoxData[
    \(We\ now\ construct\ the\ W\ matrix . \ \ W\_ij\  < \(-\ 
          W\_ij\)\  + \ \((1/N)\)\ x\_i\ x\_j\)], "Input"],

Cell[BoxData[
    \(tosign[0]\  := \ \(-1\); \ tosign[x_]\  := \ 1\  /; \ x > 0;\)], "Input"],

Cell[BoxData[
    \(topattern[s_]\  := \ 
      Module[{}, \[IndentingNewLine]Table[
          s[\([i + 10*\((j - 1)\)]\)], \ {j, 10}, {i, 
            10}]\[IndentingNewLine]]\)], "Input"],

Cell[BoxData[
    \(\(\(wmatrix[
        lett_]\)\(\ \)\(:=\)\(\ \)\(Module[{a}, \[IndentingNewLine]a\  = \ 
          Flatten[lett]; \[IndentingNewLine]a\  = \ 
          Map[tosign, \ a]; \[IndentingNewLine]Outer[Times, a, 
          a]\[IndentingNewLine]]\)\(\ \)\)\)], "Input"],

Cell[BoxData[
    \(\(W\  = \ \((wmatrix[zero]\  + \ wmatrix[one]\  + \ wmatrix[two]\  + \ 
              wmatrix[three]\  + \ wmatrix[four]\  + \ wmatrix[five]\  + \ 
              wmatrix[six]\  + \ wmatrix[seven]\  + \ wmatrix[eight]\  + \ 
              wmatrix[nine])\)/10.0;\)\)], "Input"],

Cell[BoxData[
    \(Let\ first\ check\ if\ the\ equation\ \ sgn[\ W\ x\ ]\  = \ 
      x\ can\ be\ \(\(satisfied\)\(.\)\)\)], "Input"],

Cell[BoxData[
    \(toarray[s_]\  := \ Map[tosign, \ Flatten[s]]\)], "Input"],

Cell[BoxData[
    \(Sign[\ W . \ toarray[zero]]\  - \ toarray[zero]\)], "Input"],

Cell[BoxData[
    \(Wee\ see\ for\ letter\ three\ there\ is\ a\ single\ place\ which\ is\ \
wrong . \ \ Similarly, \ 
    there\ will\ be\ few\ places\ that\ is\ \(\(wrong\)\(.\)\)\)], "Input"],

Cell[BoxData[
    \(Now\ we\ implement\ Hopfield\ dynamics\)], "Input"],

Cell[BoxData[
    \(hopfield[n_, \ W_, \ sin_]\  := \ 
      Module[{s\  = \ sin}, \[IndentingNewLine]L\  = \ 
          Length[W]; \[IndentingNewLine]Do[\[IndentingNewLine]\ \ i\  = \ 
            Ceiling[L\ *\ 
                Random[]]; \[IndentingNewLine]\ \ \ s[\([i]\)]\  = \ 
            Sign[\ W[\([i]\)] . 
                s], \[IndentingNewLine]{n}]; \[IndentingNewLine]s\
\[IndentingNewLine]]\)], "Input"],

Cell[BoxData[
    \(We\ start\ with\ input\ addition\ some\ percentage\ of\ \
\(\(noise\)\(.\)\)\)], "Input"],

Cell[BoxData[
    \(sinput\  = \ 
      two\  + \ Table[\ 
          If[Random[]\  < \ 0.1, \ 1, \ 0], \ {10}, \ {10}]\)], "Input"],

Cell[BoxData[
    \(sout\  = \ hopfield[1000, \ W, toarray[sinput]]\)], "Input"],

Cell[BoxData[
    \(plot[topattern[sout]]\)], "Input"]
},
