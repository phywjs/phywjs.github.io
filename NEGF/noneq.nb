Cell["\<\
The little peak around 2.8 is an artifact of using finite nlead.   It should \
go to zero in the limit.\
\>", "Text",
 CellChangeTimes->{{3.4077325118106394`*^9, 3.407732512232512*^9}}]
}, Open  ]],

Cell[CellGroupData[{

Cell["Scattering boundary/mode-matching method", "Section"],

Cell[TextData[{
 "Now we use scattering boundary method to compute ",
 Cell[BoxData[
  FormBox[
   RowBox[{"transitoin", " ", "coefficient", " ", "t"}], TraditionalForm]]],
 " and reflection coefficient ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "."}], TraditionalForm]]],
 "  See J Wang and JS Wang, cond-mat/0509092.  The code works only for Nmax = \
2.  Note we need the ratio of group velocity in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["T", "sb"], "."}], TraditionalForm]]],
 "  v = -i k ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["e", "iq"], "-", 
      SuperscriptBox["e", 
       RowBox[{"-", "iq"}]]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"2", "\[Omega]"}], ")"}]}], TraditionalForm]]],
 "."
}], "Text",
 CellChangeTimes->{3.4076471685011015`*^9}],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "sbEq", ",", "sbvec", ",", "r", ",", "t", ",", "w", ",", "S", ",", "Tsb"}],
    "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sbEq", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", 
       ",", 
       RowBox[{"xL", "^", "2"}], ",", "0"}], "}"}], ",", 
     "\[IndentingNewLine]", "            ", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"-", "1"}], ",", "0", ",", "0", ",", "0", ",", "0", ",", "xL", 
       ",", "0"}], "}"}], ",", "\[IndentingNewLine]", "            ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "k1"}], ",", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"w", "^", "2"}]}], "+", "k1", "+", "kL"}], ",", 
       RowBox[{"-", "kL"}], ",", " ", "0", ",", "0", ",", "0", ",", "0", ",", 
       "0"}], "}"}], ",", "\[IndentingNewLine]", "           ", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"-", "kL"}], ",", " ", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"w", "^", "2"}]}], "+", "kL", "+", "kC"}], ",", " ", 
       RowBox[{"-", "kC"}], ",", " ", "0", ",", " ", "0", ",", "0", ",", " ", 
       "0"}], "}"}], ",", "\[IndentingNewLine]", "           ", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", " ", 
       RowBox[{"-", "kC"}], ",", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"w", "^", "2"}]}], "+", "kC", "+", "kR"}], ",", " ", 
       RowBox[{"-", "kR"}], ",", " ", "0", ",", "0", " ", ",", " ", "0"}], 
      "}"}], ",", "\[IndentingNewLine]", "            ", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0", ",", 
       RowBox[{"-", "kR"}], ",", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"w", "^", "2"}]}], "+", "kR", "+", "k2"}], ",", 
       RowBox[{"-", "k2"}], ",", "0", ",", "0"}], "}"}], ",", 
     "\[IndentingNewLine]", "           ", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", " ", "0", ",", " ", "0", ",", " ", 
       RowBox[{"-", "1"}], ",", "0", ",", " ", "0", ",", " ", "xR"}], "}"}], 
     ",", "\[IndentingNewLine]", "           ", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0", ",", 
       RowBox[{"-", "1"}], ",", " ", "0", ",", " ", 
       RowBox[{"xR", "^", "2"}]}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sbvec", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "1"}], "/", 
      RowBox[{"xL", "^", "2"}]}], ",", " ", 
     RowBox[{
      RowBox[{"-", "1"}], "/", "xL"}], ",", " ", "0", ",", "0", ",", "0", ",",
      "0", ",", "0", ",", "0"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"r", ",", "t"}], "}"}], "=", 
   RowBox[{
    RowBox[{"LinearSolve", "[", 
     RowBox[{"sbEq", ",", " ", "sbvec"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"{", 
      RowBox[{"7", ",", "8"}], "}"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Tsb", "[", "w_", "]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Abs", "[", "t", "]"}], "^", "2"}], " ", "*", " ", 
    RowBox[{"Abs", "[", 
     RowBox[{"k2", " ", 
      RowBox[{
       RowBox[{"(", " ", 
        RowBox[{"xR", " ", "-", " ", 
         RowBox[{"1", "/", "xR"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"k1", 
         RowBox[{"(", 
          RowBox[{"xL", "-", 
           RowBox[{"1", "/", "xL"}]}], ")"}]}], ")"}]}]}], "]"}]}]}], 
  ";"}]}], "Input"],

