                    RowBox[{"k", "\[LessEqual]", " ", "Nmax"}], ",", " ", 
                    RowBox[{"++", "k"}], ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"res", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", ",", "k"}], "]"}], "]"}], " ", "+=", " ", 
                    RowBox[{"Y", "*", 
                    RowBox[{"T", "[", 
                    RowBox[{"j", ",", "k", ",", "l"}], "]"}], "*", 
                    RowBox[{"T", "[", 
                    RowBox[{"m", ",", "r", ",", "s"}], "]"}], "*", 
                    RowBox[{"T", "[", 
                    RowBox[{"u", ",", "v", ",", "w"}], "]"}], "*", 
                    RowBox[{"T", "[", 
                    RowBox[{"x", ",", "y", ",", "z"}], "]"}], "*", 
                    RowBox[{"(", 
                    RowBox[{"3", "-", 
                    RowBox[{"2", "*", "\[Sigma]"}]}], ")"}], "*", 
                    RowBox[{"(", 
                    RowBox[{"3", "-", 
                    RowBox[{"2", "*", "\[Sigma]pp"}]}], ")"}], "*", 
                    RowBox[{"(", 
                    RowBox[{"3", "-", 
                    RowBox[{"2", "*", "\[Sigma]ppp"}]}], ")"}], "*", 
                    RowBox[{"(", 
                    RowBox[{"3", "-", 
                    RowBox[{"2", "*", "\[Sigma]4"}]}], ")"}]}]}], ";"}]}], 
                    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
                    "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
                    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
                    "]"}]}], "\[IndentingNewLine]", "]"}]}], 
                    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
                    "]"}]}], "\[IndentingNewLine]", "]"}]}], 
                 "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
               "]"}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]",
            "]"}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{
        RowBox[{"cof2", "^", "2"}], "*", "res", " ", "*", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"-", "4.0"}], ")"}], "/", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"2.0", "*", "Pi"}], ")"}], "^", "2"}]}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalSigma]nf7", "[", 
    RowBox[{
    "\[Sigma]_Integer", ",", "\[Sigma]p_Integer", ",", " ", "\[Omega]_Real"}],
     "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "j", ",", "k", ",", "l", ",", "m", ",", "r", ",", "s", ",", "u", ",", 
       "v", ",", "w", ",", "x", ",", "y", ",", "z", ",", "\[Sigma]pp", ",", 
       "\[Sigma]ppp", ",", "\[Sigma]4", ",", "i0", ",", "i", ",", "ip", ",", 
       "ipp", ",", "res", ",", "Y"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"res", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", " ", 
         RowBox[{"{", "Nmax", "}"}], ",", 
         RowBox[{"{", "Nmax", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"\[Sigma]", " ", "\[NotEqual]", "\[Sigma]p"}], ",", " ", 
        RowBox[{"Return", "[", "res", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"i", "=", 
       RowBox[{"wToi", "[", "\[Omega]", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"i0", "=", 
       RowBox[{"wToi", "[", "0.0", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"l", "=", "1"}], ",", " ", 
        RowBox[{"l", "\[LessEqual]", "Nmax"}], ",", " ", 
        RowBox[{"++", "l"}], ",", "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"m", "=", "1"}], ",", " ", 
          RowBox[{"m", "\[LessEqual]", " ", "Nmax"}], ",", " ", 
          RowBox[{"++", "m"}], ",", "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"r", "=", "1"}], ",", " ", 
            RowBox[{"r", " ", "\[LessEqual]", " ", "Nmax"}], ",", " ", 
            RowBox[{"++", "r"}], ",", "\[IndentingNewLine]", 
            RowBox[{"For", "[", 
             RowBox[{
              RowBox[{"s", "=", "1"}], ",", 
              RowBox[{"s", "\[LessEqual]", " ", "Nmax"}], ",", " ", 
              RowBox[{"++", "s"}], ",", "\[IndentingNewLine]", 
              RowBox[{"For", "[", 
               RowBox[{
                RowBox[{"u", "=", "1"}], ",", " ", 
                RowBox[{"u", "\[LessEqual]", " ", "Nmax"}], ",", " ", 
                RowBox[{"++", "u"}], ",", "\[IndentingNewLine]", 
                RowBox[{"For", "[", 
                 RowBox[{
                  RowBox[{"v", "=", "1"}], ",", 
                  RowBox[{"v", "\[LessEqual]", " ", "Nmax"}], ",", " ", 
                  RowBox[{"++", "v"}], ",", "\[IndentingNewLine]", 
                  RowBox[{"For", "[", 
                   RowBox[{
                    RowBox[{"w", "=", "1"}], ",", " ", 
                    RowBox[{"w", "\[LessEqual]", " ", "Nmax"}], ",", " ", 
                    RowBox[{"++", "w"}], ",", "\[IndentingNewLine]", 
                    RowBox[{"For", "[", 
                    RowBox[{
                    RowBox[{"x", "=", "1"}], ",", " ", 
                    RowBox[{"x", "\[LessEqual]", " ", "Nmax"}], ",", " ", 
                    RowBox[{"++", "x"}], ",", "\[IndentingNewLine]", 
                    RowBox[{"For", "[", 
                    RowBox[{
                    RowBox[{"y", "=", "1"}], ",", 
                    RowBox[{"y", "\[LessEqual]", " ", "Nmax"}], ",", " ", 
                    RowBox[{"++", "y"}], ",", "\[IndentingNewLine]", 
                    RowBox[{"For", "[", 
                    RowBox[{
                    RowBox[{"z", "=", "1"}], ",", " ", 
                    RowBox[{"z", "\[LessEqual]", " ", "Nmax"}], ",", " ", 
                    RowBox[{"++", "z"}], ",", "\[IndentingNewLine]", 
                    RowBox[{"For", "[", 
                    RowBox[{
                    RowBox[{"\[Sigma]pp", "=", "1"}], ",", " ", 
                    RowBox[{"\[Sigma]pp", " ", "\[LessEqual]", "2"}], ",", 
                    " ", 
                    RowBox[{"++", "\[Sigma]pp"}], ",", "\[IndentingNewLine]", 
                    
                    RowBox[{"For", "[", 
                    RowBox[{
                    RowBox[{"\[Sigma]ppp", "=", "1"}], ",", " ", 
                    RowBox[{"\[Sigma]ppp", "\[LessEqual]", "2"}], ",", " ", 
                    RowBox[{"++", "\[Sigma]ppp"}], ",", "\[IndentingNewLine]",
                     
                    RowBox[{"For", "[", 
                    RowBox[{
                    RowBox[{"\[Sigma]4", "=", "1"}], ",", 
                    RowBox[{"\[Sigma]4", " ", "\[LessEqual]", " ", "2"}], ",",
                     " ", 
                    RowBox[{"++", "\[Sigma]4"}], ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Y", "=", 
                    RowBox[{
                    RowBox[{"dwglobal", "^", "2"}], " ", "*", " ", 
                    RowBox[{"getG", "[", 
                    RowBox[{
                    "i0", ",", "\[Sigma]", ",", "\[Sigma]pp", ",", "l", ",", 
                    "m"}], "]"}], "*", 
                    RowBox[{"Sum", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"getG", "[", 
                    RowBox[{
                    "ip", ",", "\[Sigma]pp", ",", "\[Sigma]ppp", ",", "r", 
                    ",", "u"}], "]"}], " ", "*", " ", 
                    RowBox[{"getG", "[", 
                    RowBox[{
                    "ip", ",", "\[Sigma]4", ",", "\[Sigma]pp", ",", "x", ",", 
                    "s"}], "]"}], " ", "*", " ", 
                    RowBox[{"getG", "[", 
                    RowBox[{
                    "ipp", ",", "\[Sigma]ppp", ",", "\[Sigma]4", ",", "v", 
                    ",", "y"}], "]"}], "*", 
                    RowBox[{"getG", "[", 
                    RowBox[{
                    RowBox[{"i0", "+", "ipp", "-", "ip"}], ",", "\[Sigma]4", 
                    ",", "\[Sigma]ppp", ",", "z", ",", "w"}], "]"}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{"ip", ",", "1", ",", "iMaxglobal"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"ipp", ",", "1", ",", "iMaxglobal"}], "}"}]}], 
                    "]"}]}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"For", "[", 
                    RowBox[{
                    RowBox[{"j", "=", "1"}], ",", " ", 
                    RowBox[{"j", "\[LessEqual]", " ", "Nmax"}], ",", " ", 
                    RowBox[{"++", "j"}], ",", "\[IndentingNewLine]", 
                    RowBox[{"For", "[", 
                    RowBox[{
                    RowBox[{"k", "=", "1"}], ",", 
                    RowBox[{"k", "\[LessEqual]", " ", "Nmax"}], ",", " ", 
                    RowBox[{"++", "k"}], ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"res", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", ",", "k"}], "]"}], "]"}], " ", "+=", " ", 
                    RowBox[{"Y", "*", 
                    RowBox[{"T", "[", 
                    RowBox[{"j", ",", "k", ",", "l"}], "]"}], "*", 
                    RowBox[{"T", "[", 
                    RowBox[{"r", ",", "s", ",", "m"}], "]"}], "*", 
                    RowBox[{"T", "[", 
                    RowBox[{"u", ",", "v", ",", "w"}], "]"}], "*", 
                    RowBox[{"T", "[", 
                    RowBox[{"x", ",", "y", ",", "z"}], "]"}], "*", 
                    RowBox[{"(", 
                    RowBox[{"3", "-", 
                    RowBox[{"2", "*", "\[Sigma]"}]}], ")"}], "*", 
                    RowBox[{"(", 
                    RowBox[{"3", "-", 
                    RowBox[{"2", "*", "\[Sigma]pp"}]}], ")"}], "*", 
                    RowBox[{"(", 
                    RowBox[{"3", "-", 
                    RowBox[{"2", "*", "\[Sigma]ppp"}]}], ")"}], "*", 
                    RowBox[{"(", 
                    RowBox[{"3", "-", 
                    RowBox[{"2", "*", "\[Sigma]4"}]}], ")"}]}]}], ";"}]}], 
                    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
                    "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
                    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
                    "]"}]}], "\[IndentingNewLine]", "]"}]}], 
                    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
                    "]"}]}], "\[IndentingNewLine]", "]"}]}], 
                 "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
               "]"}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]",
            "]"}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{
        RowBox[{"cof2", "^", "2"}], "*", "res", " ", "*", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"-", "4.0"}], ")"}], "/", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"2.0", "*", "Pi"}], ")"}], "^", "2"}]}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[CapitalSigma]nf8", "[", 
   RowBox[{
   "\[Sigma]_Integer", ",", "\[Sigma]p_Integer", ",", " ", "\[Omega]_Real"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "j", ",", "k", ",", "l", ",", "m", ",", "r", ",", "s", ",", "u", ",", 
      "v", ",", "w", ",", "x", ",", "y", ",", "z", ",", "\[Sigma]pp", ",", 
      "\[Sigma]ppp", ",", "\[Sigma]4", ",", "i0", ",", "i", ",", "ip", ",", 
      "ipp", ",", "res", ",", "Y"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"res", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{"0", ",", " ", 
        RowBox[{"{", "Nmax", "}"}], ",", 
        RowBox[{"{", "Nmax", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"\[Sigma]", "!=", "\[Sigma]p"}], ",", " ", 
       RowBox[{"Return", "[", "res", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"i", "=", 
      RowBox[{"wToi", "[", "\[Omega]", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"i0", "=", 
      RowBox[{"wToi", "[", "0.0", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"l", "=", "1"}], ",", " ", 
       RowBox[{"l", "\[LessEqual]", "Nmax"}], ",", " ", 
       RowBox[{"++", "l"}], ",", "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"m", "=", "1"}], ",", " ", 
         RowBox[{"m", "\[LessEqual]", " ", "Nmax"}], ",", " ", 
         RowBox[{"++", "m"}], ",", "\[IndentingNewLine]", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"r", "=", "1"}], ",", " ", 
           RowBox[{"r", " ", "\[LessEqual]", " ", "Nmax"}], ",", " ", 
           RowBox[{"++", "r"}], ",", "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"s", "=", "1"}], ",", 
             RowBox[{"s", "\[LessEqual]", " ", "Nmax"}], ",", " ", 
             RowBox[{"++", "s"}], ",", "\[IndentingNewLine]", 
             RowBox[{"For", "[", 
              RowBox[{
               RowBox[{"u", "=", "1"}], ",", " ", 
               RowBox[{"u", "\[LessEqual]", " ", "Nmax"}], ",", " ", 
               RowBox[{"++", "u"}], ",", "\[IndentingNewLine]", 
               RowBox[{"For", "[", 
                RowBox[{
                 RowBox[{"v", "=", "1"}], ",", 
                 RowBox[{"v", "\[LessEqual]", " ", "Nmax"}], ",", " ", 
                 RowBox[{"++", "v"}], ",", "\[IndentingNewLine]", 
                 RowBox[{"For", "[", 
                  RowBox[{
                   RowBox[{"w", "=", "1"}], ",", " ", 
                   RowBox[{"w", "\[LessEqual]", " ", "Nmax"}], ",", " ", 
                   RowBox[{"++", "w"}], ",", "\[IndentingNewLine]", 
                   RowBox[{"For", "[", 
                    RowBox[{
                    RowBox[{"x", "=", "1"}], ",", " ", 
                    RowBox[{"x", "\[LessEqual]", " ", "Nmax"}], ",", " ", 
                    RowBox[{"++", "x"}], ",", "\[IndentingNewLine]", 
                    RowBox[{"For", "[", 
                    RowBox[{
                    RowBox[{"y", "=", "1"}], ",", 
                    RowBox[{"y", "\[LessEqual]", " ", "Nmax"}], ",", " ", 
                    RowBox[{"++", "y"}], ",", "\[IndentingNewLine]", 
                    RowBox[{"For", "[", 
                    RowBox[{
                    RowBox[{"z", "=", "1"}], ",", " ", 
                    RowBox[{"z", "\[LessEqual]", " ", "Nmax"}], ",", " ", 
                    RowBox[{"++", "z"}], ",", "\[IndentingNewLine]", 
                    RowBox[{"For", "[", 
                    RowBox[{
                    RowBox[{"\[Sigma]pp", "=", "1"}], ",", " ", 
                    RowBox[{"\[Sigma]pp", " ", "\[LessEqual]", "2"}], ",", 
                    " ", 
                    RowBox[{"++", "\[Sigma]pp"}], ",", "\[IndentingNewLine]", 
                    
                    RowBox[{"For", "[", 
                    RowBox[{
                    RowBox[{"\[Sigma]ppp", "=", "1"}], ",", " ", 
                    RowBox[{"\[Sigma]ppp", "\[LessEqual]", "2"}], ",", " ", 
                    RowBox[{"++", "\[Sigma]ppp"}], ",", "\[IndentingNewLine]",
                     
                    RowBox[{"For", "[", 
                    RowBox[{
                    RowBox[{"\[Sigma]4", "=", "1"}], ",", " ", 
                    RowBox[{"\[Sigma]4", "\[LessEqual]", "2"}], ",", " ", 
                    RowBox[{"++", "\[Sigma]4"}], ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Y", "=", 
                    RowBox[{
                    RowBox[{"dwglobal", "^", "2"}], " ", "*", " ", 
                    RowBox[{"getG", "[", 
                    RowBox[{
                    "i0", ",", "\[Sigma]", ",", "\[Sigma]pp", ",", "l", ",", 
                    "m"}], "]"}], "*", 
                    RowBox[{"getG", "[", 
                    RowBox[{
                    "i0", ",", "\[Sigma]pp", ",", "\[Sigma]ppp", ",", "r", 
                    ",", "w"}], "]"}], " ", "*", 
                    RowBox[{"getG", "[", 
                    RowBox[{
                    "i0", ",", "\[Sigma]pp", ",", "\[Sigma]4", ",", "s", ",", 
                    "x"}], "]"}], "*", 
                    RowBox[{"Sum", "[", 
                    RowBox[{
                    RowBox[{"getG", "[", 
                    RowBox[{
                    "ip", ",", "\[Sigma]ppp", ",", "\[Sigma]ppp", ",", "u", 
                    ",", "v"}], "]"}], ",", " ", "\[IndentingNewLine]", 
                    RowBox[{"{", 
                    RowBox[{"ip", ",", "1", ",", "iMaxglobal"}], "}"}]}], " ",
                     "]"}], "*", " ", 
                    RowBox[{"Sum", "[", "\[IndentingNewLine]", " ", 
                    RowBox[{
                    RowBox[{"getG", "[", 
                    RowBox[{
                    "ipp", ",", "\[Sigma]4", ",", "\[Sigma]4", ",", "y", ",", 
                    "z"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"ipp", ",", "1", ",", "iMaxglobal"}], "}"}]}], 
                    "]"}]}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"For", "[", 
                    RowBox[{
                    RowBox[{"j", "=", "1"}], ",", " ", 
                    RowBox[{"j", "\[LessEqual]", " ", "Nmax"}], ",", " ", 
                    RowBox[{"++", "j"}], ",", "\[IndentingNewLine]", 
                    RowBox[{"For", "[", 
                    RowBox[{
                    RowBox[{"k", "=", "1"}], ",", 
                    RowBox[{"k", "\[LessEqual]", " ", "Nmax"}], ",", " ", 
                    RowBox[{"++", "k"}], ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"res", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", ",", "k"}], "]"}], "]"}], " ", "+=", " ", 
                    RowBox[{"Y", "*", 
                    RowBox[{"T", "[", 
                    RowBox[{"j", ",", "k", ",", "l"}], "]"}], "*", 
                    RowBox[{"T", "[", 
                    RowBox[{"m", ",", "r", ",", "s"}], "]"}], "*", 
                    RowBox[{"T", "[", 
                    RowBox[{"u", ",", "v", ",", "w"}], "]"}], "*", 
                    RowBox[{"T", "[", 
                    RowBox[{"x", ",", "y", ",", "z"}], "]"}], "*", 
                    RowBox[{"(", 
                    RowBox[{"3", "-", 
                    RowBox[{"2", "*", "\[Sigma]"}]}], ")"}], "*", 
                    RowBox[{"(", 
                    RowBox[{"3", "-", 
                    RowBox[{"2", "*", "\[Sigma]pp"}]}], ")"}], "*", 
                    RowBox[{"(", 
                    RowBox[{"3", "-", 
                    RowBox[{"2", "*", "\[Sigma]ppp"}]}], ")"}], "*", 
                    RowBox[{"(", 
                    RowBox[{"3", "-", 
                    RowBox[{"2", "*", "\[Sigma]4"}]}], ")"}]}]}], ";"}]}], 
                    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
                    "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
                    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
                    "]"}]}], "\[IndentingNewLine]", "]"}]}], 
                    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
                    "]"}]}], "\[IndentingNewLine]", "]"}]}], 
                "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
              "]"}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
          "]"}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Return", "[", 
      RowBox[{
       RowBox[{"cof2", "^", "2"}], "*", "res", " ", "*", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"-", "2.0"}], ")"}], "/", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"2.0", "*", "Pi"}], ")"}], "^", "2"}]}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input"],

Cell[TextData[{
 "Once the self-energy is computed, the Green's function Gn for the whole \
nonlinear system is obtained by solving the contour variable Dyson equation.  \
The results are (by applying the Langreth theorem and some algebra, see book \
by H Haug and A-P Jauho \"Quantum Kinetics in Transport ... \"), for ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["Gn", "R"], TraditionalForm]]],
 ":  \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["Gn", "R"], "=", 
    RowBox[{
     SuperscriptBox["G", "R"], "+", 
     RowBox[{
      SuperscriptBox["G", "R"], 
      SuperscriptBox["\[CapitalSigma]n", "R"], 
      SuperscriptBox["Gn", "R"]}]}]}], TraditionalForm]]],
 ",\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["Gn", "<"], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox["Gn", "R"], 
      SuperscriptBox["\[CapitalSigma]n", "<"], 
      SuperscriptBox["Gn", "A"]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{
         SuperscriptBox["Gn", "R"], 
         SuperscriptBox["\[CapitalSigma]n", "R"]}]}], ")"}], 
      RowBox[{
       SuperscriptBox["G", "<"], "(", 
       RowBox[{"1", "+", 
        RowBox[{
         SuperscriptBox["\[CapitalSigma]n", "A"], 
         SuperscriptBox["Gn", "A"]}]}], ")"}]}]}]}], TraditionalForm]]],
 ".\n(See 5 Aug 05 note pages for a derivation).  Be careful about the \
difference between Gn and G.  We compute Gn in numerical form, as symbolic \
results are too slow.  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{
      SuperscriptBox["Gn", "R"], "[", "\[Omega]", "]"}], 
     RowBox[{
      RowBox[{"-", "1"}], " "}]], "=", 
    RowBox[{
     RowBox[{"A", "[", "\[Omega]", "]"}], " ", "-", 
     RowBox[{
      SuperscriptBox["\[CapitalSigma]n", "R"], "[", "\[Omega]", "]"}]}]}], 
   TraditionalForm]]],
 ".  Note that in the code ",
 Cell[BoxData[
  FormBox["T", TraditionalForm]]],
 " stands for time-ordered, ell for less <, ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]]],
 " for retarded, and ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]]],
 " for advanced, and the prefix ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " for numerical or nonlinear.  Finally, the current from the left lead is \
obtained from\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"<", 
    SubscriptBox["Q", "L"], ">=", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"2", "\[Pi]"}]], 
     RowBox[{
      SubsuperscriptBox["\[Integral]", 
       RowBox[{"-", "\[Infinity]"}], 
       RowBox[{"+", "\[Infinity]"}]], 
      RowBox[{"\[Omega]Tr", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           SuperscriptBox["Gn", "R"], "[", "\[Omega]", "]"}], 
          RowBox[{
           SubsuperscriptBox["\[CapitalSigma]", "L", "<"], "[", "\[Omega]", 
           "]"}]}], "+", 
         RowBox[{
          RowBox[{
           SuperscriptBox["Gn", "<"], "[", "\[Omega]", "]"}], 
          RowBox[{
           SubsuperscriptBox["\[CapitalSigma]", "L", "A"], "[", "\[Omega]", 
           "]"}]}]}], "}"}], 
       RowBox[{"\[DifferentialD]", "\[Omega]"}]}]}]}]}], TraditionalForm]]],
 ", Where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalSigma]", "L"], TraditionalForm]]],
 " is the self-energy of the free lead (not the central part).  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalSigma]", "L", 
     RowBox[{"<", 
      RowBox[{",", "A"}]}]], "=", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          SuperscriptBox[
           SubscriptBox["k", "1"], "2"], 
          SubsuperscriptBox["g", "L", 
           RowBox[{"<", 
            RowBox[{",", "A"}]}]]}], ",", " ", "0", ",", " ", "..."}], "}"}], 
       ",", "...", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "...", ",", "0"}], "}"}]}], "}"}], "."}]}], 
   TraditionalForm]]],
 "  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"<", 
    SubscriptBox["Q", "R"], ">"}], TraditionalForm]]],
 " is similar. ( See 21 Sep 05, note page 30).   We take the symmetrized form \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["Q", "L"], "-", 
      SubscriptBox["Q", "R"]}], ")"}], "/", "2"}], TraditionalForm]]],
 ", which seems numerically more accurate. We can define an effective \
transmission by -2",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{
        SuperscriptBox["Gn", "R"], "[", "\[Omega]", "]"}], 
       RowBox[{
        SubsuperscriptBox["\[CapitalSigma]", "L", "<"], "[", "\[Omega]", 
        "]"}]}], "+", 
      RowBox[{
       RowBox[{
        SuperscriptBox["Gn", "<"], "[", "\[Omega]", "]"}], 
       RowBox[{
        SubsuperscriptBox["\[CapitalSigma]", "L", "A"], "[", "\[Omega]", 
        "]"}]}]}], ")"}], "/", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{
       SubscriptBox["f", "B"], "(", 
       SubscriptBox["T", "1"], ")"}], "-", 
      RowBox[{
       SubscriptBox["f", 
        StyleBox["B",
         FontWeight->"Plain"]], "(", 
       SubscriptBox["T", "2"], ")"}]}], "]"}]}], TraditionalForm]]],
 ". (\"-\" because the integral give negative, 2 because in Landauer formula, \
we integrate from 0 to infinity.]  Note that the result is complex, the \
imaginary part is not very meaningful.  But the integral from -\[Infinity] to \
+\[Infinity] should be zero for ",
 Cell[BoxData[
  FormBox["Q", TraditionalForm]]],
 " for the imaginery part.  The transmission is calculated here by finite \
temperature difference. "
}], "Text",
 CellChangeTimes->{{3.407723805454197*^9, 3.407723805641697*^9}, {
  3.407724400485447*^9, 3.407724417376072*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"transmission", "[", "w_", "]"}], ":=", 
  RowBox[{"Module", "[", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "i", ",", "j", ",", "one", ",", "n\[CapitalSigma]T", ",", 
      "n\[CapitalSigma]l", ",", "n\[CapitalSigma]r", ",", "n\[CapitalSigma]a",
       ",", "A", ",", "Gr", ",", "Ga", ",", "Gl", ",", "\[CapitalSigma]l", 
      ",", "nGr", ",", "nGa", ",", "nGl", ",", "nGlfirstterm", ",", 
      "nGlsecondterm", ",", "QL", ",", "QR"}], "}"}], " ", ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"A", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Which", "[", 
         RowBox[{
          RowBox[{"i", "\[Equal]", "j"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"w", "+", 
              RowBox[{"I", "*", "\[Eta]"}]}], ")"}], "^", "2"}], "-", 
           RowBox[{"2", "*", "kC"}]}], ",", "\[IndentingNewLine]", "\t\t", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"i", "-", "j"}], "]"}], "\[Equal]", "1"}], ",", " ", "kC",
           ",", "\[IndentingNewLine]", "\t\t", "True", ",", " ", "0"}], "]"}],
         ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "Nmax"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", "Nmax"}], "}"}]}], "]"}]}], ";", 
     RowBox[{
      RowBox[{"A", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "1"}], "]"}], "]"}], " ", "+=", " ", 
      RowBox[{"kC", " ", "-", "k1", "-", 
       RowBox[{
        RowBox[{"k1", "^", "2"}], "*", 
        RowBox[{"g", "[", 
         RowBox[{"w", ",", "k1", ",", "k1onsite"}], "]"}]}]}]}], ";", 
     RowBox[{
      RowBox[{"A", "[", 
       RowBox[{"[", 
        RowBox[{"Nmax", ",", "Nmax"}], "]"}], "]"}], " ", "+=", " ", 
      RowBox[{"kC", " ", "-", "k2", " ", "-", 
       RowBox[{
        RowBox[{"k2", "^", "2"}], " ", "*", 
        RowBox[{"g", "[", 
         RowBox[{"w", ",", "k2", ",", "k2onsite"}], "]"}]}]}]}], ";", 
     RowBox[{"Gr", " ", "=", " ", 
      RowBox[{"Inverse", "[", "A", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Ga", "=", 
      RowBox[{"ConjugateTranspose", "[", "Gr", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[CapitalSigma]l", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"0", ",", 
        RowBox[{"{", "Nmax", "}"}], ",", 
        RowBox[{"{", "Nmax", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[CapitalSigma]l", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "1"}], "]"}], "]"}], "=", " ", 
      RowBox[{
       RowBox[{"k1", "^", "2"}], "*", 
       RowBox[{"gl", "[", 
        RowBox[{"w", ",", "k1", ",", "k1onsite", ",", "T1"}], "]"}]}]}], ";", 
     " ", 
     RowBox[{
      RowBox[{"\[CapitalSigma]l", "[", 
       RowBox[{"[", 
        RowBox[{"Nmax", ",", "Nmax"}], "]"}], "]"}], "=", " ", 
      RowBox[{
       RowBox[{"k2", "^", "2"}], "*", 
       RowBox[{"gl", "[", 
        RowBox[{"w", ",", "k2", ",", "k2onsite", ",", "T2"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Gl", " ", "=", "  ", 
      RowBox[{
      "Gr", " ", ".", " ", "\[CapitalSigma]l", " ", ".", " ", "Ga"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"order", " ", "\[Equal]", " ", "0"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"n\[CapitalSigma]T", " ", "=", " ", 
         RowBox[{"n\[CapitalSigma]l", "=", " ", 
          RowBox[{"Table", "[", 
           RowBox[{"0", ",", 
            RowBox[{"{", "Nmax", "}"}], ",", 
            RowBox[{"{", "Nmax", "}"}]}], "]"}]}]}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"order", " ", ">", " ", "0"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"n\[CapitalSigma]T", " ", "=", 
         RowBox[{
          RowBox[{"\[CapitalSigma]nf1", "[", 
           RowBox[{"1", ",", "1", ",", "w"}], "]"}], "+", 
          RowBox[{"\[CapitalSigma]nf2", "[", 
           RowBox[{"1", ",", "1", ",", "w"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"n\[CapitalSigma]l", "=", 
         RowBox[{"\[CapitalSigma]nf1", "[", 
          RowBox[{"1", ",", "2", ",", "w"}], "]"}]}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"order", " ", "\[Equal]", " ", "2"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"n\[CapitalSigma]T", "+=", " ", 
         RowBox[{
          RowBox[{"\[CapitalSigma]nf3", "[", 
           RowBox[{"1", ",", "1", ",", "w"}], "]"}], " ", "+", " ", 
          RowBox[{"\[CapitalSigma]nf4", "[", 
           RowBox[{"1", ",", "1", ",", "w"}], "]"}], "+", 
          RowBox[{"\[CapitalSigma]nf5", "[", 
           RowBox[{"1", ",", "1", ",", "w"}], "]"}], "+", 
          RowBox[{"\[CapitalSigma]nf6", "[", 
           RowBox[{"1", ",", "1", ",", "w"}], "]"}], "+", 
          RowBox[{"\[CapitalSigma]nf7", "[", 
           RowBox[{"1", ",", "1", ",", "w"}], "]"}], "+", 
          RowBox[{"\[CapitalSigma]nf8", "[", 
           RowBox[{"1", ",", "1", ",", "w"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"n\[CapitalSigma]l", " ", "+=", " ", 
         RowBox[{
          RowBox[{"\[CapitalSigma]nf3", "[", 
           RowBox[{"1", ",", "2", ",", "w"}], "]"}], "+", 
          RowBox[{"\[CapitalSigma]nf4", "[", 
           RowBox[{"1", ",", "2", ",", "w"}], "]"}], "+", 
          RowBox[{"\[CapitalSigma]nf5", "[", 
           RowBox[{"1", ",", "2", ",", "w"}], "]"}]}]}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"n\[CapitalSigma]r", "=", 
      RowBox[{"n\[CapitalSigma]T", "-", "n\[CapitalSigma]l"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"n\[CapitalSigma]a", " ", "=", " ", 
      RowBox[{"ConjugateTranspose", "[", "n\[CapitalSigma]r", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nGr", "=", 
      RowBox[{"Inverse", "[", 
       RowBox[{"A", "-", "n\[CapitalSigma]r"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nGa", " ", "=", " ", 
      RowBox[{"ConjugateTranspose", "[", "nGr", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nGlfirstterm", "=", 
      RowBox[{"nGr", ".", "n\[CapitalSigma]l", ".", "nGa"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"one", " ", "=", " ", 
      RowBox[{"IdentityMatrix", "[", "Nmax", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nGlsecondterm", " ", "=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"one", " ", "+", " ", 
         RowBox[{"nGr", ".", "n\[CapitalSigma]r"}]}], ")"}], ".", "Gl", ".", 
       RowBox[{"(", 
        RowBox[{"one", " ", "+", " ", 
         RowBox[{"n\[CapitalSigma]a", ".", "nGa"}]}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nGl", " ", "=", " ", 
      RowBox[{"nGlfirstterm", " ", "+", " ", "nGlsecondterm"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"QL", " ", "=", "  ", 
      RowBox[{
       RowBox[{"k1", "^", "2"}], "*", 
       RowBox[{"(", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"nGr", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1"}], "]"}], "]"}], "*", 
          RowBox[{"gl", "[", 
           RowBox[{"w", ",", "k1", ",", "k1onsite", ",", "T1"}], "]"}]}], " ",
          "+", " ", 
         RowBox[{
          RowBox[{"nGl", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1"}], "]"}], "]"}], "*", 
          RowBox[{"Conjugate", "[", 
           RowBox[{"g", "[", 
            RowBox[{"w", ",", "k1", ",", " ", "k1onsite"}], "]"}], "]"}]}]}], 
        "  ", ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"QR", "=", " ", 
      RowBox[{
       RowBox[{"k2", "^", "2"}], "*", 
       RowBox[{"(", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"nGr", "[", 
           RowBox[{"[", 
            RowBox[{"Nmax", ",", "Nmax"}], "]"}], "]"}], "*", 
          RowBox[{"gl", "[", 
           RowBox[{"w", ",", "k2", ",", "k2onsite", ",", "T2"}], "]"}]}], " ",
          "+", " ", 
         RowBox[{
          RowBox[{"nGl", "[", 
           RowBox[{"[", 
            RowBox[{"Nmax", ",", "Nmax"}], "]"}], "]"}], "*", 
          RowBox[{"Conjugate", "[", 
           RowBox[{"g", "[", 
            RowBox[{"w", ",", "k2", ",", " ", "k2onsite"}], "]"}], "]"}]}]}], 
        "  ", ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{"QL", "-", "QR"}], ")"}]}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"fB", "[", 
         RowBox[{"w", ",", "T1"}], "]"}], "-", 
        RowBox[{"fB", "[", 
         RowBox[{"w", ",", "T2"}], "]"}]}], ")"}]}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input"],

Cell[CellGroupData[{

