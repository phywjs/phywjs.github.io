Cell[TextData[{
 "We give here other type of Green's functions, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["G", "A"], "="}], TraditionalForm]]],
 " Hermitian conjugate of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["G", "R"], TraditionalForm]]],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["G", 
     RowBox[{"<", " "}]], "=", " ", 
    RowBox[{
     SuperscriptBox["G", "R"], 
     SuperscriptBox["\[CapitalSigma]", "<"], 
     SuperscriptBox["G", "A"]}]}], TraditionalForm]]],
 ".  This equation is true only because of the free leads.  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalSigma]", "<"], "=", 
    RowBox[{
     SuperscriptBox["\[CapitalSigma]", 
      RowBox[{"L", "<"}]], "+", 
     SuperscriptBox["\[CapitalSigma]", 
      RowBox[{"R", "<"}]]}]}], TraditionalForm]]],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalSigma]", 
     RowBox[{"L", "<"}]], "=", 
    RowBox[{
     SuperscriptBox["V", "CL"], 
     SuperscriptBox["g", 
      RowBox[{"L", "<"}]], 
     SuperscriptBox["V", "LC"]}]}], TraditionalForm]]],
 ", similarly for the right lead.   We use G[\[Sigma],\[Sigma]'] to denote ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["G", 
    RowBox[{"\[Sigma]\[Sigma]", "'"}]], TraditionalForm]]],
 " where \[Sigma] = \[PlusMinus]1 (but 1 for + and 2 for ",
 Cell[BoxData[
  FormBox["-", TraditionalForm]]],
 " in program) , Note that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["G", "++"], "=", 
     SuperscriptBox["G", "T"]}], ","}], TraditionalForm]]],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["G", 
     RowBox[{"+", "-"}]], "=", 
    SuperscriptBox["G", "<"]}], TraditionalForm]]],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["G", 
     RowBox[{"-", "+"}]], "=", 
    SuperscriptBox["G", ">"]}], TraditionalForm]]],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["G", "--"], "=", 
    SuperscriptBox["G", 
     OverscriptBox["T", "_"]]}], TraditionalForm]]],
 ".  The ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["G", 
    RowBox[{"\[Sigma]\[Sigma]", "'"}]], TraditionalForm]]],
 "[\[Omega]] will be used in the integrand for the nonlinear self-energy.  \
MakeGlist[ ] generates a list of green functions stored in Glist. \[Omega]Max \
is the max range, nMax is number of points used. Glist and iMaxglobal etc are \
globals. "
}], "Text",
 CellChangeTimes->{{3.407723618766697*^9, 3.407723621016697*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"makeGlistSymmetrize", "[", 
    RowBox[{"\[Omega]Max_", ",", " ", "nMax_Integer"}], "]"}], ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"w", ",", "Gp", ",", "Gm"}], "}"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{"dwglobal", " ", "=", " ", 
       RowBox[{"2.0", "*", 
        RowBox[{"\[Omega]Max", "/", 
         RowBox[{"(", 
          RowBox[{"nMax", "-", "1"}], ")"}]}]}]}], ";", "\[IndentingNewLine]",
       
      RowBox[{"Glist", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"w", "=", 
         RowBox[{"-", "\[Omega]Max"}]}], ",", 
        RowBox[{"w", "\[LessEqual]", "\[Omega]Max"}], ",", " ", 
        RowBox[{"w", " ", "+=", " ", "dwglobal"}], ",", "\[IndentingNewLine]",
         
        RowBox[{
         RowBox[{"Gp", " ", "=", " ", 
          RowBox[{"Garray", "[", "w", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"Gm", " ", "=", " ", 
          RowBox[{"Garray", "[", 
           RowBox[{"-", "w"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"Glist", " ", "=", " ", 
          RowBox[{"Glist", " ", "~", "Join", " ", "~", " ", 
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", " ", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"Gp", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "1"}], "]"}], "]"}], "+", 
                   RowBox[{"Transpose", "[", 
                    RowBox[{"Gm", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}]}], ")"}], 
                 "/", "2"}], ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"Gp", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], "+", 
                   RowBox[{"Transpose", "[", 
                    RowBox[{"Gm", "[", 
                    RowBox[{"[", 
                    RowBox[{"2", ",", "1"}], "]"}], "]"}], "]"}]}], ")"}], 
                 "/", "2"}]}], "}"}], ",", "\[IndentingNewLine]", 
              RowBox[{"{", " ", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"Gp", "[", 
                    RowBox[{"[", 
                    RowBox[{"2", ",", "1"}], "]"}], "]"}], "+", 
                   RowBox[{"Transpose", "[", 
                    RowBox[{"Gm", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], "]"}]}], ")"}], 
                 "/", "2"}], ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"Gp", "[", 
                    RowBox[{"[", 
                    RowBox[{"2", ",", "2"}], "]"}], "]"}], "+", 
                   RowBox[{"Transpose", "[", 
                    RowBox[{"Gm", "[", 
                    RowBox[{"[", 
                    RowBox[{"2", ",", "2"}], "]"}], "]"}], "]"}]}], ")"}], 
                 "/", "2"}]}], "}"}]}], "}"}], "}"}]}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"iMaxglobal", " ", "=", " ", 
       RowBox[{"Length", "[", "Glist", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"wMaxglobal", " ", "=", " ", "\[Omega]Max"}], ";"}]}], 
    "\[IndentingNewLine]", "]"}]}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"wToi", "[", "\[Omega]_Real", "]"}], ":=", 
   RowBox[{"Round", "[", " ", 
    RowBox[{"1.0", " ", "+", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"\[Omega]", " ", "+", " ", "wMaxglobal"}], ")"}], "*", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"iMaxglobal", " ", "-", " ", "1"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"2.0", "*", "wMaxglobal"}], ")"}]}]}]}], "]"}]}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"Garray", "[", "w_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"Gr", ",", "Ga", ",", "Gl", ",", "\[CapitalSigma]l"}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Gr", "=", 
      RowBox[{"computeGr", "[", "w", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Ga", "=", 
      RowBox[{"ConjugateTranspose", "[", "Gr", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[CapitalSigma]l", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"0", ",", 
        RowBox[{"{", "Nmax", "}"}], ",", 
        RowBox[{"{", "Nmax", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[CapitalSigma]l", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "1"}], "]"}], "]"}], "=", " ", 
      RowBox[{
       RowBox[{"k1", "^", "2"}], "*", 
       RowBox[{"gl", "[", 
        RowBox[{"w", ",", "k1", ",", "k1onsite", ",", "T1"}], "]"}]}]}], ";", 
     " ", 
     RowBox[{
      RowBox[{"\[CapitalSigma]l", "[", 
       RowBox[{"[", 
        RowBox[{"Nmax", ",", "Nmax"}], "]"}], "]"}], "=", " ", 
      RowBox[{
       RowBox[{"k2", "^", "2"}], "*", 
       RowBox[{"gl", "[", 
        RowBox[{"w", ",", "k2", ",", "k2onsite", ",", "T2"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Gl", " ", "=", "  ", 
      RowBox[{
      "Gr", " ", ".", " ", "\[CapitalSigma]l", " ", ".", " ", "Ga"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Gl", "+", "Gr"}], ",", " ", "Gl"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Gr", "-", "Ga", "+", "Gl"}], ",", " ", 
         RowBox[{"Gl", "-", "Ga"}]}], "}"}]}], "}"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]}], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"General", "::", "\<\"spell1\"\>"}], 
  RowBox[{
  ":", " "}], "\<\"Possible spelling error: new symbol name \
\\\"\\!\\(Glist\\)\\\" is similar to existing symbol \\\"\\!\\(Tlist\\)\\\". \
\\!\\(\\*ButtonBox[\\\"More\[Ellipsis]\\\", ButtonStyle->\\\"RefGuideLinkText\
\\\", ButtonFrame->None, ButtonData:>\\\"General::spell1\\\"]\\)\"\>"}]], \
"Message"],

Cell[BoxData[
 RowBox[{
  RowBox[{"General", "::", "\<\"spell1\"\>"}], 
  RowBox[{
  ":", " "}], "\<\"Possible spelling error: new symbol name \
\\\"\\!\\(wMaxglobal\\)\\\" is similar to existing symbol \
\\\"\\!\\(iMaxglobal\\)\\\". \\!\\(\\*ButtonBox[\\\"More\[Ellipsis]\\\", \
ButtonStyle->\\\"RefGuideLinkText\\\", ButtonFrame->None, \
ButtonData:>\\\"General::spell1\\\"]\\)\"\>"}]], "Message"]
}, Open  ]],

Cell[TextData[{
 "getG[i,s,sp,j,k] returns the value of green function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     SubscriptBox["G", "jk"], 
     RowBox[{"\[Sigma]", " ", 
      RowBox[{"\[Sigma]", "'"}]}]], "[", "\[Omega]", "]"}], 
   TraditionalForm]]],
 " from the table Glist.  Note that index s varies from 1 to 2, 1 for \
\[Sigma]=+, and 2 for \[Sigma]= ",
 Cell[BoxData[
  FormBox["-", TraditionalForm]]],
 ".   However, we'll let \[Sigma] and \[Sigma]p to run from 1 to 2 as well in \
the program. The mapping from frequency \[Omega] to index i is according to \
makeGlist[ ] defined in wToi[ ].  value outside the range -\[Omega]Max to +\
\[Omega]Max is set to zero (corresponding to index i from 1 to iMaxglobal).   \
There is one important symmetry property in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["G", 
     RowBox[{"\[Sigma]\[Sigma]", "'"}]], "[", "\[Omega]", "]"}], 
   TraditionalForm]]],
 ", that is\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox[
      SubscriptBox["G", "jk"], 
      RowBox[{"\[Sigma]\[Sigma]", "'"}]], "[", "\[Omega]", "]"}], "="}], 
   TraditionalForm]]],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     SubscriptBox["G", "kj"], 
     RowBox[{
      RowBox[{"\[Sigma]", "'"}], "\[Sigma]"}]], "[", 
    RowBox[{"-", "\[Omega]"}], "]"}], TraditionalForm]]],
 ",  \[Eta] \[RightArrow] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["0", "+"], TraditionalForm]]],
 ".\nThis is used because it makes the result more accurate."
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"getG", "[", 
   RowBox[{
   "i_Integer", ",", " ", "s_Integer", ",", "sp_Integer", ",", " ", 
    "j_Integer", ",", " ", "k_Integer"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"i", " ", "\[LessEqual]", "0"}], " ", "||", " ", 
        RowBox[{"i", " ", ">", " ", "iMaxglobal"}]}], ",", " ", 
       RowBox[{"Return", " ", "[", "0.0", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Glist", "[", 
      RowBox[{"[", 
       RowBox[{"i", ",", "s", ",", "sp", ",", "j", ",", "k"}], "]"}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}], " "}]], "Input"],

Cell["\<\
Generate table,  parameters can be changed.  Must re-run makeGlist after \
changing parameters.  \
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"makeGlistSymmetrize", "[", 
    RowBox[{"20.5", ",", "1000"}], "]"}], ";"}], " "}]], "Input"],

Cell[BoxData[
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Re", "[", 
      RowBox[{"getG", "[", 
       RowBox[{"i", ",", "1", ",", "1", ",", "1", ",", "1"}], "]"}], "]"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "2000"}], "}"}]}], "]"}], ",", 
   RowBox[{"Joined", "\[Rule]", "True"}], ",", 
