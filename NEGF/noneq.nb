Cell[CellGroupData[{

Cell["Eigenvalues of transfer matrix method", "Section"],

Cell[TextData[{
 "Check the result of Zhang & Xiong, PRB 72 (2005) 115305.   They claim that \
the transmission from mode ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 "  is given by  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["T", "n"], "=", 
    RowBox[{
     RowBox[{"1", "/", 
      SuperscriptBox["cosh", "2"]}], 
     SubscriptBox["x", "n"]}]}], TraditionalForm]]],
 ",  where 2",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "n"], TraditionalForm]]],
 " is log eigenvalue of the transfer matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{"M", " ", 
    SuperscriptBox["M", "\[Dagger]"]}], TraditionalForm]]],
 ".  The relevant theory is discussed in CWJ Beenakker, Rev Mod Phys 69 \
(1997) 731, section C1. It seems to me that the theory need to be modified \
when there is mode-mixing (that is ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["t", 
    RowBox[{"nn", "'"}]], TraditionalForm]]],
 " is not diagonal). General transfer matrix from coupling k to kp, site 0, 1 \
to 1, 2 (mass ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "=", "1"}], TraditionalForm]]],
 ") is P[w,kp,k].  Notice that the last argument k is on the left, kp on the \
right.    The transfP makes product of P according to the model."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "w", ",", "P", ",", "p2mL", ",", "p2mR", ",", " ", "nlead", ",", " ", 
    "transfP", ",", " ", "M", ",", " ", "m2eig", ",", "vRhalf", ",", " ", 
    "vLhalfinv", ",", "Tn", ",", " ", "kL", ",", "kR", ",", "xL", ",", "xR"}],
    "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"P", "[", 
    RowBox[{"w_", ",", "kp_", ",", "k_"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"w", "^", "2"}]}], "+", "k", "+", "kp"}], ")"}], "/", 
        "kp"}], ",", " ", 
       RowBox[{
        RowBox[{"-", "k"}], "/", "kp"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "0"}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"xL", "=", " ", 
   RowBox[{"1", "-", 
    RowBox[{
     RowBox[{"w", "^", "2"}], "/", 
     RowBox[{"(", 
      RowBox[{"2", "*", "k1"}], ")"}]}], "+", 
    RowBox[{"I", "*", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"w", "^", "2"}], "/", "k1"}], "-", 
       RowBox[{
        RowBox[{"w", "^", "4"}], "/", 
        RowBox[{"(", 
         RowBox[{"4", "*", 
          RowBox[{"k1", "^", "2"}]}], ")"}]}]}], "]"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xR", "=", " ", 
   RowBox[{"1", "-", 
    RowBox[{
     RowBox[{"w", "^", "2"}], "/", 
     RowBox[{"(", 
      RowBox[{"2", "*", "k2"}], ")"}]}], "+", 
    RowBox[{"I", "*", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"w", "^", "2"}], "/", "k2"}], "-", 
       RowBox[{
        RowBox[{"w", "^", "4"}], "/", 
        RowBox[{"(", 
         RowBox[{"4", "*", 
          RowBox[{"k2", "^", "2"}]}], ")"}]}]}], "]"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p2mL", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"xL", ",", " ", 
       RowBox[{"1", "/", "xL"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"p2mR", " ", "=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"xR", ",", " ", 
      RowBox[{"1", "/", "xR"}]}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}]}], "Input",
 CellChangeTimes->{{3.407647222194603*^9, 3.4076472326927214`*^9}, {
  3.407725032996237*^9, 3.4077250361522846`*^9}, {3.407725364431573*^9, 
  3.4077253733219132`*^9}}],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"1", "-", 
      RowBox[{"0.25`", " ", 
       SuperscriptBox["w", "2"]}], "+", 
      RowBox[{"\[ImaginaryI]", " ", 
       SqrtBox[
        RowBox[{
         RowBox[{"0.5`", " ", 
          SuperscriptBox["w", "2"]}], "-", 
         RowBox[{"0.0625`", " ", 
          SuperscriptBox["w", "4"]}]}]]}]}], ",", 
     FractionBox["1", 
      RowBox[{"1", "-", 
       RowBox[{"0.25`", " ", 
        SuperscriptBox["w", "2"]}], "+", 
       RowBox[{"\[ImaginaryI]", " ", 
        SqrtBox[
         RowBox[{
          RowBox[{"0.5`", " ", 
           SuperscriptBox["w", "2"]}], "-", 
          RowBox[{"0.0625`", " ", 
           SuperscriptBox["w", "4"]}]}]]}]}]]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.407724470047947*^9, 3.4077250583852367`*^9, 
  3.407725843589946*^9, 3.4077285492578754`*^9, 3.407728994864398*^9, 
  3.4077293118154945`*^9, 3.4077319726422153`*^9, 3.407732252984171*^9}]
}, Open  ]],

Cell[TextData[{
 "Unlike the other two methods, which is exact, here we must consider ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FormBox[
     UnderscriptBox["lim", 
      RowBox[{"n", "\[RightArrow]", "\[Infinity]"}]],
     TraditionalForm], 
    RowBox[{
     SuperscriptBox[
      SubscriptBox["P", "L"], "n"], 
     SubscriptBox["P", "c"], 
     SuperscriptBox[
      SubscriptBox["P", "R"], "n"]}]}], TraditionalForm]]],
 ", where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "L"], TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "R"], TraditionalForm]]],
 "  are the transfer matrices for the left and right lead, and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "C"], TraditionalForm]]],
 " is for the center part.  It turns out that limit is needed only in the \
frequency gap, and it converges very fast.    nlead is the number of n to use \
for the lead. \nThe most critical part of this calculation is a \
transformation from the transform matrix P, defined by the displacement ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["u", 
         RowBox[{"k", "+", "1"}]], ",", 
        SubscriptBox["u", "k"]}], ")"}], "T"], "=", 
     RowBox[{"P", "(", 
      RowBox[{
       SubscriptBox["u", "1"], ",", " ", 
       SubscriptBox["u", "0"]}], ")"}]}], ","}], TraditionalForm]]],
 "  transformation M, defined by the amplitudes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["a", "+"], ",", " ", 
    RowBox[{
     SuperscriptBox["a", "-"], ".", " "}]}], TraditionalForm]]],
 "  See the Rev Mod Phys paper for detail.  For this problem, the \
transformation is,   Tau = inverse[p2mR] . P . p2mL.  Tau need further \
transformed by multiplying square roots of group velocities to get M. \n\nThe \
program is not correct when two leads are different.  How to modified to make \
it work?"
}], "Text",
 CellChangeTimes->{{3.407724510235447*^9, 3.407724553563572*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nlead", " ", "=", " ", "6"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kL", " ", "=", "k1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kR", "=", "k2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"transfP", "[", "n_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "mt", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"mt", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", " ", 
         RowBox[{"i", "<=", 
          RowBox[{"n", "/", "2"}]}], ",", " ", 
         RowBox[{"++", "i"}], ",", " ", "\[IndentingNewLine]", 
         RowBox[{"mt", " ", "=", " ", 
          RowBox[{
           RowBox[{"P", "[", 
            RowBox[{"w", ",", "k1", ",", "k1"}], "]"}], ".", "mt"}]}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"mt", " ", "=", " ", 
        RowBox[{
         RowBox[{"P", "[", 
          RowBox[{"w", ",", "kC", ",", "kL"}], "]"}], ".", 
         RowBox[{"P", "[", 
          RowBox[{"w", ",", "kL", ",", "k1"}], "]"}], ".", "mt"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", 
         RowBox[{"i", "<=", 
          RowBox[{"Nmax", "-", "2"}]}], ",", 
         RowBox[{"++", "i"}], ",", " ", "\[IndentingNewLine]", 
         RowBox[{"mt", "=", 
          RowBox[{
           RowBox[{"P", "[", 
            RowBox[{"w", ",", "kC", ",", "kC"}], "]"}], ".", "mt"}]}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"mt", "=", 
        RowBox[{
         RowBox[{"P", "[", 
          RowBox[{"w", ",", "k2", ",", "kR"}], "]"}], ".", 
         RowBox[{"P", "[", 
          RowBox[{"w", ",", "kR", ",", "kC"}], "]"}], ".", "mt"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", " ", 
         RowBox[{"i", "<=", 
          RowBox[{"n", "/", "2"}]}], ",", " ", 
         RowBox[{"++", "i"}], ",", " ", "\[IndentingNewLine]", 
         RowBox[{"mt", " ", "=", " ", 
          RowBox[{
           RowBox[{"P", "[", 
            RowBox[{"w", ",", "k2", ",", "k2"}], "]"}], ".", "mt"}]}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", "mt"}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vRhalf", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"k2", "*", "I", "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"1", "/", "xR"}], "-", "xR"}], ")"}]}], "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", "*", "w"}], ")"}]}], ",", "0"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"k2", "*", "I", "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"1", "/", "xR"}], "-", "xR"}], ")"}]}], "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", "*", "w"}], ")"}]}]}], "}"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"vLhalfinv", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Sqrt", "[", 
            RowBox[{"k1", "*", "I", "*", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"1", "/", "xL"}], "-", "xL"}], ")"}]}], "]"}], "/", 
           RowBox[{"(", 
            RowBox[{"2", "*", "w"}], ")"}]}], ")"}]}], ",", "0"}], "}"}], ",",
       " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"1", "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Sqrt", "[", 
            RowBox[{"k1", "*", "I", "*", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"1", "/", "xL"}], "-", "xL"}], ")"}]}], "]"}], "/", 
           RowBox[{"(", 
            RowBox[{"2", "*", "w"}], ")"}]}], ")"}]}]}], "}"}]}], "}"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"M", "[", "n_", "]"}], "=", " ", 
   RowBox[{"vRhalf", ".", 
    RowBox[{"Inverse", "[", "p2mR", "]"}], ".", 
    RowBox[{"transfP", "[", "n", "]"}], ".", "p2mL", ".", "vLhalfinv"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"m2eig", "=", 
   RowBox[{"Eigenvalues", "[", 
    RowBox[{
     RowBox[{"M", "[", "nlead", "]"}], ".", 
     RowBox[{"ConjugateTranspose", "[", 
      RowBox[{"M", "[", "nlead", "]"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Tn", "[", "w_", "]"}], "=", 
   RowBox[{"1", "/", 
    RowBox[{
     RowBox[{"Cosh", "[", 
      RowBox[{"0.5", "*", 
       RowBox[{"Log", "[", 
        RowBox[{"Abs", "[", "m2eig", "]"}], "]"}]}], "]"}], "^", "2"}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.4076466365800533`*^9, 3.4076466375331845`*^9}, {
  3.407646703549232*^9, 3.4076467710652895`*^9}, {3.407724579657322*^9, 
  3.407724581329197*^9}, {3.407724704829197*^9, 3.407724919641697*^9}, {
  3.4077253391667566`*^9, 3.4077253482133417`*^9}, {3.407725421992231*^9, 
  3.40772542233597*^9}, {3.407728846802846*^9, 3.407728861302753*^9}, {
  3.407728935067906*^9, 3.4077289441615973`*^9}, {3.4077291380978565`*^9, 
  3.4077291634101944`*^9}, {3.4077292132692504`*^9, 3.4077292352534847`*^9}, {
  3.407731728659402*^9, 3.4077317917683725`*^9}, {3.407731855642964*^9, 
  3.4077318592679405`*^9}, {3.407731895720833*^9, 3.4077319002208037`*^9}, {
  3.4077321129069424`*^9, 3.4077321389849005`*^9}, {3.4077323708271666`*^9, 
  3.4077323710146656`*^9}, {3.407732426623685*^9, 3.407732426811184*^9}, {
  3.4077324783733535`*^9, 3.4077324799514685`*^9}}],

