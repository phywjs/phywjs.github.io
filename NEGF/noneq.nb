Cell[BoxData[{
 RowBox[{
  RowBox[{"transdata", " ", "=", " ", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"w", " ", "=", " ", "0.05"}], ",", " ", 
   RowBox[{"w", " ", "\[LessEqual]", " ", "3.21"}], ",", " ", 
   RowBox[{"w", " ", "+=", " ", "0.05"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"d", " ", "=", " ", 
     RowBox[{"transmission", "[", "w", "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<w=\>\"", ",", " ", "w", ",", " ", "\"\<  d = \>\"", ",", " ", "d"}],
      "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"transdata", " ", "=", " ", 
     RowBox[{"transdata", " ", "~", "Join", "~", " ", 
      RowBox[{"{", " ", 
       RowBox[{"{", 
        RowBox[{"w", ",", "d"}], "}"}], "}"}]}]}]}]}], "\[IndentingNewLine]", 
  "]"}]}], "Input",
 CellChangeTimes->{{3.407724093626072*^9, 3.407724097485447*^9}}],

Cell[TextData[{
 "The kappa[ ] compute the conductance, defined by \[Kappa] = J/\
\[CapitalDelta]T.  J is computed according to Landauer formua:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", 
     RowBox[{"2", "\[Pi]"}]], 
    RowBox[{
     SubsuperscriptBox["\[Integral]", "0", "\[Infinity]"], 
     RowBox[{"\:f7d8", " ", "\[Omega]", " ", 
      RowBox[{"Trans", "[", "\[Omega]", "]"}], 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["f", "L"], "-", 
        SubscriptBox["f", "R"]}], ")"}], 
      RowBox[{"\[DifferentialD]", "\[Omega]"}]}]}]}], TraditionalForm]]],
 ".  The imaginary part is supposedly 0. "
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"kappa", "[", "tr_List", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"len", ",", "w", ",", "val", ",", "i"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"len", " ", "=", " ", 
      RowBox[{"Length", "[", "tr", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"val", " ", "=", " ", "0.0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", " ", "=", " ", "1"}], ",", " ", 
       RowBox[{"i", " ", "<", " ", "len"}], ",", " ", 
       RowBox[{"++", "i"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"w", " ", "=", " ", 
         RowBox[{"tr", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"val", " ", "+=", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"tr", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"i", "+", "1"}], ",", "1"}], "]"}], "]"}], "-", "w"}], 
           ")"}], " ", "*", " ", "w", "*", " ", 
          RowBox[{"Re", "[", 
           RowBox[{"tr", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "2"}], "]"}], "]"}], "]"}], "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"fB", "[", 
             RowBox[{"w", ",", "T1"}], "]"}], "-", 
            RowBox[{"fB", "[", 
             RowBox[{"w", ",", "T2"}], "]"}]}], ")"}]}]}], ";"}]}], " ", 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"cof3", "*", 
      RowBox[{
       RowBox[{"val", "/", 
        RowBox[{"(", 
         RowBox[{"2.0", "*", "Pi"}], ")"}]}], "/", 
       RowBox[{"(", 
        RowBox[{"T1", "-", "T2"}], ")"}]}]}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input"],

Cell[TextData[{
 "Some checking that can be done: (1) If there is no nonlinearity, t=0, and \
k1=k2=kC, and T1=T2, k1onsite=k2onsite=0,  then the retarded green function \
is given exactly by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["G", "jk"], "=", 
    RowBox[{"A", " ", 
     SuperscriptBox["e", 
      RowBox[{"iq", "|", 
       RowBox[{"j", "-", "k"}], "|"}]]}]}], TraditionalForm]]],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"A", "=", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"2", "ik", " ", "sin", " ", "q"}], ")"}]}]}], ","}], 
   TraditionalForm]]],
 "  We can write as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["G", "jk"], "=", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "k"}], " ", 
        RowBox[{"g", "[", "\[Omega]", "]"}]}], ")"}], 
      RowBox[{"|", 
       RowBox[{"j", "-", "k"}], "|"}]], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"k", "^", "2"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"1", "/", 
          RowBox[{"g", "[", "\[Omega]", "]"}]}], "-", 
         RowBox[{"g", "[", "\[Omega]", "]"}]}], ")"}]}], ")"}]}]}], 
   TraditionalForm]]],
 ".  Note that ",
 Cell[BoxData[
  FormBox["q", TraditionalForm]]],
 " can be complex when \[Omega] is in the gap.   \n\n(2) for the same \
condition, we have two expressions for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["Gn", "<"], ":"}], TraditionalForm]]],
 "  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["Gn", "<"], "=", 
    RowBox[{
     SuperscriptBox["Gn", "R"], 
     SuperscriptBox["\[CapitalSigma]n", "<"], 
     SuperscriptBox["Gn", "A"]}]}], TraditionalForm]]],
 ", (that is nGl), and  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FormBox[
     SuperscriptBox["Gn", "<"],
     TraditionalForm], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["Gn", "R"], "-", 
       SuperscriptBox["Gn", "A"]}], ")"}], 
     RowBox[{
      SubscriptBox["f", "B"], "[", "\[Omega]", "]"}]}]}], TraditionalForm]]],
 "; they should be equal."
}], "Text"],

Cell[TextData[{
 "(3) If t=0, k and T1, T2 arbitrary, we can check against Caroli expression. \
 Mingo's equation for ",
 Cell[BoxData[
  FormBox["T", TraditionalForm]]],
 " is equivalent to Caroli expression ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"T", "[", "\[Omega]", "]"}], "=", 
    RowBox[{"Tr", "[", " ", 
     RowBox[{
      SubscriptBox["\[CapitalGamma]", 
       RowBox[{"R", " "}]], 
      SuperscriptBox["G", "r"], 
      SubscriptBox["\[CapitalGamma]", "L"], 
      SuperscriptBox["G", "a"]}], "]"}]}], TraditionalForm]]],
 ".   Notice that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"G", "=", 
    RowBox[{
     SuperscriptBox["G", "r"], "=", 
     SuperscriptBox[
      RowBox[{"[", 
       SuperscriptBox["G", "a"], "]"}], "*"]}]}], TraditionalForm]]],
 ".  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalGamma]", "L"], "=", 
    RowBox[{"i", " ", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[CapitalSigma]", "L"], " ", "-", " ", 
       SuperscriptBox[
        SubscriptBox["\[CapitalSigma]", "L"], "*"]}], ")"}]}]}], 
   TraditionalForm]]],
 ",  that is, the imaginary part of self-energy.  Only one element in \
\[CapitalGamma] is nonzero for this model. \n\n(4) When ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "\[NotEqual]"}], TraditionalForm]]],
 "0, we don't have an effective method to check!"
}], "Text"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Caroli or Mingo formula", "Section",
 CellChangeTimes->{{3.407724150329197*^9, 3.407724157891697*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Tmingo", "[", "w_", "]"}], ":=", 
   RowBox[{"4", "*", 
    RowBox[{"k1", "^", "2"}], "*", 
    RowBox[{"k2", "^", "2"}], "*", 
    RowBox[{"Im", "[", 
     RowBox[{"g", "[", 
      RowBox[{"w", ",", "k1", ",", "k1onsite"}], "]"}], "]"}], "*", 
    RowBox[{"Im", "[", 
     RowBox[{"g", "[", 
      RowBox[{"w", ",", "k2", ",", "k2onsite"}], "]"}], "]"}], " ", "*", 
    RowBox[{"Conjugate", "[", 
     RowBox[{
      RowBox[{"computeGr", "[", "w", "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "Nmax"}], "]"}], "]"}], "]"}], "*", 
    RowBox[{
     RowBox[{"computeGr", "[", "w", "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"1", ",", "Nmax"}], "]"}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.407724256954197*^9, 3.407724265407322*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Tmingo", "[", "w", "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"w", ",", "0.00001", ",", "3.5"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.407724300907322*^9, 3.407724319172947*^9}}],

