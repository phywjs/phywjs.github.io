    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "10"}], ",", "2"}], "}"}]}]}], "]"}]], "Input"],

Cell[TextData[{
 "We now compute the self-energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalSigma]", 
     RowBox[{"\[Sigma]\[Sigma]", "'"}]], "[", "\[Omega]", "]"}], 
   TraditionalForm]]],
 " due to the nonlinear contribution.  To lowest order, there are two graphs: \
a loop graph \[CapitalSigma]1 and a balloon graph \[CapitalSigma]2, which \
give the following formula: \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["\[CapitalSigma]n", "jk", 
      RowBox[{"\[Sigma]\[Sigma]", "'"}]], "[", "\[Omega]", "]"}], "=", 
    RowBox[{
     RowBox[{"2", "i", " ", 
      RowBox[{
       UnderscriptBox["\[Sum]", "lmrs"], 
       RowBox[{
        SubsuperscriptBox["\[Integral]", 
         RowBox[{"-", "\[Infinity]"}], 
         RowBox[{"+", "\[Infinity]"}]], " ", 
        RowBox[{
         SubscriptBox["T", "jlm"], 
         SubscriptBox["T", "rsk"], 
         RowBox[{
          SubsuperscriptBox["Gn", "lr", 
           RowBox[{"\[Sigma]\[Sigma]", "'"}]], "[", 
          RowBox[{"\[Omega]", "'"}], "]"}], 
         RowBox[{
          SubsuperscriptBox["Gn", "ms", 
           RowBox[{"\[Sigma]\[Sigma]", "'"}]], "[", 
          RowBox[{"\[Omega]", "-", 
           RowBox[{"\[Omega]", "'"}]}], "]"}], 
         RowBox[{"\[DifferentialD]", 
          FractionBox[
           RowBox[{"\[Omega]", "'"}], 
           RowBox[{"2", "\[Pi]"}]]}]}]}]}]}], " ", "+", " ", 
     RowBox[{"2", "i", " ", "\[Sigma]", " ", 
      SubscriptBox["\[Delta]", 
       RowBox[{"\[Sigma]\[Sigma]", "'"}]], 
      RowBox[{
       UnderscriptBox["\[Sum]", "lmrs"], 
       RowBox[{
        UnderscriptBox["\[Sum]", 
         RowBox[{"\[Sigma]", "''"}]], 
        RowBox[{
         RowBox[{"\[Sigma]", "''"}], 
         RowBox[{
          SubsuperscriptBox["\[Integral]", 
           RowBox[{"-", "\[Infinity]"}], 
           RowBox[{"+", "\[Infinity]"}]], " ", 
          RowBox[{
           SubscriptBox["T", "jkl"], 
           SubscriptBox["T", "mrs"], 
           RowBox[{
            SubsuperscriptBox["Gn", "lm", 
             RowBox[{"\[Sigma]\[Sigma]", "''"}]], "[", "0", "]"}], 
           RowBox[{
            SubsuperscriptBox["Gn", "rs", 
             RowBox[{
              RowBox[{"\[Sigma]", "''"}], 
              RowBox[{"\[Sigma]", "''"}]}]], "[", 
            RowBox[{"\[Omega]", "'"}], "]"}], 
           RowBox[{
            RowBox[{"\[DifferentialD]", 
             FractionBox[
              RowBox[{"\[Omega]", "'"}], 
              RowBox[{"2", "\[Pi]"}]]}], "."}]}]}]}]}]}]}]}]}], 
   TraditionalForm]]],
 "\nThe second term comes from the thermal expansion contribution.  It is \
independent of \[Omega].   The Feynman diagram code for G (not \
\[CapitalSigma]) is appended at the end of this program.  The formula (3-2s) \
maps 1 and 2 to +1, and -1, respectively (for \[Sigma]'').   The second term \
is always real. "
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalSigma]nf1", "[", 
     RowBox[{
     "\[Sigma]_Integer", ",", "\[Sigma]p_Integer", ",", " ", 
      "\[Omega]_Real"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "res", ",", "i", ",", "ip", ",", "i0", ",", "j", ",", "k", ",", "l", 
        ",", "m", ",", "r", ",", "s", ",", "Y"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"res", " ", "=", " ", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"{", "Nmax", "}"}], ",", 
          RowBox[{"{", "Nmax", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"i", " ", "=", " ", 
        RowBox[{"wToi", "[", "\[Omega]", "]"}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"i0", "=", 
        RowBox[{"wToi", "[", "0.0", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"t", " ", "\[Equal]", " ", "0"}], ",", " ", 
         RowBox[{"Return", "[", "res", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"l", "=", "1"}], ",", " ", 
         RowBox[{"l", " ", "\[LessEqual]", " ", "Nmax"}], ",", " ", 
         RowBox[{"++", "l"}], ",", "\[IndentingNewLine]", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"m", "=", "1"}], ",", 
           RowBox[{"m", "\[LessEqual]", " ", "Nmax"}], ",", 
           RowBox[{"++", "m"}], ",", "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"r", "=", "1"}], ",", " ", 
             RowBox[{"r", "\[LessEqual]", " ", "Nmax"}], ",", " ", 
             RowBox[{"++", "r"}], ",", "\[IndentingNewLine]", 
             RowBox[{"For", "[", 
              RowBox[{
               RowBox[{"s", "=", "1"}], ",", " ", 
               RowBox[{"s", " ", "\[LessEqual]", " ", "Nmax"}], ",", " ", 
               RowBox[{"++", "s"}], ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Y", "=", 
                 RowBox[{"dwglobal", " ", "*", 
                  RowBox[{"Sum", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"getG", "[", 
                    RowBox[{
                    "ip", ",", "\[Sigma]", ",", "\[Sigma]p", ",", "l", ",", 
                    "r"}], "]"}], "*", 
                    RowBox[{"getG", "[", 
                    RowBox[{
                    RowBox[{"i0", "+", "i", "-", "ip"}], ",", "\[Sigma]", ",",
                     "\[Sigma]p", ",", "m", ",", "s"}], "]"}]}], ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"ip", ",", " ", "1", ",", " ", "iMaxglobal"}], 
                    "}"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
                RowBox[{"For", "[", 
                 RowBox[{
                  RowBox[{"j", "=", "1"}], ",", " ", 
                  RowBox[{"j", "\[LessEqual]", " ", "Nmax"}], ",", 
                  RowBox[{"++", "j"}], ",", "\[IndentingNewLine]", 
                  RowBox[{"For", "[", 
                   RowBox[{
                    RowBox[{"k", "=", "1"}], ",", " ", 
                    RowBox[{"k", "\[LessEqual]", " ", "Nmax"}], ",", " ", 
                    RowBox[{"++", "k"}], ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"res", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", ",", "k"}], "]"}], "]"}], " ", "+=", " ", 
                    RowBox[{
                    RowBox[{"T", "[", 
                    RowBox[{"j", ",", "l", ",", "m"}], "]"}], "*", 
                    RowBox[{"T", "[", 
                    RowBox[{"r", ",", "s", ",", "k"}], "]"}], "*", "Y"}]}], 
                    ";"}]}], "\[IndentingNewLine]", "]"}]}], 
                 "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]",
               "]"}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]",
           "]"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"Return", "[", 
        RowBox[{"cof2", "*", "res", "*", 
         RowBox[{"I", "/", "Pi"}]}], "]"}]}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalSigma]nf2", "[", 
   RowBox[{
   "\[Sigma]_Integer", ",", "\[Sigma]p_Integer", ",", " ", "\[Omega]_Real"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "res", ",", "i0", ",", "ip", ",", "j", ",", "k", ",", "l", ",", "m", ",",
       "r", ",", "s", ",", "Y", ",", "\[Sigma]pp"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"res", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{"0", ",", " ", 
        RowBox[{"{", "Nmax", "}"}], ",", 
        RowBox[{"{", "Nmax", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"t", " ", "\[Equal]", " ", "0"}], ",", " ", 
       RowBox[{"Return", "[", "res", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"\[Sigma]", " ", "\[NotEqual]", " ", "\[Sigma]p"}], ",", " ", 
       RowBox[{"Return", "[", "res", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"i0", "=", 
      RowBox[{"wToi", "[", "0.0", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"r", "=", "1"}], ",", " ", 
       RowBox[{"r", "\[LessEqual]", " ", "Nmax"}], ",", " ", 
       RowBox[{"++", "r"}], ",", "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"s", "=", "1"}], ",", " ", 
         RowBox[{"s", " ", "\[LessEqual]", " ", "Nmax"}], ",", " ", 
         RowBox[{"++", "s"}], ",", "\[IndentingNewLine]", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"\[Sigma]pp", "=", "1"}], ",", 
           RowBox[{"\[Sigma]pp", "\[LessEqual]", "2"}], ",", 
           RowBox[{"++", "\[Sigma]pp"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Y", "=", 
             RowBox[{"dwglobal", " ", "*", 
              RowBox[{"Sum", "[", 
               RowBox[{
                RowBox[{"getG", "[", 
                 RowBox[{
                 "ip", ",", "\[Sigma]pp", ",", "\[Sigma]pp", ",", "r", ",", 
                  "s"}], "]"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"ip", ",", " ", "1", ",", " ", "iMaxglobal"}], 
                 "}"}]}], "]"}]}]}], " ", ";", "\[IndentingNewLine]", 
            RowBox[{"Y", " ", "=", " ", 
             RowBox[{"I", "*", 
              RowBox[{"Im", "[", "Y", "]"}]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"For", "[", 
             RowBox[{
              RowBox[{"l", "=", "1"}], ",", " ", 
              RowBox[{"l", " ", "\[LessEqual]", " ", "Nmax"}], ",", " ", 
              RowBox[{"++", "l"}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"For", "[", 
                RowBox[{
                 RowBox[{"m", "=", "1"}], ",", 
                 RowBox[{"m", "\[LessEqual]", " ", "Nmax"}], ",", 
                 RowBox[{"++", "m"}], ",", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"For", "[", 
                   RowBox[{
                    RowBox[{"j", "=", "1"}], ",", " ", 
                    RowBox[{"j", "\[LessEqual]", " ", "Nmax"}], ",", 
                    RowBox[{"++", "j"}], ",", "\[IndentingNewLine]", 
                    RowBox[{"For", "[", 
                    RowBox[{
                    RowBox[{"k", "=", "1"}], ",", " ", 
                    RowBox[{"k", "\[LessEqual]", " ", "Nmax"}], ",", " ", 
                    RowBox[{"++", "k"}], ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"res", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", ",", "k"}], "]"}], "]"}], " ", "+=", " ", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"3", "-", 
                    RowBox[{"2", "*", "\[Sigma]p"}]}], ")"}], "*", 
                    RowBox[{"(", 
                    RowBox[{"3", "-", 
                    RowBox[{"2", "*", "\[Sigma]pp"}]}], ")"}], "*", 
                    RowBox[{"T", "[", 
                    RowBox[{"j", ",", "k", ",", "l"}], "]"}], "*", 
                    RowBox[{"T", "[", 
                    RowBox[{"m", ",", "r", ",", "s"}], "]"}], "*", 
                    RowBox[{"getG", "[", 
                    RowBox[{
                    "i0", ",", "\[Sigma]", ",", "\[Sigma]pp", ",", "l", ",", 
                    "m"}], "]"}], "*", "Y"}]}], ";"}]}], 
                    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
                   "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
             "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}]}],
         "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Return", "[", 
      RowBox[{"Re", "[", 
       RowBox[{"cof2", "*", "res", "*", 
        RowBox[{"I", "/", "Pi"}]}], "]"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input"],

Cell[TextData[{
 "Rest of the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    SuperscriptBox["T", "4"], ")"}], TraditionalForm]]],
 "  graphs nonlinear self-energy contribution, named in the order given in  \
PRB ",
 StyleBox["74",
  FontWeight->"Bold"],
 ", 033408 (2006) paper.  The code below for third graph appears too slow to \
be useful, unless we got much powerful computer.  The naming according to the \
graphs in the paper Fig. 1. "
}], "Text",
 CellChangeTimes->{{3.407723674235447*^9, 3.407723687876072*^9}, {
  3.407723727266697*^9, 3.407723736204197*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalSigma]nf3", "[", 
    RowBox[{
    "\[Sigma]_Integer", ",", "\[Sigma]p_Integer", ",", " ", "\[Omega]_Real"}],
     "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "j", ",", "k", ",", "l", ",", "m", ",", "n", ",", "o", ",", "r", ",", 
       "s", ",", "t", ",", "u", ",", "v", ",", "w", ",", "\[Sigma]pp", ",", 
       "\[Sigma]ppp", ",", "i0", ",", "i", ",", "ip", ",", "ipp", ",", "res", 
       ",", "Y"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"res", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", " ", 
         RowBox[{"{", "Nmax", "}"}], ",", 
         RowBox[{"{", "Nmax", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"i", "=", 
       RowBox[{"wToi", "[", "\[Omega]", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"i0", "=", 
       RowBox[{"wToi", "[", "0.0", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"l", "=", "1"}], ",", " ", 
        RowBox[{"l", "\[LessEqual]", "Nmax"}], ",", " ", 
        RowBox[{"++", "l"}], ",", "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"m", "=", "1"}], ",", " ", 
          RowBox[{"m", "\[LessEqual]", " ", "Nmax"}], ",", " ", 
          RowBox[{"++", "m"}], ",", "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"n", "=", "1"}], ",", " ", 
            RowBox[{"n", "\[LessEqual]", " ", "Nmax"}], ",", " ", 
            RowBox[{"++", "n"}], ",", "\[IndentingNewLine]", 
            RowBox[{"For", "[", 
             RowBox[{
              RowBox[{"o", "=", "1"}], ",", " ", 
              RowBox[{"o", "\[LessEqual]", " ", "Nmax"}], ",", " ", 
              RowBox[{"++", "o"}], ",", "\[IndentingNewLine]", 
              RowBox[{"For", "[", 
               RowBox[{
                RowBox[{"r", "=", "1"}], ",", " ", 
                RowBox[{"r", " ", "\[LessEqual]", " ", "Nmax"}], ",", " ", 
                RowBox[{"++", "r"}], ",", "\[IndentingNewLine]", 
                RowBox[{"For", "[", 
                 RowBox[{
                  RowBox[{"s", "=", "1"}], ",", 
                  RowBox[{"s", "\[LessEqual]", " ", "Nmax"}], ",", " ", 
                  RowBox[{"++", "s"}], ",", "\[IndentingNewLine]", 
                  RowBox[{"For", "[", 
                   RowBox[{
                    RowBox[{"t", "=", "1"}], ",", " ", 
                    RowBox[{"t", "\[LessEqual]", " ", "Nmax"}], ",", " ", 
                    RowBox[{"++", "t"}], ",", "\[IndentingNewLine]", 
                    RowBox[{"For", "[", 
                    RowBox[{
                    RowBox[{"u", "=", "1"}], ",", " ", 
                    RowBox[{"u", "\[LessEqual]", " ", "Nmax"}], ",", " ", 
                    RowBox[{"++", "u"}], ",", "\[IndentingNewLine]", 
                    RowBox[{"For", "[", 
                    RowBox[{
                    RowBox[{"v", "=", "1"}], ",", 
                    RowBox[{"v", "\[LessEqual]", " ", "Nmax"}], ",", " ", 
                    RowBox[{"++", "v"}], ",", "\[IndentingNewLine]", 
                    RowBox[{"For", "[", 
                    RowBox[{
                    RowBox[{"w", "=", "1"}], ",", " ", 
                    RowBox[{"w", "\[LessEqual]", " ", "Nmax"}], ",", " ", 
                    RowBox[{"++", "w"}], ",", "\[IndentingNewLine]", 
                    RowBox[{"For", "[", 
                    RowBox[{
                    RowBox[{"\[Sigma]pp", "=", "1"}], ",", " ", 
                    RowBox[{"\[Sigma]pp", " ", "\[LessEqual]", "2"}], ",", 
                    " ", 
                    RowBox[{"++", "\[Sigma]pp"}], ",", "\[IndentingNewLine]", 
                    
                    RowBox[{"For", "[", 
                    RowBox[{
                    RowBox[{"\[Sigma]ppp", "=", "1"}], ",", " ", 
                    RowBox[{"\[Sigma]ppp", "\[LessEqual]", "2"}], ",", " ", 
                    RowBox[{"++", "\[Sigma]ppp"}], ",", "\[IndentingNewLine]",
                     
                    RowBox[{
                    RowBox[{"Y", "=", 
                    RowBox[{
                    RowBox[{"dwglobal", "^", "2"}], " ", "*", " ", 
                    RowBox[{"Sum", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"getG", "[", 
                    RowBox[{
                    "ipp", ",", "\[Sigma]", ",", "\[Sigma]p", ",", "m", ",", 
                    "o"}], "]"}], "*", 
                    RowBox[{"getG", "[", 
                    RowBox[{
                    RowBox[{"i0", "+", "i", "-", "ipp"}], ",", "\[Sigma]", 
                    ",", "\[Sigma]pp", ",", "l", ",", "r"}], "]"}], " ", "*", 
                    " ", 
                    RowBox[{"getG", "[", 
                    RowBox[{
                    "ip", ",", "\[Sigma]pp", ",", "\[Sigma]ppp", ",", "s", 
                    ",", "v"}], "]"}], " ", "*", " ", 
                    RowBox[{"getG", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"2", "*", "i0"}], "+", "i", "-", "ip", "-", 
                    "ipp"}], ",", "\[Sigma]pp", ",", "\[Sigma]ppp", ",", "t", 
                    ",", "w"}], "]"}], "*", 
                    RowBox[{"getG", "[", 
                    RowBox[{
                    RowBox[{"i0", "+", "i", "-", "ipp"}], ",", "\[Sigma]ppp", 
                    ",", "\[Sigma]p", ",", "u", ",", "n"}], "]"}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{"ip", ",", "1", ",", "iMaxglobal"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"ipp", ",", "1", ",", "iMaxglobal"}], "}"}]}], 
                    "]"}]}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"For", "[", 
                    RowBox[{
                    RowBox[{"j", "=", "1"}], ",", " ", 
                    RowBox[{"j", "\[LessEqual]", " ", "Nmax"}], ",", " ", 
                    RowBox[{"++", "j"}], ",", "\[IndentingNewLine]", 
                    RowBox[{"For", "[", 
                    RowBox[{
                    RowBox[{"k", "=", "1"}], ",", 
                    RowBox[{"k", "\[LessEqual]", " ", "Nmax"}], ",", " ", 
                    RowBox[{"++", "k"}], ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"res", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", ",", "k"}], "]"}], "]"}], " ", "+=", " ", 
                    RowBox[{"Y", "*", 
                    RowBox[{"T", "[", 
                    RowBox[{"j", ",", "l", ",", "m"}], "]"}], "*", 
                    RowBox[{"T", "[", 
                    RowBox[{"n", ",", "o", ",", "k"}], "]"}], "*", 
                    RowBox[{"T", "[", 
                    RowBox[{"r", ",", "s", ",", "t"}], "]"}], "*", 
                    RowBox[{"T", "[", 
                    RowBox[{"v", ",", "u", ",", "w"}], "]"}], "*", 
                    RowBox[{"(", 
                    RowBox[{"3", "-", 
                    RowBox[{"2", "*", "\[Sigma]pp"}]}], ")"}], "*", 
                    RowBox[{"(", 
                    RowBox[{"3", "-", 
                    RowBox[{"2", "*", "\[Sigma]ppp"}]}], ")"}]}]}], ";"}]}], 
                    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
                    "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
                    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
                    "]"}]}], "\[IndentingNewLine]", "]"}]}], 
                    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
                   "]"}]}], "\[IndentingNewLine]", "]"}]}], 
               "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}],
            "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{
        RowBox[{"cof2", "^", "2"}], "*", "res", " ", "*", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"-", "8.0"}], ")"}], "/", 
