Notebook[{

Cell[CellGroupData[{
Cell[TextData[StyleBox["Nonequilibrium Green's function methods for thermal \
energy current, Version 6", "Title"]], "Title",
 CellChangeTimes->{{3.407646836362582*^9, 3.4076468366125836`*^9}, {
  3.4077226156065674`*^9, 3.407722617262807*^9}, {3.4077226596062856`*^9, 
  3.4077226603250313`*^9}}],

Cell["Wang Jian-Sheng, 27 Dec 2007", "Subsubtitle",
 CellChangeTimes->{{3.407646840081356*^9, 3.407646846050144*^9}, {
  3.407722609997228*^9, 3.4077226102159767`*^9}}],

Cell[TextData[{
 "References: \n(1) ",
 StyleBox["Linear case",
  FontSlant->"Italic"],
 ":  N. Mingo and L. Yang, PRB ",
 StyleBox["68",
  FontWeight->"Bold"],
 ", 245406 (2003); A. Dhar and D. Sen, PRB ",
 StyleBox["73",
  FontWeight->"Bold"],
 ", 085119 (2006); and P. A. Khomyakov, et al, PRB ",
 StyleBox["72",
  FontWeight->"Bold"],
 ", 035450 (2005).\n(2) ",
 StyleBox["Nonlinear, general derivation",
  FontSlant->"Italic"],
 ":  Y. Meir and N. S. Wingreen, PRL ",
 StyleBox["68",
  FontWeight->"Bold"],
 ", 2512 (1992); A.-P. Jauho, N. S. Wingreen, and Y. Meir, PRB ",
 StyleBox["50",
  FontWeight->"Bold"],
 ", 5528 (1994).\n(3) ",
 StyleBox["General nonequilibrium Green's function methods",
  FontSlant->"Italic"],
 ":  L. Kadnoff and Baym's book,  J. Rammer and H. Smith, RMP ",
 StyleBox["58",
  FontWeight->"Bold"],
 ", 323 (1986). \nSee also J-S Wang, J Wang, and J-T Lu, ",
 StyleBox["quantum thermal transport in nanostructures",
  FontSlant->"Italic"],
 ", preprint.\n\nThe 1D spring model consists of spring constant ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "1"], TraditionalForm]]],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "2"], TraditionalForm]]],
 " for the left lead (site -\[Infinity], ..., -1, 0) and right lead (site \
Nmax+1, Nmax+2, ..., +\[Infinity]).   The central part has ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "c"], TraditionalForm]]],
 " for the harmonic part connecting among sites 1, 2, ..., Nmax; and the \
interactions between the leads and central part are also ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "1"], TraditionalForm]]],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "2"], TraditionalForm]]],
 ".  The central part has Nmax atoms. Masses of all particles are assumed the \
same, ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]]],
 ".  (in program, k is already divided by the ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]]],
 ", and ",
 StyleBox["t",
  FontSlant->"Italic"],
 " by ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["m", 
    RowBox[{"3", "/", "2"}]], TraditionalForm]]],
 ").    In addition, each of the lead atom has uniform on-site interaction \
with the substrate, k1onsite and k2onsite.  The nonlinear interation is the \
cubic-FPU model (\[Alpha]-model):\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["H", "non"], "=", " ", 
    RowBox[{
     RowBox[{"t", " ", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "1"}], 
        RowBox[{"Nmax", "-", "1"}]], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["x", "i"], "-", 
          SubscriptBox["x", 
           RowBox[{"i", "+", "1"}]]}], ")"}], "3"]}]}], " ", "=", 
     RowBox[{
      FractionBox["1", "3"], 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"ijk", "=", "1"}], "Nmax"], 
       RowBox[{
        SubscriptBox["T", "ijk"], 
        SubscriptBox["x", "i"], 
        SubscriptBox["x", "j"], 
        SubscriptBox["x", "k"]}]}]}]}]}], TraditionalForm]]],
 "\nwhere for Nmax=2 ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["T", "111"], "=", 
     RowBox[{"3", "t"}]}], ",", " ", 
    RowBox[{
     SubscriptBox["T", "112"], "=", 
     RowBox[{
      SubscriptBox["T", "121"], "=", 
      RowBox[{
       SubscriptBox["T", "211"], "=", 
       RowBox[{
        RowBox[{"-", "3"}], "t"}]}]}]}], ",", " ", 
    RowBox[{
     SubscriptBox["T", "122"], "=", 
     RowBox[{
      SubscriptBox["T", "212"], "=", 
      RowBox[{
       SubscriptBox["T", "221"], "=", 
       RowBox[{"3", "t"}]}]}]}], ","}], TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["T", "222"], "=", 
    RowBox[{
     RowBox[{"-", "3"}], "t"}]}], TraditionalForm]]],
 ".   The overall retarded Green's function ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]]],
 " for the linear system is from ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"[", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"\[Omega]", "+", 
          RowBox[{"i", " ", "\[Eta]"}]}], ")"}], "2"], "-", "K"}], "]"}], 
     "G"}], "=", "I"}], TraditionalForm]]],
 ".  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Eta]", " "], "\[Rule]", " ", 
    RowBox[{
     SuperscriptBox["0", "+"], "."}]}], TraditionalForm]]],
 "  Note that ",
 StyleBox["k",
  FontSlant->"Italic"],
 " and ",
 StyleBox["t",
  FontSlant->"Italic"],
 " in this program are actually rescaled by the mass of atoms through the \
transformation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["u", 
     RowBox[{"j", " "}]], "\[Rule]", 
    RowBox[{
     SqrtBox[
      SubscriptBox["m", "j"]], " ", 
     SubscriptBox["x", 
      RowBox[{"j", " "}]]}]}], TraditionalForm]]],
 ".\n\nIn this version, a list of Green's functions is computed first. The \
list is generated if the function makeGlist[ ] is called. \n\nFirst, we set \
the model parameters numerically.  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "1"], TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "2"], TraditionalForm]]],
 " are the temperatures of the left and right lead. We also set the \
infinitesimal small positive \[Eta] here.  Units are such that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\:f7d8", "/", 
     SubscriptBox["k", "B"]}], "=", "cof"}], TraditionalForm]]],
 "\:ff0cand \:f7d8=cof2 in the current choice of units.   In such units, the \
mass ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["m", "0"], TraditionalForm]]],
 " is 1 amu. (atomic mass units, approximately mass of a proton,  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1.66", "\[Times]", 
    SuperscriptBox["10", 
     RowBox[{"-", "27"}]]}], TraditionalForm]]],
 "kg ), original coupling ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "0"], TraditionalForm]]],
 " is in units of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", "4"], TraditionalForm]]],
 " dyn/cm, and three-body coupling ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["t", "0"], TraditionalForm]]],
 " in eV/(\[Angstrom] ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox[
      SubscriptBox["m", "0"], 
      RowBox[{"3", "/", "2"}]], ")"}], "=", 
    RowBox[{"2.368", "\[Times]", 
     SuperscriptBox["10", "51"]}]}], TraditionalForm]]],
 "(SI units).     This implies that the units for time is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["T", "0"], "=", 
    RowBox[{
     RowBox[{"1", "/", 
      SubscriptBox["\[Omega]", "0"]}], "=", 
     RowBox[{
      SqrtBox[
       RowBox[{
        SubscriptBox["m", "0"], "/", 
        SubscriptBox["k", "0"]}]], "=", 
      RowBox[{"1.288", " ", "\[Times]", 
       SuperscriptBox["10", 
        RowBox[{"-", "14"}]]}]}]}]}], TraditionalForm]]],
 "sec,  units for \:f7d8 is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FormBox[
      RowBox[{"1", "/", " ", 
       RowBox[{"(", 
        SuperscriptBox[
         SubscriptBox["T", "0"], "5"]}]}],
      TraditionalForm], 
     SuperscriptBox["t", "2"]}], ")"}], TraditionalForm]]],
 ".  Since we have fixed time ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "0"], TraditionalForm]]],
 " and \:f7d8,  the unit for energy must be ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FormBox[
      RowBox[{
       SubscriptBox["E", "0"], "="}],
      TraditionalForm], 
     RowBox[{"\:f7d8", "/", 
      SubscriptBox["T", "0"]}]}], "="}], TraditionalForm]]],
 "51.08 meV.  Unit for temperature is Kelvin.  The final thermal current can \
be converted to SI units by cof3 = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FormBox[
     SuperscriptBox[
      SubscriptBox["\:f7d8\[Omega]", "0"], "2"],
     TraditionalForm], "=", 
    RowBox[{"6.355", "\[Cross]", 
     SuperscriptBox["10", 
      RowBox[{"-", "7"}]]}]}], TraditionalForm]]],
 "W = 635.5 nW (nano Watts).\n\nWe'll consider a 1D Carbon chain with \
parameters used in D Segal & A Nitzan, PRL ",
 StyleBox["94",
  FontWeight->"Bold"],
 ", 034301 (2005).   Two body potential is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"V", "(", "x", ")"}], "=", 
    RowBox[{"D", " ", 
     SuperscriptBox[
      RowBox[{"(", " ", 
       RowBox[{
        RowBox[{"exp", "(", 
         RowBox[{
          RowBox[{"-", "\[Alpha]"}], " ", "x"}], ")"}], "-", "1"}], ")"}], 
      "2"]}]}], TraditionalForm]]],
 "\:ff0c where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"D", "=", 
     RowBox[{"3.8", " ", "eV"}]}], ","}], TraditionalForm]]],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "=", 
    RowBox[{"1.88", " ", 
     SuperscriptBox["\[Angstrom]", 
      RowBox[{"-", "1"}]]}]}], TraditionalForm]]],
 ".  mass = 12 amu.  This means for our program: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FormBox[
      RowBox[{"k", "=", 
       RowBox[{"2", 
        SuperscriptBox["D\[Alpha]", "2"]}]}],
      TraditionalForm], "/", "m"}], "=", "2.24"}], TraditionalForm]]],
 ",  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox["D\[Alpha]", "3"], "/", 
      SuperscriptBox["m", 
       RowBox[{"3", "/", "2"}]]}], "=", "0.607"}]}], TraditionalForm]]],
 "  (sign not important).   "
}], "Text",
 CellChangeTimes->{{3.4077226732155733`*^9, 3.407722759246273*^9}, {
  3.4077228145896688`*^9, 3.40772282141775*^9}, {3.4077229555115266`*^9, 
  3.4077229976058154`*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{
    "order", ",", " ", "k1", ",", "k1onsite", ",", "k2", ",", "k2onsite", ",",
      "kC", ",", " ", "Nmax", ",", " ", "w", ",", " ", "T1", ",", " ", "T2", 
     ",", "t", ",", " ", "\[Eta]", ",", "cof", ",", " ", "cof2", ",", "T", 
     ",", "Tlist", ",", "i", ",", "j", ",", "k"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"order", " ", "=", " ", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"k1", "=", " ", "2.5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"k1onsite", "=", "0.0001"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"k2", "=", "2.0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"k2onsite", "=", "0.0001"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kC", "=", "1.5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Nmax", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"T1", "=", " ", "295.0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"T2", "=", "305.0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"t", "=", "0.6"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Eta]", " ", "=", " ", "0.0001"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cof", "=", "592.467"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"cof2", " ", "=", " ", "0.209985"}], ";"}], 
  " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"cof3", " ", "=", " ", "635.5"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", 
    RowBox[{"i", "\[LessEqual]", "Nmax"}], ",", 
    RowBox[{"++", "i"}], ",", "\[IndentingNewLine]", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"j", "=", "1"}], ",", 
      RowBox[{"j", "\[LessEqual]", "Nmax"}], ",", 
      RowBox[{"++", "j"}], ",", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"k", "=", "1"}], ",", 
        RowBox[{"k", "\[LessEqual]", "Nmax"}], ",", 
        RowBox[{"++", "k"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"T", "[", 
           RowBox[{"i", ",", "j", ",", "k"}], "]"}], "=", "0"}], ";"}]}], 
       "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}], 
   "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", 
   RowBox[{"i", "<", "Nmax"}], ",", 
   RowBox[{"++", "i"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"j", "=", 
     RowBox[{"i", "+", "1"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"T", "[", 
      RowBox[{"i", ",", "i", ",", "i"}], "]"}], "+=", 
     RowBox[{"3", "t"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"T", "[", 
      RowBox[{"i", ",", "i", ",", "j"}], "]"}], "=", 
     RowBox[{
      RowBox[{"T", "[", 
       RowBox[{"i", ",", "j", ",", "i"}], "]"}], "=", 
      RowBox[{
       RowBox[{"T", "[", 
        RowBox[{"j", ",", "i", ",", "i"}], "]"}], "=", 
       RowBox[{
        RowBox[{"-", "3"}], "t"}]}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"T", "[", 
      RowBox[{"i", ",", "j", ",", "j"}], "]"}], "=", 
     RowBox[{
      RowBox[{"T", "[", 
       RowBox[{"j", ",", "i", ",", "j"}], "]"}], "=", 
      RowBox[{
       RowBox[{"T", "[", 
        RowBox[{"j", ",", "j", ",", "i"}], "]"}], "=", 
       RowBox[{"3", "t"}]}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"T", "[", 
      RowBox[{"j", ",", "j", ",", "j"}], "]"}], "+=", 
     RowBox[{
      RowBox[{"-", "3"}], "t"}]}], ";"}]}], "\[IndentingNewLine]", 
  "]"}]}], "Input",
 CellChangeTimes->{{3.40772319678024*^9, 3.407723209967905*^9}, {
  3.4077232687964067`*^9, 3.4077232691089087`*^9}, {3.407723915329197*^9, 
  3.407723947485447*^9}, {3.407723994876072*^9, 3.407724000094822*^9}, {
  3.407725792153763*^9, 3.40772579557555*^9}, {3.4077260229145393`*^9, 
  3.407726025586363*^9}, {3.40772897267704*^9, 3.40772897513015*^9}, {
  3.407729293534362*^9, 3.4077292937374854`*^9}, {3.407732189125205*^9, 
  3.407732192531433*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Tlist", "=", 
  RowBox[{"Select", "[", 
   RowBox[{
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"i", ",", "j", ",", "k", ",", 
          RowBox[{"T", "[", 
           RowBox[{"i", ",", "j", ",", "k"}], "]"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "1", ",", "3"}], "}"}]}], "]"}], ",", "2"}], "]"}],
     ",", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", "4", "]"}], "]"}], "!=", "0"}], ")"}], "&"}]}], 
   "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1", ",", "1.7999999999999998`"}], "}"}], ",",
    
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "2", ",", 
     RowBox[{"-", "1.7999999999999998`"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "1", ",", 
     RowBox[{"-", "1.7999999999999998`"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "2", ",", "1.7999999999999998`"}], "}"}], ",",
    
   RowBox[{"{", 
    RowBox[{"2", ",", "1", ",", "1", ",", 
     RowBox[{"-", "1.7999999999999998`"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "1", ",", "2", ",", "1.7999999999999998`"}], "}"}], ",",
    
   RowBox[{"{", 
    RowBox[{"2", ",", "2", ",", "1", ",", "1.7999999999999998`"}], "}"}], ",",
    
   RowBox[{"{", 
    RowBox[{"2", ",", "2", ",", "2", ",", 
     RowBox[{"-", "1.7999999999999998`"}]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.407723247718147*^9}]
}, Open  ]],

Cell[BoxData[
 RowBox[{"Export", "[", 
  RowBox[{
  "\"\<D:\\\\temp\\\\Tlist.dat\>\"", ",", "Tlist", ",", "\"\<Table\>\""}], 
  "]"}]], "Input"],

Cell[TextData[{
 "Order determine the terms of nonlinear self-energy: 0 linear system only \
(",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalSigma]", "n"], "=", "0"}], TraditionalForm]]],
 "), 1 to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    SuperscriptBox["T", "2"], ")"}], TraditionalForm]]],
 ",  2 to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    SuperscriptBox["T", "4"], ")"}], TraditionalForm]]],
 ".  We also clear all definitions and global variables"
}], "Text"],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{
  "g", ",", "gl", ",", "fB", ",", "computeGr", ",", "makeGlist", ",", "wToi", 
   ",", "Garray", ",", "getG", ",", "\[CapitalSigma]nf1", ",", 
   "\[CapitalSigma]nf2", ",", "\[CapitalSigma]nf3", ",", "\[CapitalSigma]nf4",
    ",", "\[CapitalSigma]nf5", ",", "\[CapitalSigma]nf6", ",", 
   "\[CapitalSigma]nf7", ",", "\[CapitalSigma]nf8", ",", "transmission", ",", 
   "Glist", ",", "dwglobal", ",", "iMaxglobal", ",", "wMaxglobal"}], 
  "]"}]], "Input"],

Cell[CellGroupData[{

Cell["Green's functions for linear system", "Section",
 CellChangeTimes->{{3.407723290015292*^9, 3.4077232901715436`*^9}}],

Cell[TextData[{
 "The definitions of various Green functions:\ntime ordered:\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["G", 
      RowBox[{"j", " ", "k"}], "T"], "(", "t", ")"}], "=", 
    RowBox[{
     RowBox[{"-", "i"}], "<", 
     RowBox[{"T", " ", 
      RowBox[{
       SubscriptBox["x", "j"], "(", "t", ")"}], " ", 
      RowBox[{
       SubscriptBox["x", "k"], "(", "0", ")"}]}], ">"}]}], 
   TraditionalForm]]],
 ",\nanti-time ordered:  \t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["G", 
      RowBox[{"j", " ", "k"}], 
      OverscriptBox["T", "_"]], "(", "t", ")"}], "=", 
    RowBox[{
     RowBox[{"-", "i"}], "<", 
     RowBox[{
      OverscriptBox["T", "_"], " ", 
      RowBox[{
       SubscriptBox["x", "j"], "(", "t", ")"}], " ", 
      RowBox[{
       SubscriptBox["x", "k"], "(", "0", ")"}]}], ">"}]}], 
   TraditionalForm]]],
 ",\nretarded:  \t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["G", 
      RowBox[{"j", " ", "k"}], "R"], "(", "t", ")"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "i"}], " ", 
      RowBox[{"\[Theta]", "(", "t", ")"}]}], "<", 
     RowBox[{"[", 
      RowBox[{
       RowBox[{
        SubscriptBox["x", "j"], "(", "t", ")"}], ",", " ", 
       RowBox[{
        SubscriptBox["x", "k"], "(", "0", ")"}]}], "]"}], ">"}]}], 
   TraditionalForm]]],
 ",\nadvanced: \t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["G", 
      RowBox[{"j", " ", "k"}], "A"], "(", "t", ")"}], "=", 
    RowBox[{
     RowBox[{"i", " ", 
      RowBox[{"\[Theta]", "(", 
       RowBox[{"-", "t"}], ")"}]}], "<", 
     RowBox[{"[", 
      RowBox[{
       RowBox[{
        SubscriptBox["x", "j"], "(", "t", ")"}], ",", " ", 
       RowBox[{
        SubscriptBox["x", "k"], "(", "0", ")"}]}], "]"}], ">"}]}], 
   TraditionalForm]]],
 ",\nless than:\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["G", 
      RowBox[{"j", " ", "k"}], "<"], "(", "t", ")"}], "=", 
    RowBox[{
     RowBox[{"-", "i"}], "<", 
     RowBox[{
      RowBox[{
       SubscriptBox["x", "k"], "(", "0", ")"}], " ", 
      RowBox[{
       SubscriptBox["x", "j"], "(", "t", ")"}]}], ">"}]}], 
   TraditionalForm]]],
 ",\ngreater than:\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["G", 
      RowBox[{"j", " ", "k"}], ">"], "(", "t", ")"}], "=", 
    RowBox[{
     RowBox[{"-", "i"}], "<", 
     RowBox[{
      RowBox[{
       SubscriptBox["x", "j"], "(", "t", ")"}], 
      RowBox[{
       SubscriptBox["x", "k"], "(", "0", ")"}]}], ">"}]}], 
   TraditionalForm]]],
 ".\nNote the general relations among the green functions.\nKeldsh:\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FormBox[
     RowBox[{
      SuperscriptBox["G", "K"], "=", 
      RowBox[{
       SuperscriptBox["G", ">"], "+", 
       SuperscriptBox["G", "<"]}]}],
     TraditionalForm], "=", 
    RowBox[{
     SuperscriptBox["G", "T"], "+", 
     SuperscriptBox["G", 
      OverscriptBox["T", "_"]]}]}], TraditionalForm]]],
 ",\nspectrum:\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["G", "~"], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox["G", "R"], "-", 
      SuperscriptBox["G", "A"]}], "=", 
     RowBox[{
      SuperscriptBox["G", ">"], "-", 
      SuperscriptBox["G", "<"]}]}]}], TraditionalForm]]],
 ",  and\n\t\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["G", "T"], "=", 
    RowBox[{
     SuperscriptBox["G", "<"], "+", 
     SuperscriptBox["G", "R"]}]}], TraditionalForm]]],
 ",\n\t\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["G", 
     OverscriptBox["T", "_"]], "=", 
    RowBox[{
     SuperscriptBox["G", "<"], "-", 
     SuperscriptBox["G", "A"]}]}], TraditionalForm]]],
 ".\nIn frequency domain, we also have  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["G", "A"], "[", "\[Omega]", "]"}], " ", "=", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["G", "R"], "[", "\[Omega]", "]"}], ")"}], 
     "\[Dagger]"]}], TraditionalForm]]],
 ". These relations come from the definition of the Green's functions, thus \
are generally valid, whether it is in equilibrium or not.  In thermal \
equilibrium, we have additional relations which can be proved with Lehman \
represention:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox["G", "<"], "[", "\[Omega]", "]"}], " ", "=", " ", 
     RowBox[{
      SuperscriptBox["e", 
       RowBox[{"-", "\[Beta]\[Omega]"}]], 
      RowBox[{
       SuperscriptBox["G", ">"], "[", "\[Omega]", "]"}]}]}], ","}], 
   TraditionalForm]]],
 "  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Beta]", "=", 
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["k", "B"], "T"}], ")"}]}]}], TraditionalForm]]],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["G", "<"], "[", "\[Omega]", "]"}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["f", "B"], "[", "\[Omega]", "]"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SuperscriptBox["G", "R"], "[", "\[Omega]", "]"}], "-", 
       RowBox[{
        SuperscriptBox["G", "A"], "[", "\[Omega]", "]"}]}], ")"}]}]}], 
   TraditionalForm]]],
 ",  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["f", "B"], "[", "\[Omega]", "]"}], "=", 
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["e", "\[Beta]\[Omega]"], "-", "1"}], ")"}]}]}], 
   TraditionalForm]]],
 ".   With these relations, only two Green's functions are independent in \
nonequilibrium case and one in equilibrium problem.  We also have symmetry \
relations in \[Omega]:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["G", 
        RowBox[{"r", ",", "a"}]], "[", "\[Omega]", "]"}], ")"}], "*"], "=", 
    RowBox[{
     SuperscriptBox["G", 
      RowBox[{"r", ",", "a"}]], "[", 
     RowBox[{"-", "\[Omega]"}], "]"}]}], TraditionalForm]]],
 " (generally) and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox[
      SubscriptBox["G", "jj"], "<"], "[", 
     RowBox[{"-", "\[Omega]"}], "]"}], "=", 
    RowBox[{
     SuperscriptBox["e", "\[Beta]\[Omega]"], 
     RowBox[{
      SuperscriptBox[
       SubscriptBox["G", "jj"], "<"], "[", "\[Omega]", "]"}]}]}], 
   TraditionalForm]]],
 " (in equilibrium)."
}], "Text",
 CellChangeTimes->{{3.4077233171873417`*^9, 3.407723317468593*^9}}],

Cell[TextData[{
 "g[\[Omega],k,k'], k=k1 and k2, k' for onsite interaction, are the \
semi-infinite Green's functions (surface Green's functions for the free \
leads) at the conjunction, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", "\[Alpha]\[Alpha]"], TraditionalForm]]],
 ", or ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", "\[Beta]\[Beta]"], TraditionalForm]]],
 ".    ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]]],
 " = exp(i",
 Cell[BoxData[
  FormBox["q", TraditionalForm]]],
 "),  ",
 Cell[BoxData[
  FormBox["q", TraditionalForm]]],
 " is the wave number in dispersion relations (",
 Cell[BoxData[
  FormBox["q", TraditionalForm]]],
 " can be complex).  ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]]],
 " satisfies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"\[Omega]", "+", 
        RowBox[{"i", " ", "\[Eta]"}]}], ")"}], "2"], "-", 
     RowBox[{"2", "k"}], "-", 
     RowBox[{"k", "'"}], "+", 
     RowBox[{"k", " ", "x"}], " ", "+", " ", 
     RowBox[{"k", "/", "x"}]}], " ", "=", "0"}], TraditionalForm]]],
 " .  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", "L"], TraditionalForm]]],
 " is the solution of the equation,  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"[", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"\[Omega]", "+", "i\[Eta]"}], ")"}], "2"], "-", " ", 
       SubscriptBox["K", "L"]}], "]"}], 
     SubscriptBox["g", "L"]}], "=", "I"}], TraditionalForm]]],
 ", which is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     RowBox[{"exp", "(", 
      RowBox[{"i", " ", "q"}], ")"}]}], "/", 
    SubscriptBox["k", "1"]}], TraditionalForm]]],
 " in this simple model.  One should pay particularly the sign or branch \
choices such that ",
 Cell[BoxData[
  FormBox["g", TraditionalForm]]],
 " satisfies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"g", "[", "\[Omega]", "]"}], "=", 
    RowBox[{
     SuperscriptBox["g", "*"], "[", 
     RowBox[{"-", "\[Omega]"}], "]"}]}], TraditionalForm]]],
 " (The choose is such that Abs[exp(i",
 Cell[BoxData[
  FormBox["q", TraditionalForm]]],
 ")]<1).  We need only the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", "00"], TraditionalForm]]],
 " element.   We also need ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["g", "<"], TraditionalForm]]],
 ", the less Green's functions of the leads.   We have set ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\:f7d8", "/", " ", 
     SubscriptBox["k", "B"]}], " ", "=", 
    RowBox[{"cof", "."}]}], TraditionalForm]]],
 "  We write out clearfully so that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["g", "<"], "[", 
    RowBox[{"\[Omega]", "=", "0"}], "]"}], TraditionalForm]]],
 " is well-defined.  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"fB", "[", 
    RowBox[{"\[Omega]", ",", "T"}], "]"}], TraditionalForm]]],
 " is Bose-Einstein distribution."
}], "Text",
 CellChangeTimes->{{3.407723351500061*^9, 3.4077233592657356`*^9}, {
  3.407723406500413*^9, 3.407723406703539*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"g", "[", 
     RowBox[{"w_", ",", "k_", ",", "kp_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "a", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"w", " ", "\[Equal]", " ", "0"}], ",", "\[IndentingNewLine]", 
        
        RowBox[{
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "k"}], "+", "kp", "+", 
            RowBox[{"\[Eta]", "^", "2"}], " ", "-", " ", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"kp", "+", 
                RowBox[{"\[Eta]", "^", "2"}]}], ")"}], "*", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"4", "k"}], "+", "kp", "+", 
                RowBox[{"\[Eta]", "^", "2"}]}], ")"}]}], "]"}]}], ")"}]}], 
         "/", 
         RowBox[{"(", 
          RowBox[{"2", "*", 
           RowBox[{"k", "^", "2"}]}], ")"}]}], " ", ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"a", "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"w", "+", 
                RowBox[{"I", "*", "\[Eta]"}]}], ")"}], "^", "2"}], "-", 
             RowBox[{"2", "k"}], "-", "kp"}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"2", "k"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"(", " ", 
           RowBox[{"a", "-", " ", 
            RowBox[{
             RowBox[{"Sign", "[", "w", "]"}], "*", "I", "*", 
             RowBox[{"Sqrt", "[", 
              RowBox[{"1", "-", 
               RowBox[{"a", "^", "2"}]}], "]"}]}]}], ")"}], "/", "k"}]}]}], 
       "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gl", "[", 
     RowBox[{"w_", ",", "k_", ",", "kp_", ",", "Tm_"}], "]"}], " ", ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "x", "}"}], ",", " ", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"w", "\[Equal]", "0"}], ",", 
        RowBox[{"Limit", "[", 
         RowBox[{
          RowBox[{"2", "*", "I", "*", 
           RowBox[{
            RowBox[{"Im", "[", 
             RowBox[{"g", "[", 
              RowBox[{"x", ",", "k", ",", "kp"}], "]"}], "]"}], "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Exp", "[", 
               RowBox[{"cof", "*", 
                RowBox[{"x", "/", "Tm"}]}], "]"}], "-", "1"}], ")"}]}]}], ",",
           
          RowBox[{"x", "\[Rule]", " ", "0"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"2", "*", "I", "*", 
         RowBox[{
          RowBox[{"Im", "[", 
           RowBox[{"g", "[", 
            RowBox[{"w", ",", "k", ",", "kp"}], "]"}], "]"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Exp", "[", 
             RowBox[{"cof", "*", 
              RowBox[{"w", "/", "Tm"}]}], "]"}], "-", "1"}], ")"}]}]}]}], 
       "]"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fB", "[", 
   RowBox[{"w_", ",", "Tm_"}], "]"}], ":=", 
  RowBox[{"1", "/", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{"cof", "*", 
       RowBox[{"w", "/", "Tm"}]}], "]"}], "-", "1"}], ")"}]}]}]}], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Re", "[", "#", "]"}], ",", 
        RowBox[{"Im", "[", "#", "]"}]}], "}"}], "&"}], "[", 
     RowBox[{"gl", "[", 
      RowBox[{"w", ",", "k1", ",", "k1onsite", ",", "T1"}], "]"}], "]"}], 
    "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"w", ",", 
     RowBox[{"-", "3.5"}], ",", "3.2"}], "}"}], ",", " ", 
   RowBox[{"PlotStyle", "\[Rule]", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"RGBColor", "[", 
       RowBox[{"0", ",", "0", ",", "0"}], "]"}], ",", " ", 
      RowBox[{"RGBColor", "[", 
       RowBox[{"1", ",", "0", ",", "0"}], "]"}]}], "}"}]}]}], "]"}]], "Input",\

 CellChangeTimes->{{3.4077234749539757`*^9, 3.4077234851571665`*^9}}],

