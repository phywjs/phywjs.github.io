Cell[TextData[{
 "Compute S-matrix.  S is unitary, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["S", "\[Dagger]"], "S"}], "=", 
    RowBox[{"I", "."}]}], TraditionalForm]]]
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"S", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"r", ",", "t"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "r"}], "}"}]}], "}"}]}], ";"}]], "Input"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Feynman diagrammatic expansion for heat transport green functions with cubic \
nonlinear interactions\
\>", "Section"],

Cell[TextData[{
 "The coupling T[i,j,k] will be denoted by \[Lambda], which controls the \
order of expansion.  Maxorder is the highest order to compute, Grn[ ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "c"}], "}"}], ",", "n"}], 
   TraditionalForm]]],
 "] is green function with leg ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"a", ",", "b", ",", "c"}], "]"}], TraditionalForm]]],
 ".  ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " indicates number \[Lambda] generated so far in the final graph, used to \
generate dummy indices.  At the highest (top) level, we take ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", "0."}], TraditionalForm]]],
 " Two terminating conditions for the grand recursion are first set.  Grn[] \
implements the resursion rules and also symmetrize with respect to the \
arguments with the orderless attributes. "
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"maxorder", ",", "Grn", ",", "G", ",", "ts", ",", "permuterules"}],
    "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"maxorder", " ", "=", " ", "4"}]}], "Input"],

Cell[BoxData["4"], "Output"]
}, Open  ]],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetAttributes", "[", 
   RowBox[{"G", ",", " ", "Orderless"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Grn", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", "n_"}], "]"}], ":=", 
   RowBox[{"-", "I"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Grn", "[", 
   RowBox[{"arg_List", ",", " ", "n_"}], "]"}], ":=", 
  RowBox[{"0", " ", "/;", " ", 
   RowBox[{"n", " ", ">", " ", "maxorder"}]}]}]}], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Grn", "[", 
   RowBox[{"arg_List", ",", " ", "n_Integer"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "len", ",", "k", ",", "j", ",", "newarg", ",", " ", "res", ",", 
      "tdummy"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"len", " ", "=", " ", 
      RowBox[{"Length", "[", "arg", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tdummy", " ", "=", " ", 
      RowBox[{"ToExpression", "[", 
       RowBox[{"\"\<t\>\"", "<>", 
        RowBox[{"ToString", "[", "n", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"res", " ", "=", " ", "0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"k", "=", "1"}], ",", " ", 
       RowBox[{"k", "\[LessEqual]", "len"}], ",", " ", 
       RowBox[{"++", "k"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"newarg", " ", "=", " ", 
         RowBox[{"Insert", "[", 
          RowBox[{
           RowBox[{"ReplacePart", "[", 
            RowBox[{"arg", ",", "tdummy", ",", "k"}], "]"}], ",", "tdummy", 
           ",", "k"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"res", " ", "+=", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "/", "len"}], ")"}], "*", "\[Lambda]", "*", 
          RowBox[{"G", "[", 
           RowBox[{
            RowBox[{"arg", "[", 
             RowBox[{"[", "k", "]"}], "]"}], ",", "tdummy"}], "]"}], "*", 
          RowBox[{"Grn", "[", 
           RowBox[{"newarg", ",", 
            RowBox[{"n", "+", "1"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"j", "=", "1"}], ",", " ", 
          RowBox[{"j", "\[LessEqual]", " ", "len"}], ",", 
          RowBox[{"++", "j"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"j", "\[NotEqual]", "k"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"res", " ", "+=", " ", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"1", "/", "len"}], ")"}], " ", "*", " ", "I", "*", 
                " ", 
                RowBox[{"G", "[", 
                 RowBox[{
                  RowBox[{"arg", "[", 
                   RowBox[{"[", "k", "]"}], "]"}], ",", 
                  RowBox[{"arg", "[", 
                   RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "*", 
                RowBox[{"Grn", "[", 
                 RowBox[{
                  RowBox[{"Delete", "[", 
                   RowBox[{"arg", ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", "k", "}"}], ",", 
                    RowBox[{"{", "j", "}"}]}], "}"}]}], "]"}], ",", "n"}], 
                 "]"}]}]}], ";"}]}], " ", "\[IndentingNewLine]", "]"}], 
           ";"}]}], " ", "\[IndentingNewLine]", "]"}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"res", " ", "//", " ", "Simplify"}], " ", "//", " ", 
      "Expand"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"g12", "=", 
   RowBox[{"Grn", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], ",", "0"}], "]"}]}], ";"}]], "Input"],

Cell[TextData[{
 "Canonize[] takes a term and puts into canonical form by permutating all \
dummy indices ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["t", "n"], TraditionalForm]]],
 " and choices a particular one."
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ts", " ", "=", " ", 
   RowBox[{"Table", "[", " ", 
    RowBox[{
     RowBox[{"ToExpression", "[", " ", 
      RowBox[{"\"\<t\>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", "k", "]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "0", ",", " ", 
       RowBox[{"maxorder", "-", "1"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"permuterules", " ", "=", " ", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Thread", "[", 
        RowBox[{"ts", " ", "\[Rule]", " ", "#"}], "]"}], "&"}], ",", 
      RowBox[{"Permutations", "[", "ts", "]"}]}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"canonize", "[", "fyn_", "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "flist", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"flist", " ", "=", " ", 
      RowBox[{"Sort", "[", 
       RowBox[{"fyn", " ", "/.", " ", "permuterules"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Return", "[", 
      RowBox[{"flist", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"canonize", " ", "/@", " ", "g12"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"G", "[", 
   RowBox[{"1", ",", "2"}], "]"}], "+", 
  RowBox[{"2", " ", "\[ImaginaryI]", " ", 
   SuperscriptBox["\[Lambda]", "2"], " ", 
   RowBox[{"G", "[", 
    RowBox[{"1", ",", "t1"}], "]"}], " ", 
   RowBox[{"G", "[", 
    RowBox[{"2", ",", "t1"}], "]"}], " ", 
   RowBox[{"G", "[", 
    RowBox[{"t0", ",", "t0"}], "]"}], " ", 
   RowBox[{"G", "[", 
    RowBox[{"t0", ",", "t1"}], "]"}]}], "+", 
  RowBox[{"2", " ", "\[ImaginaryI]", " ", 
   SuperscriptBox["\[Lambda]", "2"], " ", 
   RowBox[{"G", "[", 
    RowBox[{"1", ",", "t1"}], "]"}], " ", 
   RowBox[{"G", "[", 
    RowBox[{"2", ",", "t0"}], "]"}], " ", 
   SuperscriptBox[
    RowBox[{"G", "[", 
     RowBox[{"t0", ",", "t1"}], "]"}], "2"]}], "+", 
  RowBox[{"\[ImaginaryI]", " ", 
   SuperscriptBox["\[Lambda]", "2"], " ", 
   RowBox[{"G", "[", 
    RowBox[{"1", ",", "t1"}], "]"}], " ", 
   RowBox[{"G", "[", 
    RowBox[{"2", ",", "t0"}], "]"}], " ", 
   RowBox[{"G", "[", 
