   RowBox[{"Re", "[", 
    RowBox[{"transmission", "[", "w", "]"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"w", ",", "0", ",", " ", "4.0"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.407724026954197*^9, 3.407724027157322*^9}}],

