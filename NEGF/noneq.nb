Cell[TextData[{
 "Construct the inverse ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]]],
 " of central part Green function ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["G", "0"], TraditionalForm]]],
 " for linear system  (for simplicity, we omit the superscript 0, so Gr, Ga, \
Gl are for the linear system. Nonlinear, total green functions will be \
denoted Gnr, Gna, etc).  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"A", " ", "G"}], " ", "="}], TraditionalForm]]],
 " I.  ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]]],
 " ",
 Cell[BoxData[
  FormBox["=", TraditionalForm]]],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{"\[Omega]", "+", 
        RowBox[{"i", " ", "\[Eta]"}]}], ")"}], " "}], "2"], "-", 
    SubscriptBox["K", "c"], "-", 
    SubscriptBox["\[CapitalSigma]", "L"], "-", 
    SubscriptBox["\[CapitalSigma]", 
     RowBox[{"R", " "}]]}], TraditionalForm]]],
 ",    ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalSigma]", "L"], "=", " ", 
    RowBox[{
     SubscriptBox["V", 
      RowBox[{"C", " ", "L", " "}]], 
     SuperscriptBox[
      SubscriptBox["g", "L"], "r"], 
     SubscriptBox["V", 
      RowBox[{"L", " ", "C"}]]}]}], TraditionalForm]]],
 " is called self-energy.    Note that there is only one nonzero element in \
the corner of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["V", 
     RowBox[{"C", " ", "L"}]], "=", 
    SuperscriptBox[
     SubscriptBox["V", 
      RowBox[{"L", " ", "C"}]], "T"]}], TraditionalForm]]],
 "."
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"computeGr", "[", "w_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"A", ",", "i", ",", "j", ",", "Gr"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"A", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Which", "[", 
         RowBox[{
          RowBox[{"i", "\[Equal]", "j"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"w", "+", 
              RowBox[{"I", "*", "\[Eta]"}]}], ")"}], "^", "2"}], "-", 
           RowBox[{"2", "*", "kC"}]}], ",", "\[IndentingNewLine]", "\t\t", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"i", "-", "j"}], "]"}], "\[Equal]", "1"}], ",", " ", "kC",
           ",", "\[IndentingNewLine]", "\t\t", "True", ",", " ", "0"}], "]"}],
         ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "Nmax"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", "Nmax"}], "}"}]}], "]"}]}], ";", 
     RowBox[{
      RowBox[{"A", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "1"}], "]"}], "]"}], " ", "+=", " ", 
      RowBox[{"kC", " ", "-", "k1", "-", 
       RowBox[{
        RowBox[{"k1", "^", "2"}], "*", 
        RowBox[{"g", "[", 
         RowBox[{"w", ",", "k1", ",", "k1onsite"}], "]"}]}]}]}], ";", 
     RowBox[{
      RowBox[{"A", "[", 
       RowBox[{"[", 
        RowBox[{"Nmax", ",", "Nmax"}], "]"}], "]"}], " ", "+=", " ", 
      RowBox[{"kC", " ", "-", "k2", " ", "-", 
       RowBox[{
        RowBox[{"k2", "^", "2"}], " ", "*", 
        RowBox[{"g", "[", 
         RowBox[{"w", ",", "k2", ",", "k2onsite"}], "]"}]}]}]}], ";", 
     RowBox[{"Gr", " ", "=", " ", 
      RowBox[{"Inverse", "[", "A", "]"}]}], ";", "\[IndentingNewLine]", 
     "Gr"}]}], "\[IndentingNewLine]", "]"}]}]], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Re", "[", "#", "]"}], ",", 
        RowBox[{"Im", "[", "#", "]"}]}], "}"}], "&"}], "[", 
     RowBox[{
      RowBox[{"computeGr", "[", "w", "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"2", ",", "1"}], "]"}], "]"}], "]"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"w", ",", 
     RowBox[{"-", "0.4"}], ",", "0.4"}], "}"}], ",", " ", 
   RowBox[{"PlotStyle", "\[Rule]", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"RGBColor", "[", 
       RowBox[{"0", ",", "0", ",", "0"}], "]"}], ",", " ", 
      RowBox[{"RGBColor", "[", 
       RowBox[{"1", ",", "0", ",", "0"}], "]"}]}], "}"}]}]}], "]"}]], "Input",\

 CellChangeTimes->{{3.407723572391697*^9, 3.407723594469822*^9}}],

