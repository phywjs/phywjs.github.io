Cell[TextData[{
 "Draw Feynman diagrams from above results:  (1) draw ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " three-branch vertices if there is a ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Lambda]", "n"], TraditionalForm]]],
 ",  label the vertices as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", "0"], ",", " ", 
    SubscriptBox["t", "1"], ",", " ", "...", ",", " ", 
    SubscriptBox["t", 
     RowBox[{"n", "-", "1"}]]}], TraditionalForm]]],
 ", similiar draw ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]]],
 " four-branched vertices if there is a ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Mu]", "m"], TraditionalForm]]],
 ", label each with dummy ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["t", "k"], TraditionalForm]]],
 ", plus two extra terminals 1 and 2, connect with lines if there is a green \
function G[a,b].   G[a,b] is the green function without the cubic \
interaction, still nonequilibrum (contour ordered) green's functions.  The \
numerical factors are given in the above formula.  Finally, the dummy indices \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", "k"], "=", 
    RowBox[{"(", 
     RowBox[{"j", ",", "t"}], ")"}]}], TraditionalForm]]],
 " have to be summed (for lattice site indices) and integrated (for time on \
the contour).  The indices repeated exactly three times are for cubic \
interation \[Lambda], four times for quartic interaction \[Mu].   "
}], "Text",
 CellChangeTimes->{{3.40402045729678*^9, 3.4040204574842787`*^9}}]
}, Open  ]]
},
