Notebook[{

Cell[CellGroupData[{
Cell["\<\
Feynman diagrammatic expansion for contour ordered Green's functions with \
cubic & quartic nonlinear interactions, J-.S. Wang, 26 Oct 06\
\>", "Subtitle",
 CellChangeTimes->{{3.4040197742699013`*^9, 3.404019788066688*^9}, {
  3.4040198942847586`*^9, 3.4040198948316298`*^9}}],

Cell[TextData[{
 "The coupling T[i,j,k] will be denoted by \[Lambda].  The coupling \
T[i,j,k,l] will be \[Mu], maxorder is the highest order to compute in \
\[Lambda], similarly maxorderquartic for \[Mu]. Grn[ ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "...", ",", "c"}], "}"}], ",", "n", ",", " ",
     "m"}], TraditionalForm]]],
 "] is green's function with leg ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"a", ",", "b", ",", "...", ",", "c"}], "]"}], TraditionalForm]]],
 ".  ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 ", ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]]],
 " indicate number \[Lambda], \[Mu] generated so far in the final graph, used \
to generate dummy indices. ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "+", "m"}], TraditionalForm]]],
 " is recusion depth. At the highest (top) level, we take ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"n", "=", "0"}], ",", " ", 
    RowBox[{"m", "=", "0."}]}], TraditionalForm]]],
 " Two terminating conditions for the grand recursion are first set.  Grn[] \
implements the resursion rules and also symmetrize with respect to the \
arguments.   It works for any ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 "-point graphs. Reduction by canonization is defined below."
}], "Text",
 CellChangeTimes->{{3.4040199307689*^9, 3.404019932784512*^9}, {
  3.404020015377733*^9, 3.4040200156277313`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "maxorder", ",", "maxorderquartic", ",", " ", "Grn", ",", "G", ",", "ts", 
    ",", "permuterules", ",", " ", "canonize"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"maxorder", " ", "=", " ", "2"}], ";", " ", 
  RowBox[{"maxorderquartic", " ", "=", " ", "1"}]}]}], "Input"],

Cell[BoxData["1"], "Output",
 CellChangeTimes->{3.4040201934859686`*^9}]
}, Open  ]],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetAttributes", "[", 
   RowBox[{"G", ",", " ", "Orderless"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Grn", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", "n_", ",", " ", "m_"}], "]"}], ":=", 
   RowBox[{"-", "I"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Grn", "[", 
   RowBox[{"arg_List", ",", " ", "n_", ",", " ", "m_"}], "]"}], ":=", 
  RowBox[{"0", " ", "/;", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"n", " ", ">", " ", "maxorder"}], " ", "||", " ", 
     RowBox[{"m", " ", ">", " ", "maxorderquartic"}]}], ")"}]}]}]}], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Grn", "[", 
   RowBox[{"arg_List", ",", " ", "n_Integer", ",", " ", "m_Integer"}], "]"}], 
  ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "len", ",", "k", ",", "j", ",", "newarg", ",", " ", "argquartic", ",", 
      " ", "res", ",", "tdummy"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"len", " ", "=", " ", 
      RowBox[{"Length", "[", "arg", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tdummy", " ", "=", " ", 
      RowBox[{"ToExpression", "[", 
       RowBox[{"\"\<t\>\"", " ", "<>", " ", 
        RowBox[{"ToString", "[", 
         RowBox[{"n", "+", "m"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"res", " ", "=", " ", "0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"k", "=", "1"}], ",", " ", 
       RowBox[{"k", "\[LessEqual]", "len"}], ",", " ", 
       RowBox[{"++", "k"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"newarg", " ", "=", " ", 
         RowBox[{"Insert", "[", 
          RowBox[{
           RowBox[{"ReplacePart", "[", 
            RowBox[{"arg", ",", "tdummy", ",", "k"}], "]"}], ",", "tdummy", 
           ",", "k"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"res", " ", "+=", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "/", "len"}], ")"}], "*", "\[Lambda]", "*", 
          RowBox[{"G", "[", 
           RowBox[{
            RowBox[{"arg", "[", 
             RowBox[{"[", "k", "]"}], "]"}], ",", "tdummy"}], "]"}], "*", 
          RowBox[{"Grn", "[", 
           RowBox[{"newarg", ",", 
            RowBox[{"n", "+", "1"}], ",", "m"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"argquartic", " ", "=", " ", 
         RowBox[{"Insert", "[", 
          RowBox[{"newarg", ",", " ", "tdummy", ",", " ", "k"}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"res", " ", "+=", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "/", "len"}], ")"}], "*", "\[Mu]", "*", 
          RowBox[{"G", "[", 
           RowBox[{
            RowBox[{"arg", "[", 
             RowBox[{"[", "k", "]"}], "]"}], ",", "tdummy"}], "]"}], "*", 
          RowBox[{"Grn", "[", 
           RowBox[{"argquartic", ",", "n", ",", 
            RowBox[{"m", "+", "1"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"j", "=", "1"}], ",", " ", 
          RowBox[{"j", "\[LessEqual]", " ", "len"}], ",", 
          RowBox[{"++", "j"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"j", "\[NotEqual]", "k"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"res", " ", "+=", " ", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"1", "/", "len"}], ")"}], " ", "*", " ", "I", "*", 
                " ", 
                RowBox[{"G", "[", 
                 RowBox[{
                  RowBox[{"arg", "[", 
                   RowBox[{"[", "k", "]"}], "]"}], ",", 
                  RowBox[{"arg", "[", 
                   RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "*", 
                RowBox[{"Grn", "[", 
                 RowBox[{
                  RowBox[{"Delete", "[", 
                   RowBox[{"arg", ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", "k", "}"}], ",", 
                    RowBox[{"{", "j", "}"}]}], "}"}]}], "]"}], ",", "n", ",", 
                  "m"}], "]"}]}]}], ";"}]}], " ", "\[IndentingNewLine]", 
            "]"}], ";"}]}], " ", "\[IndentingNewLine]", "]"}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"res", " ", "//", " ", "Simplify"}], " ", "//", " ", 
      "Expand"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input"],

