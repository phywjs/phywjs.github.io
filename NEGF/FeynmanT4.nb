Cell[TextData[{
 "Canonize[] takes a term and puts into canonical form by permutating all \
dummy indices ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["t", "n"], TraditionalForm]]],
 " and choices a particular one."
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ts", " ", "=", " ", 
   RowBox[{"Table", "[", " ", 
    RowBox[{
     RowBox[{"ToExpression", "[", " ", 
      RowBox[{"\"\<t\>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", "k", "]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "0", ",", " ", 
       RowBox[{"maxorder", "+", "maxorderquartic", "-", "1"}]}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"permuterules", " ", "=", " ", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Thread", "[", 
        RowBox[{"ts", " ", "\[Rule]", " ", "#"}], "]"}], "&"}], ",", 
      RowBox[{"Permutations", "[", "ts", "]"}]}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"canonize", "[", "fyn_", "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "flist", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"flist", " ", "=", " ", 
      RowBox[{"Sort", "[", 
       RowBox[{"fyn", " ", "/.", " ", "permuterules"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Return", "[", 
      RowBox[{"flist", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"result", " ", "=", " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{"canonize", " ", "/@", " ", "g12"}], "//", " ", "Simplify"}], 
    " ", "//", " ", "Expand"}], ")"}]}]], "Input"],

