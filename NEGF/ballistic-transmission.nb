Cell[CellGroupData[{

Cell["Fisher - Lee relation", "Section",
 CellChangeTimes->{{3.4072108086012774`*^9, 3.4072108139293685`*^9}}],

Cell[TextData[{
 "They are given by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["G", 
     RowBox[{
      RowBox[{"N", "+", "1"}], ",", "0"}]], "=", 
    RowBox[{
     SubsuperscriptBox["g", 
      RowBox[{"R", ",", "00"}], "r"], 
     SuperscriptBox["V", "RC"], 
     SuperscriptBox["G", "r"], 
     SuperscriptBox["V", "CL"], 
     SubsuperscriptBox["g", 
      RowBox[{"L", ",", "00"}], "r"]}]}], TraditionalForm]]],
 " and  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["t", 
     RowBox[{
      RowBox[{"n", "'"}], "n"}], "RL"], "=", 
    RowBox[{"i", " ", "2", 
     SubscriptBox[
      RowBox[{"\[Omega]", " ", "[", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox["E", "R", "+"], ")"}], 
         RowBox[{"-", "1"}]], 
        SuperscriptBox[
         RowBox[{
          SubscriptBox["G", 
           RowBox[{
            RowBox[{"N", "+", "1"}], ",", "0"}]], "(", 
          SuperscriptBox[
           RowBox[{"(", 
            SubsuperscriptBox["E", "L", "-"], ")"}], "T"], ")"}], 
         RowBox[{"-", "1"}]]}], " ", "]"}], 
      RowBox[{
       RowBox[{"n", "'"}], "n"}]], 
     SubsuperscriptBox["v", "n", "L"]}]}], TraditionalForm]]],
 ".\n"
}], "Text",
 CellChangeTimes->{{3.4072108333354945`*^9, 3.407211030724856*^9}, {
  3.407211431909788*^9, 3.4072114753001356`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"fisherlee", "[", 
   RowBox[{"\[Omega]_", ",", "mode_Integer", ",", "modep_Integer"}], "]"}], ":=",
   
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "gR", ",", "gL", ",", "\[CapitalSigma]R", ",", "\[CapitalSigma]L", ",", 
      "m", ",", "\[CapitalOmega]2", ",", "Gr", ",", "ERinv", ",", "ELinv", 
      ",", " ", "epR", ",", "\[CapitalLambda]pR", ",", "emR", ",", 
      "\[CapitalLambda]mR", ",", "epL", ",", "\[CapitalLambda]pL", ",", "emL",
       ",", "\[CapitalLambda]mL", ",", "vL", ",", " ", "prod", ",", "Gnp1"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"compute", " ", 
      SuperscriptBox["g", "r"], " ", "and", " ", 
      SuperscriptBox["G", "r"], " ", "first", " ", "as", " ", "in", " ", 
      RowBox[{"caroli", "[", "]"}]}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gR", " ", "=", " ", 
      RowBox[{"surface2green", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"kR00", ",", "kR11", ",", "kR01"}], "}"}], ",", " ", 
        "\[Omega]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"gL", "=", 
      RowBox[{"leftlead", "[", 
       RowBox[{"surface2green", ",", " ", "\[Omega]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[CapitalSigma]R", " ", "=", " ", 
      RowBox[{
       RowBox[{"Transpose", "[", "VRC", "]"}], ".", "gR", ".", "VRC"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"\[CapitalSigma]L", "=", 
      RowBox[{
       RowBox[{"Transpose", "[", "VLC", "]"}], ".", "gL", ".", "VLC"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"m", "=", 
      RowBox[{"Length", "[", "KC", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[CapitalOmega]2", "=", 
      RowBox[{
       SuperscriptBox["\[Omega]", "2"], "*", 
       RowBox[{"IdentityMatrix", "[", "m", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Gr", "=", 
      RowBox[{"Inverse", "[", 
       RowBox[{
       "\[CapitalOmega]2", "-", "KC", "-", "\[CapitalSigma]R", "-", 
        "\[CapitalSigma]L"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Gnp1", "=", 
      RowBox[{"gR", ".", "VRC", ".", "Gr", ".", 
       RowBox[{"Transpose", "[", "VLC", "]"}], ".", "gL"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"pseudo", "-", 
       RowBox[{"inverse", " ", "of", " ", 
        SubsuperscriptBox["E", "R", "+"], " ", "and", " ", 
        SuperscriptBox[
         RowBox[{"(", 
          SubsuperscriptBox["E", "L", "-"], ")"}], "T"]}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "epR", ",", "\[CapitalLambda]pR", ",", "emR", ",", 
        "\[CapitalLambda]mR"}], "}"}], "=", " ", 
      RowBox[{"generalizedeigen", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"kR11", ",", "kR01"}], "}"}], ",", " ", "\[Omega]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ERinv", " ", "=", " ", 
      RowBox[{"PseudoInverse", "[", "epR", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "epL", ",", "\[CapitalLambda]pL", ",", "emL", ",", 
        "\[CapitalLambda]mL"}], "}"}], "=", " ", 
      RowBox[{"generalizedeigen", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"kL11", ",", "kL01"}], "}"}], ",", " ", "\[Omega]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ELinv", " ", "=", " ", 
      RowBox[{"PseudoInverse", "[", 
       RowBox[{"Transpose", "[", "emL", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"reduced", " ", "group", " ", "velocity", " ", 
       RowBox[{"(", 
        RowBox[{"v", "/", "a"}], ")"}], " ", "of", " ", "left", " ", "lead"}],
       " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"vL", "=", 
      RowBox[{"Chop", "[", 
       RowBox[{
        RowBox[{"velocity", "[", 
         RowBox[{"epL", ",", "\[CapitalLambda]pL", ",", "kL01"}], "]"}], "/", 
        
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "2.0"}], "*", 
          RowBox[{"Re", "[", "\[Omega]", "]"}], "*", "I"}], ")"}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"prod", " ", "=", " ", 
      RowBox[{"ERinv", " ", ".", " ", "Gnp1", ".", " ", "ELinv"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"for", " ", "reasons", " ", "I", " ", 
        RowBox[{"don", "'"}], "t", " ", "understand"}], ",", " ", 
       RowBox[{
        RowBox[{"we", " ", "should", " ", "multiply", " ", "by"}], " ", "-", 
        "1"}], ",", " ", 
       RowBox[{"not", " ", "I"}], ",", " ", 
       RowBox[{
       "here", " ", "in", " ", "front", " ", "of", " ", "2", "\[Omega]", 
        RowBox[{"??", "   ", 
         RowBox[{
         "May", " ", "be", " ", "related", " ", "to", " ", "the", " ", "fact",
           " ", "that", " ", "E", " ", "can", " ", "be", " ", "multiplied", 
          " ", "by", " ", "an", " ", "arbitrary", " ", 
          RowBox[{"phase", "."}]}]}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     
     RowBox[{"tRLnnfisher", " ", "=", " ", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"2.0", "*", "\[Omega]"}], ")"}]}], "*", 
       RowBox[{"prod", "[", 
        RowBox[{"[", 
         RowBox[{"modep", ",", " ", "mode"}], "]"}], "]"}], "*", 
       RowBox[{"vL", "[", 
        RowBox[{"[", 
         RowBox[{"mode", ",", "mode"}], "]"}], "]"}]}]}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.4072115112999053`*^9, 3.407211634767865*^9}, {
