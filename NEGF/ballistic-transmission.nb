Notebook[{

Cell[CellGroupData[{
Cell["Ballistic Transmission Coefficients, 21 dec 07", "Title",
 CellChangeTimes->{{3.4032290969985256`*^9, 3.4032291073891506`*^9}, {
   3.4032312040101967`*^9, 3.403231211572503*^9}, {3.40340437625648*^9, 
   3.4034043764752274`*^9}, {3.4034796998999696`*^9, 
   3.4034797003679996`*^9}, {3.4045266561461916`*^9, 
   3.4045266563336725`*^9}, {3.4064415016234374`*^9, 
   3.4064415052171183`*^9}, {3.406515234293014*^9, 3.4065152346209817`*^9}, {
   3.4065858013817153`*^9, 3.406585801397334*^9}, 3.406591778311988*^9, {
   3.407210769320279*^9, 3.4072107706015205`*^9}}],

Cell["\<\
Implementations for some of methods discussed in the review by J-S Wang, J \
Wang, and J-T Lu, ``Quantum thermal transport in nanostructure\".\
\>", "Text",
 CellChangeTimes->{{3.407212914898246*^9, 3.4072130432576203`*^9}}],

Cell[CellGroupData[{

Cell["Input", "Section",
 CellChangeTimes->{{3.4032460549590273`*^9, 3.4032460579433837`*^9}}],

Cell[TextData[{
 "The force parameters are in the following format:\n",
 Cell[BoxData[GridBox[{
    {
     SubsuperscriptBox["k", "11", "L"], 
     SubsuperscriptBox["k", "01", "L"], "0", "0", "0", "0", "0"},
    {
     SubsuperscriptBox["k", "10", "L"], 
     StyleBox[
      SubsuperscriptBox["k", "11", "L"],
      FontColor->RGBColor[1, 0, 0]], 
     StyleBox[
      SubsuperscriptBox["k", "01", "L"],
      FontColor->RGBColor[1, 0, 0]], "0", "0", "0", "0"},
    {"0", 
     SubsuperscriptBox["k", "10", "L"], 
     StyleBox[
      SubsuperscriptBox["k", "00", "L"],
      FontColor->RGBColor[1, 0, 0]], 
     StyleBox[
      SuperscriptBox["V", "LC"],
      FontColor->RGBColor[1, 0, 0]], "0", "0", "0"},
    {"0", "0", 
     SuperscriptBox["V", "CL"], 
     StyleBox[
      SuperscriptBox["K", "C"],
      FontColor->RGBColor[1, 0, 0]], 
     SuperscriptBox["V", "CR"], "0", "0"},
    {"0", "0", "0", 
     StyleBox[
      SuperscriptBox["V", "RC"],
      FontColor->RGBColor[1, 0, 0]], 
     StyleBox[
      SubsuperscriptBox["k", "00", "R"],
      FontColor->RGBColor[1, 0, 0]], 
     StyleBox[
      SubsuperscriptBox["k", "01", "R"],
      FontColor->RGBColor[1, 0, 0]], "0"},
    {"0", "0", "0", "0", 
     SubsuperscriptBox["k", "10", "R"], 
     StyleBox[
      SubsuperscriptBox["k", "11", "R"],
      FontColor->RGBColor[1, 0, 0]], 
     SubsuperscriptBox["k", "01", "R"]},
    {"0", "0", "0", "0", "0", 
     SubsuperscriptBox["k", "10", "R"], 
     SubsuperscriptBox["k", "11", "R"]}
   }]]],
 ",\nextending in the L and R directions indefinitely.  Only these \
submatrices highlighted in red need to be entered explicitly. "
}], "Text",
 CellChangeTimes->{{3.4032293024204006`*^9, 3.4032293027485256`*^9}, {
   3.4032293346547756`*^9, 3.4032293457954006`*^9}, {3.4032294082797756`*^9, 
   3.4032294774204006`*^9}, {3.4032295594360256`*^9, 
   3.4032300229012976`*^9}, {3.4032301856252575`*^9, 
   3.4032302250289855`*^9}, {3.403326338102317*^9, 3.4033263580263596`*^9}, {
   3.4034044140841208`*^9, 3.4034044294120493`*^9}, {3.406591794733968*^9, 
   3.4065917964527283`*^9}, 3.407212841241996*^9, 3.4072132320388703`*^9}],

Cell[BoxData[{
 RowBox[{
  RowBox[{"kL11", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"4.502", ",", " ", 
       RowBox[{"-", "1.591"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1.591"}], ",", " ", "2.252"}], "}"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kL00", "=", "kL11"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kL01", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0.0", ",", " ", "0.0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1.591"}], ",", " ", "0.0"}], "}"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"VLC", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0.0", ",", " ", "0.0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1.837"}], ",", " ", "0.0"}], "}"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"KC", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"6.0", ",", " ", 
       RowBox[{"-", "1.643"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1.643"}], ",", " ", "1.8"}], "}"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"VRC", "=", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"0.0", ",", 
      RowBox[{"-", "1.423"}]}], "}"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kR00", "=", 
   RowBox[{"{", 
    RowBox[{"{", "4.501", "}"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kR11", "=", "kR00"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kR01", "=", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"-", "2.250"}], "}"}], "}"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.4032302747446723`*^9, 3.40323029744678*^9}, {
   3.4032304395966616`*^9, 3.40323047345452*^9}, {3.4032307082114153`*^9, 
   3.4032307891931987`*^9}, {3.40323082947316*^9, 3.403230883221534*^9}, {
   3.4032309144863586`*^9, 3.4032309648913183`*^9}, {3.4032310092651825`*^9, 
   3.4032310720604496`*^9}, {3.4032311165593104`*^9, 3.403231131699548*^9}, {
   3.4032461122867856`*^9, 3.4032461451459503`*^9}, 3.4034787659707565`*^9, {
   3.4045309402797823`*^9, 3.4045309542024593`*^9}, {3.404531351737026*^9, 
   3.404531362611539*^9}}]
}, Open  ]],

Cell[CellGroupData[{

Cell["Eigenvalue problems", "Section",
 CellChangeTimes->{{3.403328395131979*^9, 3.4033284035228186`*^9}}],

Cell[TextData[{
 "Here we give the subroutines for the dispersion relation calculation (of \
the leads) and the generalized eigenvalue problem, where \[Lambda] = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["e", 
     RowBox[{"i2\[Pi]k", "/", "N"}]], "=", 
    SuperscriptBox["e", 
     RowBox[{"i", " ", "q", " ", 
      RowBox[{"a", "."}]}]]}], TraditionalForm]]],
 " eigen[ ] returns the frequencies and associated polarization vectors.  The \
generalizedeigen[ ] returns ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SuperscriptBox["\[CapitalEpsilon]", "+"], ",", " ", 
     RowBox[{
      SubscriptBox["\[CapitalLambda]", 
       RowBox[{"+", ","}]], 
      SuperscriptBox["\[CapitalEpsilon]", "-"]}], ",", 
     SubscriptBox["\[CapitalLambda]", "-"]}], "}"}], TraditionalForm]]],
 ". + means |\[Lambda]| < 1.\[ImplicitPlus]"
}], "Text",
 CellChangeTimes->{{3.403328416851285*^9, 3.4033284633212247`*^9}, {
  3.4033285103068027`*^9, 3.403328555917345*^9}, {3.403328843737213*^9, 
  3.403328877581829*^9}, {3.403331344429258*^9, 3.403331456772289*^9}, {
  3.4034044871456857`*^9, 3.4034044993642793`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"eigen", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"k11_", ",", "k01_"}], "}"}], ",", " ", "\[Lambda]_"}], "]"}], ":=",
   " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"d", ",", "\[CapitalOmega]2", ",", "\[CapitalEpsilon]"}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"d", " ", "=", " ", 
      RowBox[{"k11", " ", "+", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "/", "\[Lambda]"}], ")"}], "*", 
        RowBox[{"Transpose", "[", "k01", "]"}]}], " ", "+", " ", 
       RowBox[{"\[Lambda]", " ", "*", " ", "k01"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[CapitalOmega]2", ",", "\[CapitalEpsilon]"}], "}"}], "=", 
      RowBox[{"Eigensystem", "[", "d", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Sqrt", "[", "\[CapitalOmega]2", "]"}], ",", " ", 
       "\[CapitalEpsilon]"}], "}"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.403328469071372*^9, 3.4033285026503563`*^9}, {
  3.4033285583236566`*^9, 3.4033287728447733`*^9}, {3.4033288257836285`*^9, 
  3.403328836674532*^9}, {3.4033288853164024`*^9, 3.403328897332335*^9}, {
  3.403413904871394*^9, 3.4034139300749197`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"generalizedeigen", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"k11_", ",", "k01_"}], "}"}], ",", "\[Omega]_"}], "]"}], ":=", 
  RowBox[{"Module", "[", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "m", ",", "iden", ",", "A", ",", "B", ",", "t", ",", "b", ",", 
      "\[CapitalLambda]plist", ",", " ", "\[CapitalLambda]mlist", ",", " ", 
      "Ep", ",", " ", "Em", ",", "\[CapitalLambda]p", ",", 
      "\[CapitalLambda]m", ",", "\[Lambda]", ",", " ", "v", ",", "vec", ",", 
      "j"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"m", "=", 
      RowBox[{"Length", "[", "k11", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"iden", " ", "=", " ", 
      RowBox[{"IdentityMatrix", "[", "m", "]"}]}], ";", "\[IndentingNewLine]",
      
     RowBox[{"A", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"0.0", ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", "*", "m"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", "*", "m"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"t", " ", "=", " ", 
      RowBox[{"Range", "[", 
       RowBox[{"1", ",", "m"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"b", " ", "=", " ", 
      RowBox[{"Range", "[", 
       RowBox[{
        RowBox[{"m", "+", "1"}], ",", 
        RowBox[{"2", "m"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"A", "[", 
       RowBox[{"[", 
        RowBox[{"t", ",", "t"}], "]"}], "]"}], "=", 
      RowBox[{
       RowBox[{
        SuperscriptBox["\[Omega]", "2"], "*", "iden"}], " ", "-", "k11"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"A", "[", 
       RowBox[{"[", 
        RowBox[{"t", ",", "b"}], "]"}], "]"}], "=", " ", 
      RowBox[{"-", "iden"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"A", "[", 
       RowBox[{"[", 
        RowBox[{"b", ",", "t"}], "]"}], "]"}], "=", 
      RowBox[{"Transpose", "[", "k01", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"B", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"0.0", ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", "*", "m"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", "*", "m"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"B", "[", 
       RowBox[{"[", 
        RowBox[{"t", ",", "t"}], "]"}], "]"}], "=", "k01"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"B", "[", 
       RowBox[{"[", 
        RowBox[{"b", ",", "b"}], "]"}], "]"}], "=", " ", "iden"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Lambda]", ",", "vec"}], "}"}], "=", 
      RowBox[{"Eigensystem", "[", 
       RowBox[{"{", 
        RowBox[{"A", ",", "B"}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[CapitalLambda]plist", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[CapitalLambda]mlist", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Ep", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Em", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"j", "=", "1"}], ",", 
       RowBox[{"j", "\[LessEqual]", 
        RowBox[{"2", "m"}]}], ",", 
       RowBox[{"++", "j"}], ",", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"\[Lambda]", "[", 
            RowBox[{"[", "j", "]"}], "]"}], "]"}], " ", "<", " ", "1.0"}], 
         ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"AppendTo", "[", 
           RowBox[{"\[CapitalLambda]plist", ",", " ", 
            RowBox[{"\[Lambda]", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"v", " ", "=", " ", 
           RowBox[{"vec", "[", 
            RowBox[{"[", 
             RowBox[{"j", ",", "t"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"v", "=", 
           RowBox[{"v", "/", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"Conjugate", "[", "v", "]"}], ".", "v"}], "]"}]}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"Ep", ",", " ", "v"}], "]"}]}], ",", "\[IndentingNewLine]",
          
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"\[Lambda]", "[", 
               RowBox[{"[", "j", "]"}], "]"}], "]"}], " ", ">", " ", "1.0"}], 
            ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{"\[Lambda]", "[", 
                  RowBox[{"[", "j", "]"}], "]"}], "]"}], ">", 
                SuperscriptBox["10", "9"]}], ",", " ", 
               RowBox[{
                RowBox[{"\[Lambda]", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], "=", 
                SuperscriptBox["10", "9"]}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"\[CapitalLambda]mlist", ",", " ", 
               RowBox[{"\[Lambda]", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"v", " ", "=", " ", 
              RowBox[{"vec", "[", 
               RowBox[{"[", 
                RowBox[{"j", ",", "t"}], "]"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"v", "=", 
              RowBox[{"v", "/", 
               RowBox[{"Sqrt", "[", 
                RowBox[{
                 RowBox[{"Conjugate", "[", "v", "]"}], ".", "v"}], "]"}]}]}], 
             ";", "\[IndentingNewLine]", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"Em", ",", "v"}], "]"}]}]}], "\[IndentingNewLine]", 
           "]"}], ";"}]}], "\[IndentingNewLine]", "]"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Ep", " ", "=", " ", 
      RowBox[{"Transpose", "[", "Ep", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Em", " ", "=", " ", 
      RowBox[{"Transpose", "[", "Em", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[CapitalLambda]p", " ", "=", " ", 
      RowBox[{"DiagonalMatrix", "[", "\[CapitalLambda]plist", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[CapitalLambda]m", " ", "=", " ", 
      RowBox[{"DiagonalMatrix", "[", "\[CapitalLambda]mlist", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
      "Ep", ",", " ", "\[CapitalLambda]p", ",", " ", "Em", ",", " ", 
       "\[CapitalLambda]m"}], "}"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.4033288114707623`*^9, 3.4033288162365093`*^9}, {
   3.40332912272873*^9, 3.4033291459480743`*^9}, {3.4033293753758225`*^9, 
   3.4033294512371397`*^9}, {3.4033295674588647`*^9, 
   3.4033296826421156`*^9}, {3.4033297148515863`*^9, 
   3.4033297981400924`*^9}, {3.4033298286625495`*^9, 
   3.4033298310681067`*^9}, {3.4033299398336477`*^9, 
   3.4033299507836185`*^9}, {3.4033300436005993`*^9, 
   3.4033300688323903`*^9}, {3.4033310359945226`*^9, 
   3.4033311328057833`*^9}, {3.4033312424299107`*^9, 3.40333124488302*^9}, {
   3.4033312979295554`*^9, 3.403331317179432*^9}, {3.403405599483801*^9, 
   3.403405655110937*^9}, {3.4034057328326273`*^9, 3.4034059928967915`*^9}, {
   3.4034060536626635`*^9, 3.4034061146001635`*^9}, {3.4034061446782885`*^9, 
   3.4034062149282885`*^9}, {3.4034062671626635`*^9, 
   3.4034063510844126`*^9}, {3.4034064219277096`*^9, 3.403406455161872*^9}, {
   3.403406503864685*^9, 3.4034065056615486`*^9}, {3.4034066426919217`*^9, 
   3.40340664919188*^9}, {3.4034067269101324`*^9, 3.4034067690504875`*^9}, {
   3.4034068071127443`*^9, 3.4034068657998686`*^9}, {3.4034124559515915`*^9, 
   3.4034125172324495`*^9}, 3.40341287102706*^9, {3.4034129128549175`*^9, 
   3.4034130123699055`*^9}, {3.403413106431803*^9, 3.4034131310097713`*^9}, {
   3.4034131715563865`*^9, 3.403413200087454*^9}, {3.4034132599620705`*^9, 
   3.403413268165143*^9}, {3.4034133406646795`*^9, 3.4034133578051944`*^9}, {
   3.4034134025080338`*^9, 3.403413407258003*^9}, {3.403413586225608*^9, 
   3.4034135945536795`*^9}, {3.4034773932948227`*^9, 3.403477397951043*^9}, {
   3.4034784636608586`*^9, 3.4034784918140984`*^9}, {3.406520325582164*^9, 
   3.4065204107691183`*^9}, {3.4065205193621736`*^9, 3.40652052537776*^9}}]
}, Open  ]],

Cell[CellGroupData[{

Cell["Surface Green's function", "Section",
 CellChangeTimes->{{3.4032460980993767`*^9, 3.403246105536829*^9}}],

Cell["\<\
We have three different algorithms, (1) simple iteration, (2) accelerated \
iteration, (3) generalized eigenvalue problem.  The input \[Omega] should be \
complex with a small imaginary part, i.e., \[Omega] \[Rule] \[Omega] + i \
\[Eta].  Define \[Epsilon] to be the convergence factor for algorithms (1) \
and (2).\
\>", "Text",
 CellChangeTimes->{{3.40324622412982*^9, 3.4032462650983076`*^9}, {
  3.403326812900766*^9, 3.4033268574337263`*^9}, {3.40332692681139*^9, 
  3.403326928936472*^9}, {3.40332783832085*^9, 3.4033278663371925`*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Epsilon]", " ", "=", " ", "0.00001"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"surface1green", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"k00_", ",", " ", "k11_", ",", " ", "k01_"}], "}"}], ",", " ", 
     "\[Omega]_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"m", ",", "\[CapitalOmega]2", ",", "k10", ",", "g", ",", "gn"}],
       "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"m", "=", 
       RowBox[{"Length", "[", "k00", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"\[CapitalOmega]2", "=", 
       RowBox[{
        SuperscriptBox["\[Omega]", "2"], "*", 
        RowBox[{"IdentityMatrix", "[", "m", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"k10", "=", 
       RowBox[{"Transpose", "[", "k01", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"g", "=", 
       RowBox[{"Table", "[", 
        RowBox[{"0.0", ",", " ", 
         RowBox[{"{", "m", "}"}], ",", 
         RowBox[{"{", "m", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"gn", " ", "=", " ", 
       RowBox[{"Inverse", "[", 
        RowBox[{"\[CapitalOmega]2", " ", "-", "k11"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"While", "[", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Max", " ", "@@", " ", 
           RowBox[{"Abs", "[", 
            RowBox[{"gn", "-", "g"}], "]"}]}], ")"}], " ", ">", " ", 
         "\[Epsilon]"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"g", " ", "=", " ", "gn"}], ";", "\[IndentingNewLine]", 
         RowBox[{"gn", " ", "=", " ", 
          RowBox[{"Inverse", "[", 
           RowBox[{"\[CapitalOmega]2", " ", "-", " ", "k11", " ", "-", " ", 
            RowBox[{"k01", ".", "g", ".", "k10"}]}], "]"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Inverse", "[", 
       RowBox[{"\[CapitalOmega]2", " ", "-", " ", "k00", " ", "-", " ", 
        RowBox[{"k01", ".", "gn", ".", "k10"}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"surface2green", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"k00_", ",", "k11_", ",", "k01_"}], "}"}], ",", " ", 
     "\[Omega]_"}], "]"}], ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\[CapitalOmega]2", ",", "s", ",", "e", ",", "\[Alpha]", ",", "\[Beta]",
        ",", "g"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[CapitalOmega]2", "=", 
       RowBox[{
        SuperscriptBox["\[Omega]", "2"], "*", 
        RowBox[{"IdentityMatrix", "[", 
         RowBox[{"Length", "[", "k00", "]"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"s", "=", "k00"}], ";", "\[IndentingNewLine]", 
      RowBox[{"e", "=", "k11"}], ";", "\[IndentingNewLine]", 
      RowBox[{"\[Alpha]", "=", "k01"}], ";", "\[IndentingNewLine]", 
      RowBox[{"While", "[", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Max", " ", "@@", " ", 
           RowBox[{"Abs", "[", "\[Alpha]", "]"}]}], ")"}], " ", ">", " ", 
         "\[Epsilon]"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"g", "=", 
          RowBox[{"Inverse", "[", 
           RowBox[{"\[CapitalOmega]2", " ", "-", "e"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"\[Beta]", " ", "=", " ", 
          RowBox[{"Transpose", "[", "\[Alpha]", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"s", " ", "=", " ", 
          RowBox[{"s", " ", "+", " ", 
           RowBox[{"\[Alpha]", ".", "g", ".", "\[Beta]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"e", " ", "=", " ", 
          RowBox[{"e", " ", "+", " ", 
           RowBox[{"\[Alpha]", ".", "g", ".", "\[Beta]"}], " ", "+", " ", 
           RowBox[{"\[Beta]", ".", "g", ".", "\[Alpha]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"\[Alpha]", " ", "=", " ", 
          RowBox[{"\[Alpha]", ".", "g", ".", "\[Alpha]"}]}]}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Inverse", "[", 
       RowBox[{"\[CapitalOmega]2", "-", "s"}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"surface3green", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"k00_", ",", "k11_", ",", "k01_"}], "}"}], ",", " ", 
    "\[Omega]_"}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{
     "\[CapitalOmega]2", ",", "ep", ",", "\[CapitalLambda]p", ",", "em", ",", 
      "\[CapitalLambda]m", ",", "F"}], " ", "}"}], ",", "\[IndentingNewLine]",
     
    RowBox[{
     RowBox[{"\[CapitalOmega]2", "=", 
      RowBox[{
       SuperscriptBox["\[Omega]", "2"], "*", 
       RowBox[{"IdentityMatrix", "[", 
        RowBox[{"Length", "[", "k00", "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "ep", ",", "\[CapitalLambda]p", ",", "em", ",", "\[CapitalLambda]m"}], 
       "}"}], "=", " ", 
      RowBox[{"generalizedeigen", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"k11", ",", "k01"}], "}"}], ",", " ", "\[Omega]"}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"F", " ", "=", " ", 
      RowBox[{"ep", ".", "\[CapitalLambda]p", ".", 
       RowBox[{"PseudoInverse", "[", "ep", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Inverse", "[", 
      RowBox[{"\[CapitalOmega]2", " ", "-", " ", "k00", " ", "-", " ", 
       RowBox[{"k01", ".", "F"}]}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.4033278704154215`*^9, 3.4033278784625025`*^9}, {
   3.4034142739830484`*^9, 3.4034143113892984`*^9}, {3.4034145367955484`*^9, 
   3.4034145675142984`*^9}, {3.4034148744830484`*^9, 
   3.4034148941080484`*^9}, {3.4034149343424234`*^9, 
   3.4034149521861734`*^9}, {3.4034150311549234`*^9, 3.4034150316392984`*^9}, 
   3.4034175689830484`*^9, {3.403477722204457*^9, 3.4034777293425627`*^9}, {
   3.4034786708541126`*^9, 3.4034786758774414`*^9}, {3.403479922939191*^9, 
   3.4034799419622803`*^9}}],

Cell["\<\
The three functions defined above work only for the right lead; for the left \
lead, we transform the force constants so that it looks like a right lead, \
and call the right-lead routines.  The result is then transformed back.   The \
parameter of the function leftlead[ ] is the name of routine applied (without \
any argument).\
\>", "Text",
 CellChangeTimes->{{3.404526835705928*^9, 3.4045269544437675`*^9}, {
  3.4045270008296423`*^9, 3.4045270430440693`*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"leftlead", "[", 
    RowBox[{"sgf_Symbol", ",", " ", "\[Omega]_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"k00p", ",", "k11p", ",", "k01p", ",", "g"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"k00p", "=", 
       RowBox[{"flip", "[", "kL00", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"k11p", "=", 
       RowBox[{"flip", "[", "kL11", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"k01p", "=", 
       RowBox[{"Transpose", "[", 
        RowBox[{"flip", "[", "kL01", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"g", "=", 
       RowBox[{"sgf", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"k00p", ",", "k11p", ",", "k01p"}], "}"}], ",", " ", 
         "\[Omega]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"flip", "[", "g", "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"flip", "[", "m_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"n", ",", "mp", ",", "i", ",", "j"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "m", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"mp", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"0", ",", 
        RowBox[{"{", "n", "}"}], ",", 
        RowBox[{"{", "n", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "\[LessEqual]", "n"}], ",", 
       RowBox[{"++", "i"}], ",", "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"j", "=", "1"}], ",", 
         RowBox[{"j", "\[LessEqual]", "n"}], ",", 
         RowBox[{"++", "j"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"mp", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
          RowBox[{"m", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"n", "-", "i", "+", "1"}], ",", 
             RowBox[{"n", "-", "j", "+", "1"}]}], "]"}], "]"}]}]}], 
        "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}], ";", 
     "\[IndentingNewLine]", "mp"}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.40452704879348*^9, 3.404527087648876*^9}, {
  3.4045282803548555`*^9, 3.404528340583062*^9}, {3.40452838054772*^9, 
  3.4045285364067583`*^9}, {3.4045285793086147`*^9, 3.404528609211802*^9}, {
  3.404528674626978*^9, 3.4045286896098185`*^9}, {3.404528722293971*^9, 
  3.4045287561655025`*^9}, {3.4045288569833026`*^9, 3.4045289576761155`*^9}, {
  3.4045290102488565`*^9, 3.4045290616967125`*^9}, {3.4045293396682453`*^9, 
  3.4045293553385158`*^9}, {3.4045312788965397`*^9, 3.404531296114518*^9}}]
}, Open  ]],

Cell[CellGroupData[{

Cell["Caroli formula", "Section",
 CellChangeTimes->{{3.4045294818411856`*^9, 3.4045295151815214`*^9}}],

Cell[TextData[{
 "Compute the transmission according to the Caroli formula, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"T", "[", "\[Omega]", "]"}], "=", 
    RowBox[{
     RowBox[{"Tr", "(", 
      RowBox[{
       SuperscriptBox["G", "r"], 
       SubscriptBox["\[CapitalGamma]", "L"], 
       SuperscriptBox["G", "a"], 
       SubscriptBox["\[CapitalGamma]", "R"]}], ")"}], "."}]}], 
   TraditionalForm]]]
}], "Text",
 CellChangeTimes->{{3.404529535445071*^9, 3.404529619186495*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"caroli", "[", "\[Omega]_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "gR", ",", "gL", ",", "\[CapitalSigma]R", ",", "\[CapitalSigma]L", ",", 
      "m", ",", "\[CapitalOmega]2", ",", "Gr", ",", "\[CapitalGamma]R", ",", 
      "\[CapitalGamma]L", ",", "Tw"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gR", " ", "=", " ", 
      RowBox[{"surface2green", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"kR00", ",", "kR11", ",", "kR01"}], "}"}], ",", " ", 
        "\[Omega]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"gL", "=", 
      RowBox[{"leftlead", "[", 
       RowBox[{"surface2green", ",", " ", "\[Omega]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[CapitalSigma]R", " ", "=", " ", 
      RowBox[{
       RowBox[{"Transpose", "[", "VRC", "]"}], ".", "gR", ".", "VRC"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"\[CapitalSigma]L", "=", 
      RowBox[{
       RowBox[{"Transpose", "[", "VLC", "]"}], ".", "gL", ".", "VLC"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"m", "=", 
      RowBox[{"Length", "[", "KC", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[CapitalOmega]2", "=", 
      RowBox[{
       SuperscriptBox["\[Omega]", "2"], "*", 
       RowBox[{"IdentityMatrix", "[", "m", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Gr", "=", 
      RowBox[{"Inverse", "[", 
       RowBox[{
       "\[CapitalOmega]2", "-", "KC", "-", "\[CapitalSigma]R", "-", 
        "\[CapitalSigma]L"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[CapitalGamma]R", "=", 
      RowBox[{
       RowBox[{"-", "2.0"}], "*", 
       RowBox[{"Im", "[", "\[CapitalSigma]R", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[CapitalGamma]L", "=", 
      RowBox[{
       RowBox[{"-", "2.0"}], "*", 
       RowBox[{"Im", "[", "\[CapitalSigma]L", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Tw", "=", 
      RowBox[{"Tr", "[", 
       RowBox[{"Gr", ".", "\[CapitalGamma]L", ".", 
        RowBox[{"ConjugateTranspose", "[", "Gr", "]"}], ".", 
        "\[CapitalGamma]R"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Re", "[", "Tw", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.404529652589324*^9, 3.404529663947536*^9}, {
  3.404529695506804*^9, 3.404530004350175*^9}, {3.4045300380810957`*^9, 
  3.4045301837224307`*^9}, {3.404530219796861*^9, 3.404530299103291*^9}, {
  3.4045303815575438`*^9, 3.4045303998598537`*^9}, {3.40453047497754*^9, 
  3.40453050000634*^9}}],

