Cell[CellGroupData[{

Cell["Mode-matching", "Section",
 CellChangeTimes->{{3.4064398045383496`*^9, 3.4064398226464496`*^9}, {
  3.4064399643395987`*^9, 3.4064399677924805`*^9}}],

Cell[TextData[{
 "Here we solve the mode-matching linear equations:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"[", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           SubsuperscriptBox["k", "10", "L"]}], 
          RowBox[{
           SubsuperscriptBox["F", "L", "-"], "(", 
           RowBox[{"-", "1"}], ")"}]}], "+", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["\[Omega]", "2"], "-", 
           SubsuperscriptBox["k", "00", "L"]}], ")"}]}], "]"}], 
       SubscriptBox["u", "0"]}], "-", 
      RowBox[{
       SuperscriptBox["V", "LC"], 
       SuperscriptBox["u", "C"]}]}], "=", 
     RowBox[{
      RowBox[{
       SubsuperscriptBox["k", "10", "L"], 
       StyleBox["(",
        FontSize->18], 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["F", "L", "+"], "(", 
         RowBox[{"-", "1"}], ")"}], "-", 
        RowBox[{
         SubsuperscriptBox["F", "L", "-"], "(", 
         RowBox[{"-", "1"}], ")"}]}], 
       StyleBox[")",
        FontSize->18]}], " ", 
      SubsuperscriptBox["u", "0", "+"]}]}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["V", "CL"]}], 
       SubscriptBox["u", "0"]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["\[Omega]", "2"], "-", 
         SuperscriptBox["K", "C"]}], ")"}], 
       SuperscriptBox["u", "C"]}], "-", 
      RowBox[{
       SuperscriptBox["V", "CR"], 
       SubscriptBox["u", 
        RowBox[{"N", "+", "1"}]]}]}], "=", "0"}], ",", "\[IndentingNewLine]", 
    
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["V", "RC"]}], 
       SuperscriptBox["u", "C"]}], "+", 
      RowBox[{
       RowBox[{"[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["\[Omega]", "2"], "-", 
           SubsuperscriptBox["k", "00", "R"]}], ")"}], "-", 
         RowBox[{
          SubsuperscriptBox["k", "01", "R"], 
          RowBox[{
           SubsuperscriptBox["F", "R", "+"], "(", 
           RowBox[{"+", "1"}], ")"}]}]}], "]"}], " ", 
       SubscriptBox["u", 
        RowBox[{"N", "+", "1"}]]}]}], "=", "0."}]}], TraditionalForm]]],
 "\nForce constants are passed globally. ",
 StyleBox["mode",
  FontSlant->"Italic"],
 " pick a particular column in E = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["\[Epsilon]", "1"], ",", 
     SubscriptBox["\[Epsilon]", "2"]}]}], TraditionalForm]]],
 ", ...) matrix. Note that one must add i\[Eta] to the real frequency.  In \
order to have the diagonal pseudoinverse work, \[Eta] need sufficiently \
small.  The transmission amplitude ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["t", 
    RowBox[{
     RowBox[{"n", "'"}], "n"}], "RL"], TraditionalForm]]],
 " as a vector index by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "'"}], TraditionalForm]]],
 " is computed.  The function returns the partial transmission ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["T", 
      RowBox[{
       RowBox[{"n", "'"}], "n"}]], "[", "\[Omega]", "]"}], " ", "=", " ", 
    RowBox[{
     SubsuperscriptBox["v", 
      RowBox[{"n", "'"}], "R"], "|", 
     SubsuperscriptBox["t", 
      RowBox[{
       RowBox[{"n", "'"}], "n"}], "RL"], 
     SuperscriptBox["|", "2"], 
     RowBox[{"/", 
      RowBox[{
       SubsuperscriptBox["v", "n", "L"], "."}]}]}]}], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{{3.406439970339176*^9, 3.406440004274287*^9}, {
   3.4064403371333513`*^9, 3.406440389990697*^9}, {3.406440421474102*^9, 
   3.406440620219014*^9}, {3.406440681092456*^9, 3.4064408241833196`*^9}, 
   3.406441006257949*^9, {3.40644141450011*^9, 3.4064414765614185`*^9}, {
   3.406517821598155*^9, 3.4065178711039906`*^9}, {3.406518725082736*^9, 
   3.406518768014211*^9}, {3.4065208184166203`*^9, 3.40652093213571*^9}, {
   3.4065887960695558`*^9, 3.4065888165544553`*^9}, {3.406588875493464*^9, 
   3.4065889309937983`*^9}, {3.4065912505821066`*^9, 3.406591289597232*^9}, {
   3.4065916125774727`*^9, 3.4065916433114543`*^9}, 3.407213076398246*^9}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"modematch", "[", 
    RowBox[{"\[Omega]_Complex", ",", "mode_Integer"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "mL", ",", "mR", ",", "n", ",", "ntot", ",", "A", ",", "l", ",", "c", 
       ",", "r", ",", "epL", ",", "\[CapitalLambda]pL", ",", "emL", ",", 
       "\[CapitalLambda]mL", ",", "u0p", ",", "FpL", ",", "FmL", ",", "epR", 
       ",", "\[CapitalLambda]pR", ",", "emR", ",", "\[CapitalLambda]mR", ",", 
       "epRinv", ",", "F1R", ",", "b", ",", "uNp1", ",", 
       RowBox[{"(*", " ", "tRLnn", " ", "*)"}], ",", "vR", ",", "vL"}], "}"}],
      ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"mL", " ", "=", " ", 
       RowBox[{"Length", "[", "kL00", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"mR", "=", 
       RowBox[{"Length", "[", "kR00", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"n", " ", "=", " ", 
       RowBox[{"Length", "[", "KC", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ntot", " ", "=", " ", 
       RowBox[{"mL", " ", "+", " ", "n", " ", "+", " ", "mR"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"A", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{"0.0", ",", " ", 
         RowBox[{"{", "ntot", "}"}], ",", 
         RowBox[{"{", "ntot", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"l", " ", "=", " ", 
       RowBox[{"Range", "[", 
        RowBox[{"1", ",", "mL"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"c", "=", 
       RowBox[{"Range", "[", 
        RowBox[{
         RowBox[{"mL", "+", "1"}], ",", 
         RowBox[{"mL", "+", "n"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"r", "=", 
       RowBox[{"Range", "[", 
        RowBox[{
         RowBox[{"mL", "+", "n", "+", "1"}], ",", 
         RowBox[{"mL", "+", "n", "+", "mR"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"A", "[", 
        RowBox[{"[", 
         RowBox[{"l", ",", "l"}], "]"}], "]"}], "=", 
       RowBox[{
        RowBox[{
         SuperscriptBox["\[Omega]", "2"], "*", 
         RowBox[{"IdentityMatrix", "[", "mL", "]"}]}], "-", "kL00"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"A", "[", 
        RowBox[{"[", 
         RowBox[{"l", ",", "c"}], "]"}], "]"}], "=", 
       RowBox[{"-", "VLC"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"A", "[", 
        RowBox[{"[", 
         RowBox[{"c", ",", "l"}], "]"}], "]"}], "=", 
       RowBox[{"-", 
        RowBox[{"Transpose", "[", "VLC", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"A", "[", 
        RowBox[{"[", 
         RowBox[{"c", ",", "c"}], "]"}], "]"}], "=", 
       RowBox[{
        RowBox[{
         SuperscriptBox["\[Omega]", "2"], "*", 
         RowBox[{"IdentityMatrix", "[", "n", "]"}]}], "-", "KC"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"A", "[", 
        RowBox[{"[", 
         RowBox[{"c", ",", "r"}], "]"}], "]"}], "=", 
       RowBox[{"-", 
        RowBox[{"Transpose", "[", "VRC", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"A", "[", 
        RowBox[{"[", 
         RowBox[{"r", ",", "c"}], "]"}], "]"}], "=", 
       RowBox[{"-", "VRC"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"A", "[", 
        RowBox[{"[", 
         RowBox[{"r", ",", "r"}], "]"}], "]"}], "=", 
       RowBox[{
        RowBox[{
         SuperscriptBox["\[Omega]", "2"], "*", 
         RowBox[{"IdentityMatrix", "[", "mR", "]"}]}], "-", "kR00"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "epL", ",", "\[CapitalLambda]pL", ",", "emL", ",", 
         "\[CapitalLambda]mL"}], "}"}], "=", " ", 
       RowBox[{"generalizedeigen", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"kL11", ",", "kL01"}], "}"}], ",", " ", "\[Omega]"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "take", " ", "the", " ", "first", " ", "column", " ", "of", " ", 
         "ep1"}], ",", " ", 
        RowBox[{
        "note", " ", "the", " ", "difference", " ", "between", " ", "ell"}], 
        ",", " ", "l", ",", " ", 
        RowBox[{"and", " ", "one"}], ",", " ", "1"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"u0p", "=", 
       RowBox[{"epL", "[", 
        RowBox[{"[", 
         RowBox[{"l", ",", "mode"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"FpL", " ", "=", 
       RowBox[{"epL", ".", 
        RowBox[{"diagpsinv", "[", "\[CapitalLambda]pL", "]"}], ".", 
        RowBox[{"PseudoInverse", "[", "epL", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"FmL", "=", 
       RowBox[{"emL", ".", 
        RowBox[{"diagpsinv", "[", "\[CapitalLambda]mL", "]"}], ".", 
        RowBox[{"PseudoInverse", "[", "emL", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "epR", ",", "\[CapitalLambda]pR", ",", "emR", ",", 
         "\[CapitalLambda]mR"}], "}"}], "=", " ", 
       RowBox[{"generalizedeigen", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"kR11", ",", "kR01"}], "}"}], ",", " ", "\[Omega]"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"epRinv", " ", "=", " ", 
       RowBox[{"PseudoInverse", "[", "epR", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"F1R", "=", 
       RowBox[{"epR", ".", "\[CapitalLambda]pR", ".", "epRinv"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"A", "[", 
        RowBox[{"[", 
         RowBox[{"l", ",", "l"}], "]"}], "]"}], "+=", 
       RowBox[{"-", 
        RowBox[{
         RowBox[{"Transpose", "[", "kL01", "]"}], ".", "FmL"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"A", "[", 
        RowBox[{"[", 
         RowBox[{"r", ",", "r"}], "]"}], "]"}], "+=", " ", 
       RowBox[{"-", 
        RowBox[{"kR01", ".", "F1R"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"b", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{"0.0", ",", " ", 
         RowBox[{"{", "ntot", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"b", "[", 
        RowBox[{"[", "l", "]"}], "]"}], "=", 
       RowBox[{
        RowBox[{"Transpose", "[", "kL01", "]"}], ".", 
        RowBox[{"(", 
         RowBox[{"FpL", "-", "FmL"}], ")"}], ".", "u0p"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"uNp1", "=", 
       RowBox[{"LinearSolve", "[", 
        RowBox[{"A", ",", "b"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"tRLnn", "=", 
       RowBox[{"epRinv", ".", 
        RowBox[{"uNp1", "[", 
         RowBox[{"[", "r", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"compute", " ", "group", " ", "velocity", " ", "matrix"}], 
        ",", " ", 
        RowBox[{
        "in", " ", "units", " ", "of", " ", "lattice", " ", "spacings"}]}], 
       " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"vR", "=", 
       RowBox[{"Chop", "[", 
        RowBox[{
         RowBox[{"velocity", "[", 
          RowBox[{"epR", ",", "\[CapitalLambda]pR", ",", "kR01"}], "]"}], "/",
          
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "2.0"}], "*", 
           RowBox[{"Re", "[", "\[Omega]", "]"}], "*", "I"}], ")"}]}], "]"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"vL", "=", 
       RowBox[{"Chop", "[", 
        RowBox[{
         RowBox[{"velocity", "[", 
          RowBox[{"epL", ",", "\[CapitalLambda]pL", ",", "kL01"}], "]"}], "/",
          
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "2.0"}], "*", 
           RowBox[{"Re", "[", "\[Omega]", "]"}], "*", "I"}], ")"}]}], "]"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"vR", ".", 
        SuperscriptBox[
         RowBox[{"Abs", "[", "tRLnn", "]"}], "2"]}], "*", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"diagpsinv", "[", "vL", "]"}], ")"}], "[", 
        RowBox[{"[", 
         RowBox[{"mode", ",", "mode"}], "]"}], "]"}]}]}]}], 
    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Take", " ", "a", " ", "pseudoinverse", " ", "of", " ", "diagonal", " ", 
    "matrix"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"diagpsinv", "[", "mat_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"i", ",", "len", ",", "matinv"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"len", " ", "=", " ", 
       RowBox[{"Length", "[", "mat", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"matinv", "=", 
       RowBox[{"Table", "[", 
        RowBox[{"0.0", ",", " ", 
         RowBox[{"{", "len", "}"}], ",", 
         RowBox[{"{", "len", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", " ", 
        RowBox[{"i", "\[LessEqual]", "len"}], ",", 
        RowBox[{"++", "i"}], ",", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"mat", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "i"}], "]"}], "]"}], "]"}], ">", 
           SuperscriptBox["10", 
            RowBox[{"-", "5"}]]}], ",", " ", 
          RowBox[{
