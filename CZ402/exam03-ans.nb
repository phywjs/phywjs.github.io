Cell[CellGroupData[{
Cell["CZ3106, final exam 2003", "Title"],

Cell["1.", "Subtitle"],

Cell[CellGroupData[{

Cell[BoxData[
    \(x = 1; y = x; x = 2; y\)], "Input"],

