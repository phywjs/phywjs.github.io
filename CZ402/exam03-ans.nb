Cell[CellGroupData[{

Cell["2.", "Subtitle"],

Cell["(a)", "Subsubtitle"],

Cell[BoxData[{
    \(\(integ[f_ + g_, \ x_]\  := \ integ[f, x] + integ[g, x];\)\), "\n", 
    \(integ[c_*f_, x_]\  := \ c\ *\ integ[f, x]\  /; \ FreeQ[c, x]; 
    integ[x_^n_. , \ x_]\  := \ \((x^\((n + 1)\))\)/\((n + 1)\)\  /; \ 
        IntegerQ[n]\  && \ n\  \[GreaterEqual] 0;\), "\n", 
    \(\(integ[c_, x_]\  := \ c*x\  /; \ FreeQ[c, x];\)\), "\n", 
    \(\(integ[Exp[c_. *x_], x_]\  := \ \((1/c)\)\ *Exp[c*x];\)\), "\n", 
    \(integ[g_\ *\ Exp[c_. *x_], x_]\  := \ 
      g*Exp[c*x]/c\  - \ integ[D[g, x]*Exp[c*x], x]/c\)}], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
    \(integ[x^4*Exp[x], x]\)], "Input"],

Cell[BoxData[
    \(\[ExponentialE]\^x\ x\^4 - 
      4\ \((\[ExponentialE]\^x\ x\^3 - 
            3\ \((\[ExponentialE]\^x\ x\^2 - 
                  2\ \((\(-\[ExponentialE]\^x\) + \[ExponentialE]\^x\ \
x)\))\))\)\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(integ[1 + x + 3  x*Exp[2  x], x]\  // \ Simplify\)], "Input"],

Cell[BoxData[
    \(1\/4\ \((2\ x\ \((2 + x)\) + \[ExponentialE]\^\(2\ x\)\ \((\(-3\) + 
                6\ x)\))\)\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell["(b) ", "Subsubtitle"],

Cell["\<\
Clearly, we can integrate any polynomials with arbitrary \
coefficients:\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(integ[a0\  + \ a1*x\  + \ a6*x^6, x]\)], "Input"],

Cell[BoxData[
    \(a0\ x + \(a1\ x\^2\)\/2 + \(a6\ x\^7\)\/7\)], "Output"]
}, Open  ]],

Cell[TextData[{
  "Or sum of polynomial times an exponential   \[CapitalSigma] ",
  Cell[BoxData[
      \(TraditionalForm\`\(a\_n\) x\^n\ \(exp(\(c\_n\) x)\)\)]],
  ".  This is the general form of functions."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(integ[a0\  + \ a1*x\  + \ b2*x^2*Exp[3  x], x]\)], "Input"],

Cell[BoxData[
    \(a0\ x + \(a1\ x\^2\)\/2 + 
      b2\ \((1\/3\ \[ExponentialE]\^\(3\ x\)\ x\^2 - 
            2\/3\ \((\(-\(\[ExponentialE]\^\(3\ x\)\/9\)\) + 
                  1\/3\ \[ExponentialE]\^\(3\ x\)\ x)\))\)\)], "Output"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["(c)", "Subsubtitle"],

Cell["The set of integrable functions form an integral domain.", "Text"],

Cell[BoxData[""], "Input"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["3.", "Subtitle"],

Cell["(a)", "Subsubtitle"],

Cell[TextData[{
  "Addition Table \n           ",
  Cell[BoxData[
      \(TraditionalForm\`\(\(Z\_3\)\(+\)\)\)]],
  " |\t0\t1\t2\n           ---------------------\n           0\t      |\t0\t1\
\t2\n           1\t      |\t1\t2\t0   \n           2\t      |\t2\t0\t1\n\n\
Multiplication Table\n            ",
  Cell[BoxData[
      \(TraditionalForm\`\(\(Z\_3\)\(*\)\)\)]],
  " |\t0\t1\t2\n           ---------------------\n           0\t      |\t0\t0\
\t0\n           1\t      |\t0\t1\t2   \n           2\t      |\t0\t2\t1"
}], "Text"],

Cell[CellGroupData[{

Cell["(b)", "Subsubtitle"],

Cell["\<\
Additive inverse    of      0     is   0,
                                             1     is   2,
                                             2     is   1.\
\>", "Text"]
}, Open  ]],

Cell[CellGroupData[{

Cell["(c)", "Subsubtitle"],

Cell["\<\
Multiplicative inverse  of   0   is  none (no inverse)
                                                  1   is    1,
                                                  2   is    2.\
\>", "Text"]
}, Open  ]],

Cell[CellGroupData[{

Cell["(d)", "Subsubtitle"],

Cell[CellGroupData[{

Cell[BoxData[
    \(PolynomialGCD[1 + x + x^3, 1 - x, Modulus \[Rule] 3]\)], "Input"],

Cell[BoxData[
    \(2 + x\)], "Output"]
}, Open  ]],

Cell[TextData[Cell[BoxData[
    \(TraditionalForm\`\(\(\ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \)\(\(2\ x\^2\ \
\ \  + \ 2  x\ \ \ \  + \ 1\)\(\[IndentingNewLine]\)
    \(\ \)\(2  x + 
      1\ \ \@\(x\^3\ \  + \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ x\ \ \
\ \  + \ 1\)\)\(\[IndentingNewLine]\)
    \(\ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \)\(x\^3\ \ \ \  + \ \ 2 
         x\^2\)\(\[IndentingNewLine]\)
    \(\ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \)\(___  ___  ___  ___  ___  \
___\)\(\[IndentingNewLine]\)
    \(\ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \
\)\(x\^2\ \ \ \  + \ \ \ \ x\)\(\ \ \ \ \ \ \)\(\[IndentingNewLine]\)
    \(\ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \
\)\(x\^2\ \ \  + \ 2  x\)\(\[IndentingNewLine]\)
    \(\ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \
\)\(\(--\(--\(--\(--\(-\[IndentingNewLine]\ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \
\ \ \ \ \ 2\)\)\)\)\)\ x\ \ \ \  + \ 1\)\(\[IndentingNewLine]\)
    \(\ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \
\ \ \ \ \ \ \ \ \ \ \ \ \ \)\(2\ x\ \ \ \  + \ 1\)\(\[IndentingNewLine]\)
    \(\ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \
\ \ \ \ \ \ \ \ \)\(___  ___  ___\)\(\[IndentingNewLine]\)
    \(\ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \
\ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \)\(0\)\(\
\[IndentingNewLine]\)
    \(\ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \
\)\)\)\)]]], "Text"],

Cell[TextData[{
  "Since ",
  Cell[BoxData[
      \(TraditionalForm\`1 - x \[Congruent] 2  x + 1\)]],
  " divides ",
  Cell[BoxData[
      \(TraditionalForm\`1 + x + x\^3\)]],
  "  exactly, so ",
  Cell[BoxData[
      \(TraditionalForm\`GCD(1 + x + x\^3, 1 - x) = 2  x + 1. \)]]
}], "Text"]
}, Open  ]],

Cell[CellGroupData[{

Cell["(e)", "Subsubtitle"],

Cell[TextData[{
  "We could have used Extended Euclidean algorithm, but let us compute \
inverse first by finding ",
  Cell[BoxData[
      \(TraditionalForm\`a\ and\ b\)]],
  " such that:\n",
  Cell[BoxData[
      \(TraditionalForm\`\((a + b\ x)\)\ \((1 - x)\)\  \[Congruent] \ 
        1\ \ \ mod\ \((1 + x\^2)\)\)]],
  "   or\n",
  Cell[BoxData[
      \(TraditionalForm\`a\  - 
          b\ x\^2\  + \ \((b - a)\)\ x\  \[Congruent] \ \ a + 
          b\  + \ \((b - a)\)\ x\ \  \[Congruent] \ 1\)]],
  ",  so ",
  Cell[BoxData[
      \(TraditionalForm\`a + b\  \[Congruent] 1, \ \ b - a \[Congruent] 
        0\)]],
  ".   We note that ",
  Cell[BoxData[
      \(TraditionalForm\`x\^2 \[Congruent] \ \(-1\)\ mod\ \((1 + x\^2)\)\)]],
  ".  We have ",
  Cell[BoxData[
      \(TraditionalForm\`a = b\)]],
  ", and ",
  Cell[BoxData[
      \(TraditionalForm\`\(\(2  a = 1\)\(,\)\)\)]],
  "  or ",
  Cell[BoxData[
      \(TraditionalForm\`a = \(b = 2\^\(-1\) \[Congruent] 2. \)\)]],
  "    So ",
  Cell[BoxData[
      \(TraditionalForm\`\((1 - x)\)\^\(-1\)\  = \ 2  x + 2. \)]],
  "   Thus the final results for the product is:\n",
  Cell[BoxData[
      \(TraditionalForm\`\((1 + 
              x)\) \((1 - x)\)\^\(-1\) \[Congruent] \ \((1 + x)\) \((2  x + 
              2)\)\  \[Congruent] \ 2 - 2 + \((2 + 2)\) x\  \[Congruent] \ 
        x\)]],
  "."
}], "Text"]
}, Open  ]],

Cell[CellGroupData[{

Cell["(f)", "Subsubtitle"],

Cell[TextData[{
  "Condition for square -free is that ",
  Cell[BoxData[
      \(TraditionalForm\`GCD(a(x), \ a' \((x)\))\)]],
  " is a unit.   Compute: ",
  Cell[BoxData[
      \(TraditionalForm\`GCD \((1 + x + x\^2, \ 1 + 2  x)\)\)]],
  "\n\n",
  Cell[BoxData[
      \(TraditionalForm\`\(\(\ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \)\(2  
          x\ \  + 1\[IndentingNewLine]
      2  x + 1\ \ \@\(x\^2\ \  + \ \ \ \ x\ \ \  + \ 1\)\[IndentingNewLine]
      \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ x\^2\  + \ \ \ 2  
          x\[IndentingNewLine]
      \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \(--\(--\(--\(--\(-\
\[IndentingNewLine]\ \ \ \ \ 2\)\)\)\)\) x\  + \ 1\ \[IndentingNewLine]
      \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ 2  
          x\ \  + \ 1\[IndentingNewLine]
      \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \(--\(--\(\
--\[IndentingNewLine]\ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \
\ \ \ \ \ 0\)\)\)\)\)\)]]
}], "Text"],

Cell[TextData[{
  Cell[BoxData[
      \(TraditionalForm\`GCD \((1 + x + x\^2, \ 1 + 2  x)\)\  = \ 
        2  x + 1\)]],
  ".   Since this is not a unit, the polynomial ",
  Cell[BoxData[
      \(TraditionalForm\`1 + x + x\^2\)]],
  " is not square-free.  The above result also means that ",
  Cell[BoxData[
      \(TraditionalForm\`2  x + 1\)]],
  " is a factor of ",
  Cell[BoxData[
      \(TraditionalForm\`1 + x + x\^2\)]],
  ", since the quotient is also ",
  Cell[BoxData[
      \(TraditionalForm\`2  x + 1\)]],
  ",  we must have ",
  Cell[BoxData[
      \(TraditionalForm\`\((2  x + 1)\)\^2 = \ 1 + x + \(\(x\^2\)\(.\)\)\)]],
  "   Without going through the square-free factorization algorithm, we find \
the factorization is ",
  Cell[BoxData[
      \(TraditionalForm\`\((2  x + 1)\)\^2 \[Congruent] \ \((x + 2)\)\^2\)]],
  "."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(Factor[1 + x + x^2, \ Modulus \[Rule] 3]\)], "Input"],

Cell[BoxData[
    \(\((2 + x)\)\^2\)], "Output"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.", "Subtitle"],

Cell[CellGroupData[{

Cell[BoxData[
    \(Solve[{5  x + 2  y == 7, 2  x + y == 1}, {x, y}]\)], "Input"],

Cell[BoxData[
    \({{x \[Rule] 5, y \[Rule] \(-9\)}}\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(matd = {{5, 2}, {2, 1}}\)], "Input"],

Cell[BoxData[
    \({{5, 2}, {2, 1}}\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(Det[matd]\)], "Input"],

Cell[BoxData[
    \(1\)], "Output"]
}, Open  ]],

Cell[TextData[{
  "Given the above results, the answer can be checked:\n\nmod  p              \
  x                y               d              ",
  Cell[BoxData[
      \(TraditionalForm\`d\_x\)]],
  "                  ",
  Cell[BoxData[
      \(TraditionalForm\`d\_y\)]],
  "\n          2                1                1                1           \
   1                     1\n          3                2                0     \
           1              2                     0\n          5                \
0                1                1              0                     1\n    \
      7                5                5                1              5     \
                5\n         \[Infinity]               5              -9       \
        1               5                  -9       (that is, Z)"
}], "Text"]
}, Open  ]]
}, Open  ]]
},
