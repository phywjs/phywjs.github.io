Cell["Somewhat opposite to Evaluate[ ] is Hold[ ].", "Text"],

Cell[CellGroupData[{

Cell[BoxData[{
    \(\(x\  = \ 1;\)\), "\[IndentingNewLine]", 
    \(y\  = \ Hold[x]\  + \ 1\)}], "Input"],

Cell[BoxData[
    \(1 + Hold[x]\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(ReleaseHold[y]\)], "Input"],

Cell[BoxData[
    \(2\)], "Output"]
}, Open  ]],

Cell[TextData[{
  "Principle of ",
  StyleBox["Mathematica",
    FontSlant->"Italic"],
  " expression evaluation:  Apply transformation rules repeatedly until \
result no longer change."
}], "Text"],

Cell[BoxData[
    \(Clear[a, b]\)], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
    \(a + b\)], "Input"],

Cell[BoxData[
    \(a + b\)], "Output"]
}, Open  ]],

Cell[BoxData[
    \(Remove[a, b]\)], "Input"],

Cell["\<\
This show you what variables (symbols) have been defined so far.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(?Global`*\)\)], "Input"],

Cell["c    lexp m    rexp x", "Print"]
}, Open  ]],

