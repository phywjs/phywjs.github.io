Notebook[{
Cell[TextData[{
  "MATHEMATICA LISTS:\nStructured data objects\n",
  StyleBox["Wed, 22 Jan 2003",
    FontSize->24]
}], "Title"],

Cell["\<\

List groups a collection of 
expressions of any type.\
\>", "Subtitle"],

Cell[CellGroupData[{

Cell[BoxData[
    \(lexp\  = \ {a, b, c}\)], "Input"],

Cell[BoxData[
    \({a, b, c}\)], "Output"]
}, Open  ]],

Cell["\<\
We have just defined a Symbol lexp to be the List with elements a, b, c, \
which are themselves symbols.   We can then do operations on them.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(lexp^2\)], "Input"],

Cell[BoxData[
    \({a\^2, b\^2, c\^2}\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(Sin[{a, b, c}]\)], "Input"],

Cell[BoxData[
    \({Sin[a], Sin[b], Sin[c]}\)], "Output"]
}, Open  ]],

Cell["\<\
Many building functions having the above property are called listable.  By \
default, your own function will not be listable unless you change the \
attributes of your function.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(Attributes[Sin]\)], "Input"],

Cell[BoxData[
    \({Listable, NumericFunction, Protected}\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(?SetAttributes\)\)], "Input"],

Cell[BoxData[
    \("SetAttributes[s, attr] adds attr to the list of attributes of the \
symbol s."\)], "Print"]
}, Open  ]],

Cell["\<\
List can be used as vectors (we can add as long as they are of same size):\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \({a, b, c}\  + \ {1, 2, 3}\)], "Input"],

Cell[BoxData[
    \({1 + a, 2 + b, 3 + c}\)], "Output"]
}, Open  ]],

Cell[BoxData[
    \({x, y, z}\  = \ {1, 2, 3}\)], "Input"],

Cell["This assigned 1, 2, 3 to x, y, z, respectively.", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(Head[lexp]\)], "Input"],

Cell[BoxData[
    \(List\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(First[lexp]\)], "Input"],

Cell[BoxData[
    \(a\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(Last[lexp]\)], "Input"],

Cell[BoxData[
    \(c\)], "Output"]
}, Open  ]],

Cell["\<\
To refer to the i-th element in a list, we use the double square brackets.   \
(But this works only if the list has already created.)\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(lexp[\([2]\)]\)], "Input"],

Cell[BoxData[
    \(b\)], "Output"]
}, Open  ]],

Cell[TextData[{
  "In ",
  StyleBox["Mathematica",
    FontSlant->"Italic"],
  ", the elements in a list are refers from 1, 2, ...."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(Length[lexp]\)], "Input"],

Cell[BoxData[
    \(3\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(lexp[\([0]\)]\)], "Input"],

Cell[BoxData[
    \(List\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(Head[lexp]\  \[Equal] \ lexp[\([0]\)]\)], "Input"],

Cell[BoxData[
    \(True\)], "Output"]
}, Open  ]],

Cell["\<\
The head of a list or the zeroth element of a list is its data type List.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(lexp[\([\(-1\)]\)]\)], "Input"],

Cell[BoxData[
    \(c\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(rexp\  = \ {1, 2, 3}\)], "Input"],

Cell[BoxData[
    \({1, 2, 3}\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(Join[lexp, \ rexp]\)], "Input"],

Cell[BoxData[
    \({a, b, c, 1, 2, 3}\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(Append[lexp, \ 1]\)], "Input"],

Cell[BoxData[
    \({a, b, c, 1}\)], "Output"]
}, Open  ]],

Cell["\<\
Append[ ] or Prepend[ ] does not change the input expression lexp, but \
creates a new list with an element appended or prepended.   You can do \
assignment lexp=Append[lexp, a] that changes lexp.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(lexp\)], "Input"],

Cell[BoxData[
    \({a, b, c}\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(Prepend[lexp, \ 1]\)], "Input"],

Cell[BoxData[
    \({1, a, b, c}\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(List[a, b, c]\)], "Input"],

Cell[BoxData[
    \({a, b, c}\)], "Output"]
}, Open  ]],

Cell["\<\
The FullForm (i.e. internal form) of the list { ... } is List[ ...].  Thus \
List[a,b,c] and {a,b,c} are totally equivalent.  The member of the elements \
of a list can be anything:\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \({a, \ 2, \ 1/3, \ 1 + x^2, \ {a}, \ {{}}}\)], "Input"],

Cell[BoxData[
    \({a, 2, 1\/3, 1 + x\^2, {a}, {{}}}\)], "Output"]
}, Open  ]],

Cell["\<\
Lists are used to represent 
matrices as list of lists.\
\>", "Subtitle"],

Cell[CellGroupData[{

Cell[BoxData[
    \(m = {{1, 2}, {0.5, 3}}\)], "Input"],

Cell[BoxData[
    \({{1, 2}, {0.5`, 3}}\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(MatrixForm[m]\)], "Input"],

Cell[BoxData[
    TagBox[
      RowBox[{"(", GridBox[{
            {"1", "2"},
            {
              StyleBox["0.5`",
                StyleBoxAutoDelete->True,
                PrintPrecision->1], "3"}
            }], ")"}],
      (MatrixForm[ #]&)]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(Eigenvalues[m]\)], "Input"],

Cell[BoxData[
    \({3.41421356237309492`, 0.585786437626905076`}\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(Det[m]\)], "Input"],

Cell[BoxData[
    \(2.`\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(Transpose[m]\)], "Input"],

Cell[BoxData[
    RowBox[{"{", 
      RowBox[{
        RowBox[{"{", 
          RowBox[{"1", ",", 
            StyleBox["0.5`",
              StyleBoxAutoDelete->True,
              PrintPrecision->1]}], "}"}], ",", \({2, 3}\)}], "}"}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(\(Inverse[m]\)\(\ \)\)\)], "Input"],

Cell[BoxData[
    \({{1.5`, \(-1.`\)}, {\(-0.25`\), 0.5`}}\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(m\  . \ m\)], "Input"],

Cell[BoxData[
    \({{2.`, 8.`}, {2.`, 10.`}}\)], "Output"]
}, Open  ]],

Cell["This is how a matrix multiply a vector:", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(\(m\  . \ {a, \ b}\)\(\ \)\)\)], "Input"],

Cell[BoxData[
    \({1.`\ a + 2.`\ b, 0.5`\ a + 3.`\ b}\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(LinearSolve[m, {b1, b2}]\  // Simplify\)], "Input"],

Cell[BoxData[
    \({1.5`\ b1 - 1.`\ b2, \(-0.25`\)\ b1 + 0.5`\ b2}\)], "Output"]
}, Open  ]],

Cell["To access the elements of an array, use [[i,j]], as", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(m[\([1, 2]\)]\)], "Input"],

Cell[BoxData[
    \(2\)], "Output"]
}, Open  ]],

Cell["This gives you the first row.", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(m[\([1]\)]\)], "Input"],

Cell[BoxData[
    \({1, 2}\)], "Output"]
}, Open  ]],

Cell["How to get the first column of m?", "Text"],

Cell["Other List Manipulation Functions", "Subtitle"],

Cell[CellGroupData[{

Cell[BoxData[
    \(l\  = \ {a, b, c, d}\)], "Input"],

Cell[BoxData[
    \({a, b, c, d}\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \({RotateLeft[l], \ RotateRight[l]}\)], "Input"],

Cell[BoxData[
    \({{b, c, d, a}, {d, a, b, c}}\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(l\)], "Input"],

Cell[BoxData[
    \({a, b, c, d}\)], "Output"]
}, Open  ]],

Cell["Note that l itself is untouched by the functions.", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(Delete[l, 1]\)], "Input"],

Cell[BoxData[
    \({b, c, d}\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(Insert[l, i, 3]\)], "Input"],

Cell[BoxData[
    \({a, b, i, c, d}\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(MemberQ[l, i]\)], "Input"],

Cell[BoxData[
    \(False\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(Take[l, 2]\)], "Input"],

Cell[BoxData[
    \({a, b}\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(Drop[l, 2]\)], "Input"],

Cell[BoxData[
    \({c, d}\)], "Output"]
}, Open  ]],

Cell["List can be used to represent a tree.", "Subtitle"],

Cell["The list can be nested in arbitrary ways.", "Text"],

Cell[BoxData[
    \(l\  = \ {\ {a, \ b}, \ {{Sin[x], \ 1}, \ 2}}\)], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
    \(MatrixForm[l]\)], "Input"],

Cell[BoxData[
    TagBox[
      RowBox[{"(", "\[NoBreak]", GridBox[{
            {"a", "b"},
            {\({Sin[x], 1}\), "2"}
            }], "\[NoBreak]", ")"}],
      Function[ BoxForm`e$, 
        MatrixForm[ BoxForm`e$]]]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(TreeForm[l]\)], "Input"],

Cell[BoxData[
    InterpretationBox[
      RowBox[{"\<\"List\"\>", "[", 
        RowBox[{
          InterpretationBox[GridBox[{
                {"\<\"|\"\>"},
                {\("List"[a, b]\)}
                },
              GridBaseline->{Baseline, {1, 1}},
              ColumnAlignments->{Left}],
            ColumnForm[ {"|", 
              "List"[ a, b]}],
            Editable->False], ",", 
          InterpretationBox[GridBox[{
                {"\<\"|\"\>"},
                {
                  RowBox[{"\<\"List\"\>", "[", 
                    RowBox[{GridBox[{
                          {"\<\"|\"\>"},
                          {
                            RowBox[{"\<\"List\"\>", "[", 
                              RowBox[{GridBox[{
                                    {"\<\"|\"\>"},
                                    {\("Sin"[x]\)}
                                    },
                                  GridBaseline->{Baseline, {1, 1}},
                                  ColumnAlignments->{Left}], ",", "1"}], 
                              "]"}]}
                          },
                        GridBaseline->{Baseline, {1, 1}},
                        ColumnAlignments->{Left}], ",", "2"}], "]"}]}
                },
              GridBaseline->{Baseline, {1, 1}},
              ColumnAlignments->{Left}],
            ColumnForm[ {"|", 
              "List"[ 
                ColumnForm[ {"|", 
                  "List"[ 
                    ColumnForm[ {"|", 
                      "Sin"[ x]}], 1]}], 2]}],
            Editable->False]}], "]"}],
      TreeForm[ {{a, b}, {{
        Sin[ x], 1}, 2}}],
      Editable->False]], "Output"]
}, Open  ]],

Cell["List (or list of lists) v.s. associative array", "Subtitle"],

Cell["\<\
To use a list or array, the elements, size etc has to be defined first.  For \
example, the following use of two-dimensional array is not correct (assuming \
we have not referred to h before):\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(h[\([1, 2]\)]\  = \ 3\)], "Input"],

Cell[BoxData[
    \(Set::"noval" \(\(:\)\(\ \)\) 
      "Symbol \!\(h\) in part assignment does not have an immediate \
value."\)], "Message"]
}, Open  ]],

Cell["\<\
Since h as a list of list does not exist yet.  We should say:\
\>", "Text"],

Cell[BoxData[
    \(\((h\  = \ Table[0, \ {5}, {5}])\)\  // \ MatrixForm\)], "Input"],

Cell[BoxData[
    \(\(\(\ \)\(h[\([1, 2]\)]\  = \ 3; \ MatrixForm[h]\)\)\)], "Input"],

Cell["We can also create a list by the Table[ ] function:", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(l\  = \ Table[a[i], \ {i, 0, 4}]\)], "Input"],

Cell[BoxData[
    \({a[0], a[1], a[2], a[3], a[4]}\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(l\  = \ Range[4]\)], "Input"],

Cell[BoxData[
    \({1, 2, 3, 4}\)], "Output"]
}, Open  ]],

Cell["Associative Array", "Subtitle"],

Cell["\<\
For associative array, you need not specify the size of array first.  In \
fact, it is internally implemented as a hashtable.  We use single square \
brackets for associative array. \
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(a[0]\  = \ 2; \ a[\(-2\)]\  = \ \(-4\); \ a[1000]\  = \ w; \ 
    a[7, 7]\  = \ 7; \ a[star]\  = \ 5\)], "Input"],

Cell[BoxData[
    \(5\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(?a\)\)], "Input"],

Cell["Global`a", "Print",
  CellTags->"Info3251720958-4712639"],

Cell[BoxData[
    InterpretationBox[GridBox[{
          {GridBox[{
                {\(a[\(-2\)] = \(-4\)\)},
                {" "},
                {\(a[0] = 2\)},
                {" "},
                {\(a[1000] = w\)},
                {" "},
                {\(a[star] = 5\)},
                {" "},
                {\(a[7, 7] = 7\)}
                },
              GridBaseline->{Baseline, {1, 1}},
              ColumnWidths->0.999,
              ColumnAlignments->{Left}]}
          },
        GridBaseline->{Baseline, {1, 1}},
        ColumnAlignments->{Left}],
      Definition[ "a"],
      Editable->False]], "Print",
  CellTags->"Info3251720958-4712639"]
}, Open  ]],

Cell["", "Subtitle"],

Cell[TextData[{
  StyleBox["Mathematica",
    FontSlant->"Italic"],
  " Expressions"
}], "Subtitle"],

Cell[TextData[{
  StyleBox["Mathematica",
    FontSlant->"Italic"],
  " expressions are internally always the form"
}], "Text"],

Cell[BoxData[
    \(expr[expr1, \ expr2, \  ... ]\)], "Input"],

Cell["\<\
Where expr is called the Head, and expr1 is the first element of the \
expression, expr2 2nd element etc.   We obtain the expr by applying the Head[ \
...] function, we obtain expr1 by First[...] or by expr[[1]].   Everything \
that mathematica executes is an expression.
All the list manipulation functions also work for arbitrary expressions.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(Head[a + b]\)], "Input"],

Cell[BoxData[
    \(Plus\)], "Output"]
}, Open  ]],

Cell["Why?", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(First[a + b]\)], "Input"],

Cell[BoxData[
    \(a\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(FullForm[a + b]\)], "Input"],

Cell[BoxData[
    TagBox[
      StyleBox[\(Plus[a, b]\),
        ShowSpecialCharacters->False,
        ShowStringCharacters->True],
      FullForm]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(Plus[a, b]\)], "Input"],

Cell[BoxData[
    \(a + b\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(FullForm[a*b\  + \ c \((1 + x)\)^3]\)], "Input"],

Cell[BoxData[
    TagBox[
      StyleBox[\(Plus[Times[a, b], Times[c, Power[Plus[1, x], 3]]]\),
        ShowSpecialCharacters->False,
        ShowStringCharacters->True],
      FullForm]], "Output"]
}, Open  ]],

Cell["This data structure can be understood as a tree.", "Text"],

Cell["Assignment and Evaluation", "Subtitle"],

Cell[CellGroupData[{

Cell[BoxData[
    \(a = 1\)], "Input"],

Cell[BoxData[
    \(1\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(a + b\)], "Input"],

Cell[BoxData[
    \(1 + b\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(b\  = \ \((1 + x)\)^2\)], "Input"],

Cell[BoxData[
    \(\((1 + x)\)\^2\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(a + b\)], "Input"],

Cell[BoxData[
    \(1 + \((1 + x)\)\^2\)], "Output"]
}, Open  ]],

Cell["\<\
To force evaluation, we use Evaluate[ ] (without it the following will not \
work).\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(Plot[\ Evaluate[Table[x^i, {i, 1, 4}]], \ {x, 0, 1}]\)], "Input"],

