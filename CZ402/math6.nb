Cell["\<\
Now we define a user interface so that pure function in complex variable z = \
x + I y can be specified:\
\>", "Text"],

Cell[BoxData[
    \(CartesianMap[
        func_, \ {x0_, \ x1_, \ dx_}, \ {y0_, \ y1_, \ dy_}]\  := \ 
      Module[{x, y}, \[IndentingNewLine]Picture[
          func[x\  + \ I\ y], \ {x, \ x0, \ x1, \ dx}, \ {y, \ y0, \ y1, \ 
            dy}]\[IndentingNewLine]]\)], "Input"],

Cell["Now we can say:", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(CartesianMap[\ Sin, \ {0, \ 1, \ 0.2}, \ {0, \ 1, \ 0.2}]\)], "Input"],

