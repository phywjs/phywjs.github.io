Cell["\<\
Note that Graphics[ ] is in the form of Graphics[ { g1, g2, ...}] where g1, \
g2, ... are graphical elements such as Line[], or Point[], or Polygon[] etc.  \
 Adding vertical line is easy:\
\>", "Text"],

Cell[BoxData[
    \(drawlines[{x0_, \ x1_, \ dx_}, \ {y0_, \ y1_, \ dy_}]\  := \ 
      Module[\ {}, \[IndentingNewLine] (*\ 
          horizontal\ lines\ *) \[IndentingNewLine]hlines\  = \ 
          Line\  /@ Table[{x, y}, \ {y, y0, y1, dy}, {x, x0, \ x1, 
                dx}]; \[IndentingNewLine] (*\ 
          vertical\ lines\ *) \[IndentingNewLine]vlines\  = 
          Line\  /@ Table[{x, y}, \ {x, x0, \ x1, dx}, \[IndentingNewLine]{y, 
                y0, y1, dy}]; \[IndentingNewLine]\ 
        hlines\ ~Join~\ vlines\[IndentingNewLine]]\)], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
    \(Show[Graphics[drawlines[{0, 1, 0.2}, \ {0, \ 1, \ 0.2}]], \ 
      AspectRatio \[Rule] \ Automatic]\)], "Input"],

