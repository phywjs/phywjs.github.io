Cell["\<\
Using functional programming style to avoid the explicit loop, a better \
version might be.\
\>", "Text"],

Cell[BoxData[
    \(drawlines[{x0_, \ x1_, \ dx_}, \ {y0_, \ y1_, \ dy_}]\  := \ 
      Module[\ {}, \[IndentingNewLine]\ 
        manylines\  = \ 
          Table[{x, y}, \ {y, y0, y1, dy}, {x, x0, \ x1, 
              dx}]; \[IndentingNewLine]Line\  /@ \ 
          manylines\[IndentingNewLine]]\)], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
    \(Show[Graphics[drawlines[{0, 1, 0.3}, {0, 1, 0.2}]]]\)], "Input"],

