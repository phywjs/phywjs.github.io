Notebook[{
Cell["Lab 2", "Title"],

Cell["\<\
Questions 1 and 2 are 2 marks,
Questions 3 and 4  are 1 mark,
Question 5 is 4 marks.
Total 10 marks\
\>", "Subtitle"],

Cell["1.", "Subsubtitle"],

Cell[CellGroupData[{

Cell[BoxData[
    \(D[Sin[x], x]\)], "Input"],

Cell[BoxData[
    \(Cos[x]\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(D[x^x, \ x]\)], "Input"],

Cell[BoxData[
    \(x\^x\ \((1 + Log[x])\)\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(D[x^3 - 3  x*y^2, y]\)], "Input"],

Cell[BoxData[
    \(\(-6\)\ x\ y\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(D[ArcCos[x], \ {x, 2}]\)], "Input"],

Cell[BoxData[
    \(\(-\(x\/\((1 - x\^2)\)\^\(3/2\)\)\)\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(D[\ \((x + I*y)\)^3, \ {x, 2}]\  + \ 
      D[\((x + I*y)\)^3, \ {y, 2}]\)], "Input"],

Cell[BoxData[
    \(0\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(D[f[x^2], x]\)], "Input"],

Cell[BoxData[
    RowBox[{"2", " ", "x", " ", 
      RowBox[{
        SuperscriptBox["f", "\[Prime]",
          MultilineFunction->None], "[", \(x\^2\), "]"}]}]], "Output"]
}, Open  ]],

Cell["2.", "Subsubtitle"],

Cell[CellGroupData[{

Cell[BoxData[
    \(Integrate[x, x]\)], "Input"],

Cell[BoxData[
    \(x\^2\/2\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(Integrate[Sin[x], \ x]\)], "Input"],

Cell[BoxData[
    \(\(-Cos[x]\)\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(Integrate[\ \((1 + E^x)\)^\((\(-1\))\), \ x]\)], "Input"],

Cell[BoxData[
    \(x - Log[1 + \[ExponentialE]\^x]\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(Integrate[\ \((x \((2  x*
                  Exp[3  x^2]*\((x - \((1 + x + 2  x^2 + 2  x^3)\)*
                        Log[1 + x])\)\  + \ \((x^2*Exp[2  x^2]\  - \ 
                      Log[1 + x]^2)\)^2)\))\)/\((\((1 + 
                x)\) \((\(-x^2\)\ Exp[2  x^2]\  + \ Log[1 + x]^2)\)^2)\), \ 
      x]\)], "Input"],

Cell[BoxData[
    \(x - 
      Log[1 + x] - \(\[ExponentialE]\^\(x\^2\)\ x\ Log[1 + x]\)\/\(\(-\
\[ExponentialE]\^\(2\ x\^2\)\)\ x\^2 + Log[1 + x]\^2\) - 
      1\/2\ Log[\[ExponentialE]\^\(x\^2\)\ x - Log[1 + x]] + 
      1\/2\ Log[\[ExponentialE]\^\(x\^2\)\ x + Log[1 + x]]\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(Integrate[x/\((1 + E^x)\), \ x]\)], "Input"],

Cell[BoxData[
    \(x\^2\/2 - x\ Log[1 + \[ExponentialE]\^x] - 
      PolyLog[2, \(-\[ExponentialE]\^x\)]\)], "Output"]
}, Open  ]],

Cell["\<\
Polylog[ ] is a special, nonelementary functions.  Elementary \
functions are power, sine, cosine, expoential, and log, and any combinations.\
\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(Integrate[\ \((6  x^5 + 6  x^4 - 8  x^3 - 18  x^2 + 8  x + 
            8)\)/\((x^6 - 5  x^4 - 8  x^3 - 2  x^2 + 2  x + 1)\), \ 
      x]\)], "Input"],

Cell[BoxData[
    \(RootSum[
      1 + 2\ #1 - 2\ #1\^2 - 8\ #1\^3 - 
          5\ #1\^4 + #1\^6 &, \((4\ Log[x - #1] + 4\ Log[x - #1]\ #1 - 
              9\ Log[x - #1]\ #1\^2 - 4\ Log[x - #1]\ #1\^3 + 
              3\ Log[x - #1]\ #1\^4 + 3\ Log[x - #1]\ #1\^5)\)/\((1 - 2\ #1 - 
              12\ #1\^2 - 10\ #1\^3 + 3\ #1\^5)\) &]\)], "Output"]
}, Open  ]],

Cell[TextData[{
  "The RootSum here means the expresssion:\n",
  Cell[BoxData[
      \(TraditionalForm\`\(\[Sum]\^6\)\_\(i = 1\)\)]],
  " ",
  Cell[BoxData[
      \(\((4\ Log[x - r\_i] + 4\ Log[x - r\_i]\ r\_i - 
            9\ Log[x - r\_i]\ r\_i\^2 - 4\ Log[x - r\_i]\ r\_i\^3 + 
            3\ Log[x - r\_i]\ r\_i\^4 + 3\ Log[x - r\_i]\ r\_i\^5)\)/\((1 - 
            2\ r\_i - 12\ r\_i\^2 - 10\ r\_i\^3 + 3\ r\_i\^5)\)\)]],
  "\nwhere ",
  Cell[BoxData[
      \(TraditionalForm\`r\_i\)]],
  " is the ith root the the polynomial in the first argument of Rootum[ ]."
}], "Text"],

Cell["3.", "Subsubtitle"],

Cell[CellGroupData[{

Cell[BoxData[
    \(NSolve[x^5 + 5  x^4 + 4  x^3 + 3  x^2 + 2  x + 1\  \[Equal] \ 0, \ x, \ 
      30]\)], "Input"],

Cell[BoxData[
    \({{x \[Rule] \
\(-4.192725723692124708346692890416026634615519960821`29.4553\)}, {x \[Rule] \
\(-0.564099095704524861545949922499637317421429912239`29.2416\) - 
            0.390902637897471456143267015361277931709374342603`29.0823\ \
\[ImaginaryI]}, {x \[Rule] \
\(-0.564099095704524861545949922499637317421429912239`29.2416\) + 
            0.390902637897471456143267015361277931709374342603`29.0823\ \
\[ImaginaryI]}, {x \[Rule] 
          0.160461957550587215719296367707650634730138960461`28.9964 - 
            0.693271558867989981340821642199960829011093927079`29.632\ \
\[ImaginaryI]}, {x \[Rule] 
          0.160461957550587215719296367707650634730138960461`28.9964 + 
            0.693271558867989981340821642199960829011093927079`29.632\ \
\[ImaginaryI]}}\)], "Output"]
}, Open  ]],

Cell["4.", "Subsubtitle"],

Cell[CellGroupData[{

Cell[BoxData[
    \(res\  = \ 
      Solve[{y^2 + x^2 - y - 3  x \[Equal] 0, \ 
          y^2 - 6  x*y - x^2 + 11  y + 7  x - 12\  \[Equal] 0}, \ {x, 
          y}]\)], "Input"],

Cell[BoxData[
    \({{x \[Rule] 0, y \[Rule] 1}, {x \[Rule] 2, 
        y \[Rule] \(-1\)}, {x \[Rule] 2, y \[Rule] 2}, {x \[Rule] 3, 
        y \[Rule] 0}}\)], "Output"]
}, Open  ]],

Cell["To verify we do", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \({\ y^2 + x^2 - y - 3  x, \ 
        y^2 - 6  x*y - x^2 + 11  y + 7  x - 12}\  /. \ res\)], "Input"],

Cell[BoxData[
    \({{0, 0}, {0, 0}, {0, 0}, {0, 0}}\)], "Output"]
}, Open  ]],

Cell["5.", "Subsubtitle"],

Cell[BoxData[
    \(f[x_]\  := 1/\((x^2 + 1)\)\)], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
    \(Plot[f[x], {x, \(-2\), 2}]\)], "Input"],

