Notebook[{
Cell["Lab 4 Answers", "Title"],

Cell["\<\
Total marks are 10.   Question1, 3 marks; Question 2, 7 marks.

[correctness will be mostly counted.  It is OK to have very different \
programing styles.]\
\>", "Subsubtitle"],

Cell["1.", "Subtitle"],

Cell["\<\
The rules (a) to (f) (with the order of (e) and (f) swapped):\
\>", \
"Text"],

Cell[BoxData[{
    \(\(laplace[f_\  + \ g_, t_, s_]\  := \ 
        laplace[f, t, s]\  + \ laplace[g, t, s];\)\), "\[IndentingNewLine]", 
    \(\(laplace[c_*f_, t_, \ s_]\  := 
        c*laplace[f, t, s]\  /; \ FreeQ[c, t];\)\), "\[IndentingNewLine]", 
    \(\(laplace[c_, \ t_, \ s_] := \ 
        c/s\  /; \ FreeQ[c, t];\)\), "\[IndentingNewLine]", 
    \(\(laplace[t_^n_. , t_, s_]\  := \ \(n!\)/s^\((n + 1)\)\  /; \ 
          IntegerQ[n]\  && \ n\  > \ 0;\)\), "\[IndentingNewLine]", 
    \(\(laplace[g_*E^\((b_.  + c_. *t_)\), t_, s_] := \ 
        E^b\ *\ laplace[g, t, s - c]\  /; \ 
          FreeQ[b, t]\  && \ FreeQ[c, t];\)\), "\[IndentingNewLine]", 
    \(\(laplace[g_*t^n_. , t_, 
          s_]\  := \ \((\(-1\))\)^n\ *D[laplace[g, t, s], {s, n}]\  /; \ 
          IntegerQ[n]\  && \ n > 0;\)\)}], "Input"],

Cell["Some input examples:", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(laplace[t^2 + f[t], t, s]\)], "Input"],

Cell[BoxData[
    \(2\/s\^3 + laplace[f[t], t, s]\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(laplace[t^3*Exp[t + 3], t, s]\)], "Input"],

Cell[BoxData[
    \(\(6\ \[ExponentialE]\^3\)\/\((\(-1\) + s)\)\^4\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(laplace[t^2*Exp[c*t + b], t, s]\)], "Input"],

Cell[BoxData[
    \(\(2\ \[ExponentialE]\^b\)\/\((\(-c\) + s)\)\^3\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(laplace[t^2*Sin[t], t, s]\)], "Input"],

Cell[BoxData[
    \(\(2\ Sin[t]\)\/s\^3\)], "Output"]
}, Open  ]],

Cell["\<\
The program give wrong results if the function G[t] do not have an \
explicit laplace transform.  This is due to the D[ ..., {s,n}] part.  I don't \
know how to fix it.\
\>", "Text"],

Cell["2.", "Subtitle"],

Cell[BoxData[
    \(closedQ[set_List, \ table_List]\  := \ 
      Module[{f}, \[IndentingNewLine] (*\ A0, \ 
          test\ that\ operation\ is\ \(\(closed\)\(.\)\)\ \
*) \[IndentingNewLine]If[
          Length[Union[set]]\  \[NotEqual] \ 
            Length[set], \[IndentingNewLine]Print["\<elements not \
unique!\>"]; \[IndentingNewLine]Return[
            False]\[IndentingNewLine]]; \
\[IndentingNewLine]\[IndentingNewLine] (*\ 
          check\ that\ the\ table\ contains\ only\ elements\ in\ the\ set\ \
*) \[IndentingNewLine]f\  = \ Flatten[table, 1]; \[IndentingNewLine]If[
          Union[f]\  =!= \ 
            Union[set], \[IndentingNewLine]Print["\<operation is not \
closed!\>"]; \[IndentingNewLine]Return[
            False]]; \[IndentingNewLine]True\[IndentingNewLine]]\)], "Input"],

Cell[BoxData[
    \(associativeQ[set_List, \ table_List]\  := \ 
      Module[{n, f, i, j, k}, \[IndentingNewLine] (*\ A1, \ 
          check\ a*\((b*c)\)\  = \ \((a*
                  b)\)*\(\(c\)\(.\)\)\ \ *) \[IndentingNewLine] (*\ 
          Replace\ table\ by\ number\ from\ 1\ to\ n\ so\ that\ it\ is\ easy\ \
to\ locate\ entries\ in\ the\ table . \ \ Thus\ the\ elements\ are\ \
canonically\ renamed\ as\ 1\ to\ \(\(n\)\(.\)\)\ *) \[IndentingNewLine]n\  = \
\ Length[set]; \[IndentingNewLine]f\  = \ 
          table\  /. \ 
            Thread[set\  \[Rule] \ 
                Range[n]]; \[IndentingNewLine]\[IndentingNewLine]For[i = 1, \ 
          i \[LessEqual] n, \ \(++i\), \[IndentingNewLine]For[j = 1, 
            j \[LessEqual] n, \ \(++j\), \[IndentingNewLine]For[k = 1, \ 
              k \[LessEqual] n, \ \(++k\), \[IndentingNewLine]If[
                f[\([i, f[\([j, k]\)]]\)]\  \[NotEqual] \ 
                  f[\([f[\([i, j]\)], 
                      k]\)], \[IndentingNewLine]Print["\<associativity \
failed!\>"]; \[IndentingNewLine]Return[
                  False]]\[IndentingNewLine]]\[IndentingNewLine]]\
\[IndentingNewLine]]; \[IndentingNewLine]True\[IndentingNewLine]]\)], "Input"],

Cell[BoxData[
    \(identityQ[set_List, \ table_List]\  := \ 
      Module[{n, i, f, righte, lefte}, \[IndentingNewLine] (*\ 
          Check\ \(A2 : \ 
              identity\ e . \ \ Return\ either\ False\ or\ \(\({True, \ 
                    identity}\)\(.\)\)\)\ *) \[IndentingNewLine]n = \ 
          Length[set]; \[IndentingNewLine]{lefte, \ 
            righte}\  = \ {{}, \ {}}; \[IndentingNewLine]For[i\  = \ 1, \ 
          i\  \[LessEqual] n, \ \(++i\), \[IndentingNewLine]If[
            set\  === \ table[\([i]\)], \[IndentingNewLine]lefte\  = \ 
              set[\([i]\)]; \[IndentingNewLine]Break[]\[IndentingNewLine]]\
\[IndentingNewLine]]; \[IndentingNewLine]If[lefte\  \[Equal] \ {}, \ 
          Print["\<identity not find!\>"]; 
          Return[False]]; \[IndentingNewLine]f\  = \ 
          Transpose[table]; \[IndentingNewLine]For[i\  = \ 1, \ 
          i\  \[LessEqual] n, \ \(++i\), \[IndentingNewLine]If[
            set\  === \ f[\([i]\)], \[IndentingNewLine]righte\  = \ 
              set[\([i]\)]; \[IndentingNewLine]Break[]\[IndentingNewLine]]\
\[IndentingNewLine]]; \[IndentingNewLine]If[righte\  \[Equal] \ {}, \ 
          Print["\<identity not find!\>"]; 
          Return[False]]; \[IndentingNewLine]If[
          lefte\  \[Equal] \ 
            righte, \[IndentingNewLine]Print["\<identity is \>", \ 
            lefte], \ \[IndentingNewLine]Return[
            False]\[IndentingNewLine]]; \[IndentingNewLine]{True, \ 
          lefte}\[IndentingNewLine]]\)], "Input"],

Cell[BoxData[
    \(\(\(inverseQ[set_List, \ table_List, \ e_]\  := \ 
      Module[{i, n, \ f}, \[IndentingNewLine] (*\ 
          A3 . \ check\ that\ every\ one\ has\ inverse . \ \ We\ jsut\ make\ \
sure\ that\ each\ row\ and\ each\ column\ has\ a\ \(\(e\)\(.\)\)\ \
*) \[IndentingNewLine]n\  = \ Length[set]; \[IndentingNewLine]For[
          i\  = \ 1, \ 
          i\  \[LessEqual] \ 
            n, \ \(++i\), \[IndentingNewLine]If[\(! MemberQ[table[\([i]\)], \ 
                e]\), \[IndentingNewLine]Print["\<right inverse for \>", \ 
              set[\([i]\)], \ "\< not find!\>"]; \[IndentingNewLine]Return[
              False]]\[IndentingNewLine]]; \[IndentingNewLine]f\  = \ 
          Transpose[table]; \[IndentingNewLine]For[i\  = \ 1, \ 
          i\  \[LessEqual] \ 
            n, \ \(++i\), \[IndentingNewLine]If[\(! MemberQ[f[\([i]\)], \ 
                e]\), \[IndentingNewLine]Print["\<left inverse for \>", \ 
              set[\([i]\)], \ "\< not find!\>"]; \[IndentingNewLine]Return[
              False]]\[IndentingNewLine]]; \[IndentingNewLine]True\
\[IndentingNewLine]]\)\(\[IndentingNewLine]\)
    \)\)], "Input"],

Cell[BoxData[
    \(groupQ[set_List, \ table_List]\  := \ 
      Module[{}, \[IndentingNewLine]If[\(! closedQ[set, table]\), \ 
          Return[False]]; \[IndentingNewLine]If[\(! associativeQ[set, 
              table]\), \ Return[False]]; \[IndentingNewLine]res = \ 
          identityQ[set, table]; \[IndentingNewLine]If[res\  === \ False, 
          Return[False]]; \[IndentingNewLine]e\  = \ 
          res[\([2]\)]; \[IndentingNewLine]If[\(! inverseQ[set, table, 
              e]\), \ Return[
            False]]; \[IndentingNewLine]True\[IndentingNewLine]]\)], "Input"],

Cell["\<\
The following two modules are required for lab 5. (not part of \
requirement for lab 4).\
\>", "Text"],

Cell[BoxData[
    \(commuteQ[set_List, table_List] := \ 
      Module[{i, j, n}, \[IndentingNewLine] (*\ A4, \ 
          check\ a*b\  = \ b*a\ *) \[IndentingNewLine]n\  = \ 
          Length[set]; \[IndentingNewLine]For[i\  = \ 1, \ 
          i\  \[LessEqual] \ n, \ \(++i\), \[IndentingNewLine]For[
            j\  = \ 1, \ 
            j\  \[LessEqual] \ n, \ \(++j\), \[IndentingNewLine]If[
              table[\([i, j]\)]\  =!= \ table[\([j, i]\)], \ 
              Print["\<non-commuting!\>"]; \[IndentingNewLine]Return[
                False]]\[IndentingNewLine]]\[IndentingNewLine]]; \
\[IndentingNewLine]True\[IndentingNewLine]]\)], "Input"],

Cell[BoxData[
    \(abeliangroupQ[set_List, \ table_List] := 
      groupQ[set, table]\  && \ commuteQ[set, \ table]\)], "Input"],

Cell["Some tests.", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(z4a\  = \ Table[Mod[i + j, 4], {i, 0, 3}, {j, 0, 3}]\)], "Input"],

Cell[BoxData[
    \({{0, 1, 2, 3}, {1, 2, 3, 0}, {2, 3, 0, 1}, {3, 0, 1, 2}}\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(groupQ[{0, 1, 2, 3}, z4a]\)], "Input"],

Cell[BoxData[
    InterpretationBox[\("identity is "\[InvisibleSpace]0\),
      SequenceForm[ "identity is ", 0],
      Editable->False]], "Print"],

Cell[BoxData[
    \(True\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(groupQ[{a, b, c}, {{b, c, a}, {c, b, a}, {b, a, c}}]\)], "Input"],

Cell[BoxData[
    \("associativity failed!"\)], "Print"],

Cell[BoxData[
    \(False\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(z5m\  = \ Table[Mod[i*j, 5], {i, 1, 4}, {j, 1, 4}]\)], "Input"],

Cell[BoxData[
    \({{1, 2, 3, 4}, {2, 4, 1, 3}, {3, 1, 4, 2}, {4, 3, 2, 1}}\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(groupQ[{1, 2, 3, 4}, z5m]\)], "Input"],

Cell[BoxData[
    InterpretationBox[\("identity is "\[InvisibleSpace]1\),
      SequenceForm[ "identity is ", 1],
      Editable->False]], "Print"],

Cell[BoxData[
    \(True\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(abeliangroupQ[{1, 2, 3, 4}, z5m]\)], "Input"],

Cell[BoxData[
    InterpretationBox[\("identity is "\[InvisibleSpace]1\),
      SequenceForm[ "identity is ", 1],
      Editable->False]], "Print"],

Cell[BoxData[
    \(True\)], "Output"]
}, Open  ]],

Cell[BoxData[
    \(\(mat\  = \ {{i, a, b, c, d, k}, {a, i, c, b, k, d}, {b, k, d, a, i, 
            c}, {c, d, k, i, a, b}, {d, c, i, k, b, a}, {k, b, a, d, c, 
            i}};\)\)], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
    \(MatrixForm[mat]\)], "Input"],

Cell[BoxData[
    TagBox[
      RowBox[{"(", "\[NoBreak]", GridBox[{
            {"i", "a", "b", "c", "d", "k"},
            {"a", "i", "c", "b", "k", "d"},
            {"b", "k", "d", "a", "i", "c"},
            {"c", "d", "k", "i", "a", "b"},
            {"d", "c", "i", "k", "b", "a"},
            {"k", "b", "a", "d", "c", "i"}
            }], "\[NoBreak]", ")"}],
      Function[ BoxForm`e$, 
        MatrixForm[ BoxForm`e$]]]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(groupQ[{i, a, b, c, d, k}, mat]\)], "Input"],

Cell[BoxData[
    InterpretationBox[\("identity is "\[InvisibleSpace]i\),
      SequenceForm[ "identity is ", i],
      Editable->False]], "Print"],

Cell[BoxData[
    \(True\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(abeliangroupQ[{i, a, b, c, d, k}, mat]\)], "Input"],

Cell[BoxData[
    InterpretationBox[\("identity is "\[InvisibleSpace]i\),
      SequenceForm[ "identity is ", i],
      Editable->False]], "Print"],

Cell[BoxData[
    \("non-commuting!"\)], "Print"],

Cell[BoxData[
    \(False\)], "Output"]
}, Open  ]]
},
